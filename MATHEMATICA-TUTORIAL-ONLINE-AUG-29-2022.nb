 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"12983eb4-c76e-4342-a20c-758910b31323"],

Cell["\<\
The recursion moves downward towards the base case:
4 -> 3 -> 2 -> 1
Once the base case is reached, Mathematica evaluates the result while \
returning back.\
\>", "Text",ExpressionUUID->"8c4792af-6d7b-46b9-ae98-6289bd656a3e"]
}, Closed]],

Cell[CellGroupData[{

Cell["Example 2 : Fibonacci Numbers", "Subsubsection",ExpressionUUID->"c93a29ee-4a17-45ba-a554-7ef67ee452e8"],

Cell["\<\
The Fibonacci sequence is defined as:
0, 1, 1, 2, 3, 5, 8, ...
Each term is the sum of the previous two terms.
Recursive definition:
fib[n] = fib[n-1] + fib[n-2]
Base Case:
fib[0] = 0
fib[1] = 1\
\>", "Text",
 CellChangeTimes->{{3.996561001783744*^9, 
  3.996561004163207*^9}},ExpressionUUID->"6eab0b64-9aa8-41e9-8306-\
ddc615af2f71"],

Cell["Function definition:", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"78acb722-6c58-4456-93b8-03fb9576a719"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", "fib", "]"}], "\n", 
 RowBox[{
  RowBox[{"fib", "[", "0", "]"}], " ", "=", " ", "0"}], "\n", 
 RowBox[{
  RowBox[{"fib", "[", "1", "]"}], " ", "=", " ", "1"}], "\n", 
 RowBox[{
  RowBox[{"fib", "[", "n_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"fib", "[", 
    RowBox[{"n", "-", "1"}], "]"}], " ", "+", " ", 
   RowBox[{"fib", "[", 
    RowBox[{"n", "-", "2"}], "]"}]}]}]}], "Input",ExpressionUUID->"b3821136-\
7394-4b30-8fa0-3e037690b0d4"],

