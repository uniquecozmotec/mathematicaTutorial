Cell[CellGroupData[{

Cell["Expressions", "Section",ExpressionUUID->"f51947a1-18d3-4942-b350-20d0a04a5147"],

Cell["\<\
Every object in the Wolfram Language is an expression. Numbers, strings, \
lists, equations and even entire programs are stored in one uniform \
structure. Learning to see that structure is the first real step towards \
understanding the language, because patterns, rules and functional \
programming are all defined in terms of it.
An expression has the general form : \thead[element1, element2, ...]
where the head says what kind of thing the expression is, and the elements \
are its parts. Familiar notation such as a + b or {1, 2, 3} is only a \
convenient way of writing this same structure\
\>", "Text",
 CellChangeTimes->{{3.996554009400498*^9, 3.9965540283507977`*^9}, {
  3.99655549424571*^9, 
  3.996555495947114*^9}},ExpressionUUID->"69882e48-cf50-4586-b1f2-\
d1c6240e2836"],

Cell[CellGroupData[{

Cell["The Universal Form", "Subsubsection",ExpressionUUID->"423ce8e9-1189-4de0-b3d1-4af3bca072a0"],

Cell["\<\
Whatever you type, the Wolfram Language stores it as head[element1, element2, \
...]. The notation you see on screen is only a display convention. 
FullForm strips that convention away and shows what is really there.\
\>", "Text",
 CellChangeTimes->{
  3.996555510183022*^9},ExpressionUUID->"ed44ed33-dfb7-47ea-a5a0-\
7a9757172ea9"],

Cell[CellGroupData[{

Cell["FullForm[a + b]", "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"1f36a188-2334-46dc-8bb4-3f0d11efde02"],

Cell[BoxData[
 TagBox[
  StyleBox[
   RowBox[{"Plus", "[", 
    RowBox[{"a", ",", "b"}], "]"}],
   ShowSpecialCharacters->False,
   ShowStringCharacters->True,
   NumberMarks->True],
  FullForm]], "Output",
 CellChangeTimes->{3.996555513967511*^9},
 CellLabel->
  "Out[3]//FullForm=",ExpressionUUID->"d0350e3b-3562-4f22-a97a-a4251cb4edd4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["FullForm[{1, 2, 3}]", "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"f8090006-3008-43e3-86fb-8500744b3688"],

Cell[BoxData[
 TagBox[
  StyleBox[
   RowBox[{"List", "[", 
    RowBox[{"1", ",", "2", ",", "3"}], "]"}],
   ShowSpecialCharacters->False,
   ShowStringCharacters->True,
   NumberMarks->True],
  FullForm]], "Output",
 CellChangeTimes->{3.9965555176977673`*^9},
 CellLabel->
  "Out[4]//FullForm=",ExpressionUUID->"585fc83d-26a5-4256-8290-3ac36988a5d8"]
}, Open  ]],

Cell["\<\
Some expressions look very different from their internal form. Subtraction \
and division do not exist as separate operations at all.\
\>", "Text",
 CellChangeTimes->{{3.99655552688387*^9, 
  3.996555533720316*^9}},ExpressionUUID->"237e1acc-ceb4-45bc-9e1a-\
60a2724549b0"],

Cell[CellGroupData[{

Cell["FullForm[a - b]", "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"e5bb3b3b-f402-4f03-953a-49f8e62adafd"],

Cell[BoxData[
 TagBox[
  StyleBox[
   RowBox[{"Plus", "[", 
    RowBox[{"a", ",", 
     RowBox[{"Times", "[", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "b"}], "]"}]}], "]"}],
   ShowSpecialCharacters->False,
   ShowStringCharacters->True,
   NumberMarks->True],
  FullForm]], "Output",
 CellChangeTimes->{3.996555543750369*^9},
 CellLabel->
  "Out[5]//FullForm=",ExpressionUUID->"fa9f4e44-e073-4ee1-9f2d-6dd03ac24961"]
}, Open  ]],

Cell[CellGroupData[{

Cell["FullForm[a/b]", "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"132fdf62-de94-4d00-9fb8-5197ce248a16"],

Cell[BoxData[
 TagBox[
  StyleBox[
   RowBox[{"Times", "[", 
    RowBox[{"a", ",", 
     RowBox[{"Power", "[", 
      RowBox[{"b", ",", 
       RowBox[{"-", "1"}]}], "]"}]}], "]"}],
   ShowSpecialCharacters->False,
   ShowStringCharacters->True,
   NumberMarks->True],
  FullForm]], "Output",
 CellChangeTimes->{3.996555546066203*^9},
 CellLabel->
  "Out[6]//FullForm=",ExpressionUUID->"3276d623-ab0c-4b84-8cb5-47af08588c38"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Heads and Atoms", "Subsubsection",ExpressionUUID->"311952c9-6e7f-4faa-89b4-2c426dc9dd28"],

Cell["\<\
The head of an expression identifies what kind of object it is. For a \
compound expression it is the function being applied; for a simple object it \
is the type of that object.\
\>", "Text",ExpressionUUID->"ea8b91f9-e561-4957-8975-074f5507923a"],

Cell[CellGroupData[{

Cell["{Head[a + b], Head[{1, 2, 3}]}", "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"50702204-79b6-41c7-8618-3fd0e9348a33"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"Plus", ",", "List"}], "}"}]], "Output",
 CellChangeTimes->{3.996555588167479*^9},
 CellLabel->"Out[7]=",ExpressionUUID->"6271908c-1120-4790-8dc5-ffe52f6563b0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["{Head[42], Head[3.14], Head[\"text\"], Head[x]}", "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"a62278c5-46ab-4780-8420-e22f8f068303"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"Integer", ",", "Real", ",", "String", ",", "Symbol"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.996555591017115*^9},
 CellLabel->"Out[8]=",ExpressionUUID->"88b71c62-156e-4353-8956-193118f7ad9c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Head[1/2]", "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"a4d7c1fe-3b51-4c32-b6df-9a805a03ef1e"],

Cell[BoxData["Rational"], "Output",
 CellChangeTimes->{3.996555615596962*^9},
 CellLabel->"Out[10]=",ExpressionUUID->"ff1d2fa4-edc2-4af2-9ad4-d1fc79226e82"]
}, Open  ]],

Cell["\<\
An atom is an expression with no parts to take apart. Numbers, strings and \
symbols are atoms; everything else is built from them. AtomQ tests for this.\
\>", "Text",
 CellChangeTimes->{{3.9965556067481318`*^9, 
  3.996555617319639*^9}},ExpressionUUID->"c2d2805e-13e9-47cc-877f-\
e91e1966d124"],

Cell[CellGroupData[{

Cell["{AtomQ[42], AtomQ[\"text\"], AtomQ[x]}", "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"319c3216-6ee0-45d2-9cf4-1a3b7194f5a5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellChangeTimes->{3.996555624334729*^9},
 CellLabel->"Out[11]=",ExpressionUUID->"69173e4c-f35c-4aa4-bbb3-952f4a72c399"]
}, Open  ]],

Cell[CellGroupData[{

Cell["{AtomQ[{1, 2, 3}], AtomQ[a + b]}", "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"e666f8bb-ce39-44c9-840e-73b72dd6b58b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "False"}], "}"}]], "Output",
 CellChangeTimes->{3.996555626699267*^9},
 CellLabel->"Out[12]=",ExpressionUUID->"299aa757-ebd0-4289-9bfd-f87a84e5af32"]
}, Open  ]],

Cell["\<\
Atoms are where recursion through an expression stops. Any function that \
walks an expression structure must eventually reach atoms, and that is its \
natural base case.\
\>", "Text",ExpressionUUID->"7521196c-f5d1-4273-98ab-e29be06386e9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Accessing Parts with Part", "Subsubsection",ExpressionUUID->"48d4a224-a7a7-4c13-8293-ceadad558ed6"],

Cell["\<\
Part extracts elements of an expression. It is written either as Part[expr, \
i] or, more commonly, with the double bracket notation expr[[i]]. The two are \
identical.\
\>", "Text",ExpressionUUID->"9e7d595a-7736-416f-a9a5-a49141f97e79"],

Cell[CellGroupData[{

Cell["\<\
expr = f[a, b, c];
expr[[1]]\
\>", "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"56bc6da9-e2e2-4d68-8c8f-db6fc37e2e23"],

Cell[BoxData["a"], "Output",
 CellChangeTimes->{3.9965556475343857`*^9},
 CellLabel->"Out[14]=",ExpressionUUID->"9414829d-cb16-45be-a981-a829e940afc8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["expr[[0]]", "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"975c2701-b285-4b28-8237-4749e4a71124"],

Cell[BoxData["f"], "Output",
 CellChangeTimes->{3.996555650351054*^9},
 CellLabel->"Out[15]=",ExpressionUUID->"89d62575-f31b-4e72-9008-d928bec5fe26"]
}, Open  ]],

Cell["\<\
Because everything is an expression, Part works on sums exactly as it works \
on lists. Here the expression is Plus[x, y, z], so part 2 is y:\
\>", "Text",ExpressionUUID->"a0e1505c-de9a-4dfa-85ab-95218a969c47"],

Cell[CellGroupData[{

Cell["(x + y + z)[[2]]", "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"26d4a624-c6f1-4e46-b814-d2b920084287"],

Cell[BoxData["y"], "Output",
 CellChangeTimes->{3.996555662899104*^9},
 CellLabel->"Out[16]=",ExpressionUUID->"5f6f8351-b1b3-483f-9e7c-5ee7a94a271d"]
}, Open  ]],

Cell["Negative indices count backwards from the end:", "Text",ExpressionUUID->"78105b67-9f71-4e53-a299-a5d49f58f80a"],

Cell[CellGroupData[{

Cell["{10, 20, 30, 40}[[-1]]", "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"b25aa110-9f99-46ab-98d9-6a7d9503b50e"],

Cell[BoxData["40"], "Output",
 CellChangeTimes->{3.996555671565859*^9},
 CellLabel->"Out[17]=",ExpressionUUID->"b9cf418e-dd79-4af1-adbd-9e5b46ccc028"]
}, Open  ]],

Cell["\<\
Part also accepts a list of indices, or a span written m ;; n which extracts \
a contiguous range with both endpoints included:\
\>", "Text",ExpressionUUID->"3edb0841-c68a-4064-bb97-21ef7eb79008"],

Cell[CellGroupData[{

Cell["{10, 20, 30, 40}[[{1, 3}]]", "Input",
 CellLabel->"In[18]:=",ExpressionUUID->"cdd3662e-b584-498c-adaa-61bc1a464dc0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"10", ",", "30"}], "}"}]], "Output",
 CellChangeTimes->{3.99655567388192*^9},
 CellLabel->"Out[18]=",ExpressionUUID->"ab68d852-4298-4c80-af6b-003d0f0b0008"]
}, Open  ]],

Cell[CellGroupData[{

Cell["{10, 20, 30, 40}[[2 ;; 3]]", "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"323431fb-f3d6-4b9b-a61e-5ff4add590c3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"20", ",", "30"}], "}"}]], "Output",
 CellChangeTimes->{3.996555676150692*^9},
 CellLabel->"Out[19]=",ExpressionUUID->"b50854de-95f7-44c4-a906-6682557eed29"]
}, Open  ]],

Cell["Leaving an endpoint out means \"to the end\":", "Text",ExpressionUUID->"1599086c-5829-4ce6-a3f4-daff1933b177"],

Cell[CellGroupData[{

Cell["{10, 20, 30, 40}[[2 ;;]]", "Input",
 CellLabel->"In[20]:=",ExpressionUUID->"135dc88a-d9bd-4ba3-9dd3-9d237779e3a6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"20", ",", "30", ",", "40"}], "}"}]], "Output",
 CellChangeTimes->{3.9965556784827223`*^9},
 CellLabel->"Out[20]=",ExpressionUUID->"8c026379-d683-434e-8d8e-a26031bd4c5c"]
}, Open  ]],

Cell["\<\
For nested expressions, additional indices go deeper one level at a time. \
Here the first index selects a row and the second an element within it:\
\>", "Text",ExpressionUUID->"53a9907d-4e2b-4725-8175-fbfbfe3aba5f"],

Cell[CellGroupData[{

Cell["\<\
m = {{1, 2}, {3, 4}};
m[[1, 2]]\
\>", "Input",
 CellLabel->"In[21]:=",ExpressionUUID->"630f8406-653a-4bd8-bbc5-7d29b7f052c1"],

Cell[BoxData["2"], "Output",
 CellChangeTimes->{3.996555681934813*^9},
 CellLabel->"Out[22]=",ExpressionUUID->"08081fed-41ab-4107-9d95-357043a468d4"]
}, Open  ]],

Cell["\<\
All in an index position means \"every element at this level\", which is how \
you take a column out of a nested list. It works whatever the number of rows, \
because it does not depend on the length.\
\>", "Text",ExpressionUUID->"a968c743-3f9e-4247-a0c8-f9d4bf93f023"],

Cell[CellGroupData[{

Cell["m[[All, 1]]", "Input",
 CellLabel->"In[23]:=",ExpressionUUID->"c381f067-3c7c-4992-99ad-64003edbef1f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "3"}], "}"}]], "Output",
 CellChangeTimes->{3.9965556844628572`*^9},
 CellLabel->"Out[23]=",ExpressionUUID->"030b9d88-517f-4662-b00f-3e41c0b9e9f0"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Levels and Depth", "Subsubsection",ExpressionUUID->"edf70a1d-ec8c-4a4a-ac64-34f1698e0ec4"],

Cell["\<\
The elements of an expression sit at level 1, their elements at level 2, and \
so on. Level collects everything at a given level.\
\>", "Text",ExpressionUUID->"6e655f25-85db-406b-99ac-f6f0097eca7e"],

Cell["Level[{{1, 2}, {3}}, {1}]", "Input",ExpressionUUID->"2e7b67c5-8a37-4e90-b640-3987d18bbbcc"],

Cell["Level[{{1, 2}, {3}}, {2}]", "Input",ExpressionUUID->"aa2ad809-9386-4e1a-865f-397e556ea1aa"],

Cell["\<\
Depth reports how deeply nested an expression is. It counts the levels and \
adds one, so a flat list of numbers has depth 2 rather than 1.\
\>", "Text",ExpressionUUID->"f7bb3add-0b31-46a4-a525-aefa3d2259d4"],

Cell["{Depth[{1, 2, 3}], Depth[{{1, 2}, {3, 4}}]}", "Input",ExpressionUUID->"109b32a1-e2f7-4559-8841-1a93b5afbc3d"],

Cell["\<\
Level specifications appear throughout the language, in Map, Apply, Cases and \
Position among others, so the same idea transfers directly to those functions.\
\>", "Text",ExpressionUUID->"dbd678c8-6275-453c-a10e-2bb4856a4aa4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Reading an Unfamiliar Expression", "Subsubsection",
 CellChangeTimes->{{3.996555752665791*^9, 
  3.996555787692733*^9}},ExpressionUUID->"da3ce590-8d7b-43ef-ada6-\
85556b16ff49"],

Cell["\<\
When an expression does not behave as expected, the first useful step is \
almost always to look at its real structure rather than its displayed form.\
\>", "Text",ExpressionUUID->"fca21d71-c5de-43e0-87eb-c14516668d26"],

Cell["Look at what the expression actually is:", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"7d3f955f-b20a-488e-b545-ca5f7e98b649"],

Cell[CellGroupData[{

Cell["\<\
expr = 2 x + y^2;
FullForm[expr]\
\>", "Input",
 CellLabel->"In[24]:=",ExpressionUUID->"7b392ad2-dfad-4446-8161-6c24f35c3927"],

Cell[BoxData[
 TagBox[
  StyleBox[
   RowBox[{"Plus", "[", 
    RowBox[{
     RowBox[{"Times", "[", 
      RowBox[{"2", ",", "x"}], "]"}], ",", 
     RowBox[{"Power", "[", 
      RowBox[{"y", ",", "2"}], "]"}]}], "]"}],
   ShowSpecialCharacters->False,
   ShowStringCharacters->True,
   NumberMarks->True],
  FullForm]], "Output",
 CellChangeTimes->{3.9965557367816963`*^9},
 CellLabel->
  "Out[25]//FullForm=",ExpressionUUID->"a9f2abb1-557f-46d1-8f59-df8ef678bc9f"]
}, Open  ]],

Cell["\<\
The result shows Plus[Times[2, x], Power[y, 2]]. Now the parts are \
predictable: part 1 is the product and part 2 is the power.\
\>", "Text",ExpressionUUID->"94a89d34-896c-4327-8b37-eae3df951c06"],

Cell[CellGroupData[{

Cell["{expr[[1]], expr[[2]]}", "Input",
 CellLabel->"In[26]:=",ExpressionUUID->"09b43e31-5019-4c2e-8959-a8db933e7fd1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"2", " ", "x"}], ",", 
   SuperscriptBox["y", "2"]}], "}"}]], "Output",
 CellChangeTimes->{3.996555778283709*^9},
 CellLabel->"Out[26]=",ExpressionUUID->"24d1d016-f37f-4e3a-b3ad-34c243e79de9"]
}, Open  ]],

Cell["\<\
And because 2 x is itself Times[2, x], its parts can be reached the same way:\
\
\>", "Text",ExpressionUUID->"602a59ed-dc5a-4117-809a-e61d02ba7b47"],

Cell[CellGroupData[{

Cell["expr[[1, 1]]", "Input",
 CellLabel->"In[27]:=",ExpressionUUID->"9962776e-1b1f-4d63-8c3c-fac1ee860085"],

Cell[BoxData["2"], "Output",
 CellChangeTimes->{3.9965557808322563`*^9},
 CellLabel->"Out[27]=",ExpressionUUID->"9413d4ca-5cac-4bc9-983e-feb40ec9af60"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Searching a Nested Expression", "Subsubsection",
 CellChangeTimes->{{3.996555799642473*^9, 
  3.9965557998987913`*^9}},ExpressionUUID->"ab5b8176-4058-49ed-90a4-\
c91e2f985d46"],

Cell["\<\
Position and Extract together let you find and retrieve values from a \
structure whose shape you do not know in advance.\
\>", "Text",ExpressionUUID->"f5ce9a01-c7e5-43af-91fc-8067f0efa434"],

Cell["A nested structure with numbers buried at different depths:", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"25bfa769-5f6c-44b3-9b1e-2358905ab325"],

Cell["nested = {1, {2, {3, \"x\"}}, \"y\", 4};", "Input",
 CellLabel->"In[29]:=",ExpressionUUID->"7af7b883-d892-47a4-8249-6a6b56f077f4"],

Cell["Find where the integers are:", "Text",ExpressionUUID->"cc5dc3bc-48b5-409d-aa95-c1bb247f63ab"],

Cell[CellGroupData[{

Cell["Position[nested, _Integer]", "Input",
 CellLabel->"In[30]:=",ExpressionUUID->"af248d92-9763-4093-9c1c-d001ce317e3f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2", ",", "1"}], "}"}], ",", 
   RowBox[{"{", "4", "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.996555811613503*^9},
 CellLabel->"Out[30]=",ExpressionUUID->"7530931e-6d7e-4b72-b88c-40f2fecbe404"]
}, Open  ]],

Cell["\<\
The positions have different lengths because the integers sit at different \
depths. Extract handles that automatically:\
\>", "Text",ExpressionUUID->"2dfa755c-5a01-4ccf-ac86-edd72a462131"],

Cell[CellGroupData[{

Cell["Extract[nested, Position[nested, _Integer]]", "Input",
 CellLabel->"In[31]:=",ExpressionUUID->"ac605ddd-5de2-421c-a1af-5d19fd33efbf"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}]], "Output",
 CellChangeTimes->{3.996555814018505*^9},
 CellLabel->"Out[31]=",ExpressionUUID->"1e76f623-a36b-4f40-9be0-8fb3eb442d97"]
}, Open  ]],

Cell["\<\
This searches the whole expression at every level, which is what makes it \
useful when the structure is irregular.\
\>", "Text",ExpressionUUID->"9898aa02-6e18-4035-9299-6d176f9270ff"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Patterns", "Section",ExpressionUUID->"708378dc-1f92-48ea-8587-47344a18981e"],

Cell["\<\
A pattern is a template that describes the shape of an expression rather than \
one specific expression. Where 3 matches only the number 3, the pattern \
x_Integer matches any integer at all.
Patterns are not a minor feature bolted onto the language. They are how \
function arguments are specified, how rules decide what to rewrite, and how \
Cases and Select decide what to keep. Understanding patterns well is close to \
understanding the whole language, since almost every other topic in this \
notebook leans on them.\
\>", "Text",
 CellChangeTimes->{{3.9965558459515047`*^9, 
  3.996555852609202*^9}},ExpressionUUID->"6f09b32f-3e90-4962-ae20-\
b1fe0461d64f"],

Cell[CellGroupData[{

Cell["Blanks", "Subsubsection",ExpressionUUID->"d94f28b2-1684-4c26-883a-c662d9e9e912"],

Cell["\<\
A single underscore, written _, is a blank. It matches exactly one \
expression, whatever that expression happens to be.\
\>", "Text",ExpressionUUID->"d0fbf648-a448-4418-b76d-6eb8534d5edb"],

Cell[CellGroupData[{

Cell["MatchQ[5, _]", "Input",
 CellLabel->"In[32]:=",ExpressionUUID->"d223e44c-8422-4f5e-9a94-293a56ff90db"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.996555857680632*^9},
 CellLabel->"Out[32]=",ExpressionUUID->"a2117210-9f36-41e0-bad8-9661dfa883d1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["MatchQ[{1, 2, 3}, _]", "Input",
 CellLabel->"In[33]:=",ExpressionUUID->"4e1c7767-3171-4937-a19b-c264d4d0b883"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.996555859735365*^9},
 CellLabel->"Out[33]=",ExpressionUUID->"ac13e486-8385-43c2-bafa-46bbdb3bb158"]
}, Open  ]],

Cell[CellGroupData[{

Cell["MatchQ[f[1, 2, 3], f[__]]", "Input",
 CellLabel->"In[34]:=",ExpressionUUID->"eab01b51-8e1f-4d11-816e-8eaa5b49901a"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.996555871732768*^9},
 CellLabel->"Out[34]=",ExpressionUUID->"7577ca8e-26b1-4ece-8f17-90517d50b1d0"]
}, Open  ]],

Cell["\<\
A double blank, __, matches a sequence of one or more expressions. A triple \
blank, ___, matches a sequence of zero or more, so it also matches nothing at \
all:\
\>", "Text",ExpressionUUID->"8b651e70-5ced-45d6-b73e-51e38417c71f"],

Cell[CellGroupData[{

Cell["MatchQ[f[], f[___]]", "Input",
 CellLabel->"In[35]:=",ExpressionUUID->"461f8e2d-fe27-4704-8c55-b2bf3899510b"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.996555882751966*^9},
 CellLabel->"Out[35]=",ExpressionUUID->"f944f231-e83e-45b0-96a6-7e612daf446b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["MatchQ[f[], f[__]]", "Input",
 CellLabel->"In[36]:=",ExpressionUUID->"917e90cf-2ec8-4d93-be3c-8847eb0f1c44"],

Cell[BoxData["False"], "Output",
 CellChangeTimes->{3.9965558846160793`*^9},
 CellLabel->"Out[36]=",ExpressionUUID->"b840b270-2d56-4828-958d-e9e975009e5b"]
}, Open  ]],

Cell["\<\
The difference between __ and ___ is exactly whether an empty match is \
accepted, which matters when writing a recursive base case for an empty \
argument list.\
\>", "Text",ExpressionUUID->"9af24a72-97a4-4fae-93a1-40fabd6233b0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Named Patterns", "Subsubsection",ExpressionUUID->"cd9d14a7-54f2-4e65-9a79-479a1e5913cd"],

Cell["\<\
Writing a name before the underscore, as in x_, captures whatever the blank \
matched under that name, so it can be used again on the right-hand side of a \
rule or a function definition.\
\>", "Text",ExpressionUUID->"e5e5b66e-f26f-4e34-a983-c28ac90ec45f"],

Cell[CellGroupData[{

Cell["x_ /. 5 -> \"five\"", "Input",
 CellLabel->"In[37]:=",ExpressionUUID->"15270397-f12e-40f6-8a91-956399d01164"],

Cell[BoxData["x_"], "Output",
 CellChangeTimes->{3.996555892734082*^9},
 CellLabel->"Out[37]=",ExpressionUUID->"8723fa07-60cd-4c91-841d-d61afe263276"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
f[x_] := x^2;
f[6]\
\>", "Input",
 CellLabel->"In[38]:=",ExpressionUUID->"bb8f68c1-1388-4b3e-9dff-5148b2be0a3d"],

Cell[BoxData["36"], "Output",
 CellChangeTimes->{3.996555894768528*^9},
 CellLabel->"Out[39]=",ExpressionUUID->"20f40d64-1dd4-487a-83be-d2e583d58b2a"]
}, Open  ]],

Cell["\<\
Naming is what turns a pattern from a yes-or-no test into something that can \
build an answer. Without a name, the matched value cannot be referred to \
afterwards:\
\>", "Text",ExpressionUUID->"1e16909b-23db-492d-bb13-045fb41e737d"],

Cell[CellGroupData[{

Cell["Cases[{1, 2, 3, 4}, x_ /; x > 2]", "Input",
 CellLabel->"In[40]:=",ExpressionUUID->"3dbd2727-6a1a-4f53-a52e-2634d8c90c32"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "4"}], "}"}]], "Output",
 CellChangeTimes->{3.996555903648752*^9},
 CellLabel->"Out[40]=",ExpressionUUID->"bce21dc2-ea1f-4fe8-8e10-8baec0aa2673"]
}, Open  ]],

Cell["\<\
The same name can be reused later in the same pattern, which forces both \
occurrences to match the same value rather than merely the same shape:\
\>", "Text",ExpressionUUID->"04bb1804-e172-48f6-b96a-646312e6099b"],

Cell[CellGroupData[{

Cell["MatchQ[{3, 3}, {x_, x_}]", "Input",
 CellLabel->"In[41]:=",ExpressionUUID->"6f627c55-5ea6-4163-a492-e46381350b8a"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.996555914264139*^9},
 CellLabel->"Out[41]=",ExpressionUUID->"d6bb6534-eb7f-4d8d-88e8-7302193aaee8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["MatchQ[{3, 4}, {x_, x_}]", "Input",
 CellLabel->"In[42]:=",ExpressionUUID->"ad8da931-2c14-433d-b70b-a8e01317fd90"],

Cell[BoxData["False"], "Output",
 CellChangeTimes->{3.996555916083538*^9},
 CellLabel->"Out[42]=",ExpressionUUID->"e3bd3bd1-0a54-468b-839d-a5dacf5d0661"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Typed Patterns", "Subsubsection",ExpressionUUID->"2791f02a-d7df-4e87-8094-e1acbe707e88"],

Cell["\<\
Writing a head after the underscore, as in x_Integer, restricts the pattern \
to expressions with that head. This is one of the most common ways to \
constrain a function's arguments.\
\>", "Text",ExpressionUUID->"80ad779c-6eab-4c1b-8a24-5a7fb700228f"],

Cell[CellGroupData[{

Cell["\<\
{MatchQ[5, _Integer], MatchQ[5.0, _Integer], MatchQ[\"5\", _Integer]}\
\>", "Input",
 CellLabel->"In[43]:=",ExpressionUUID->"3596ee14-7f35-4e3b-9550-7716b7d95e6d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "False"}], "}"}]], "Output",
 CellChangeTimes->{3.996555928384445*^9},
 CellLabel->"Out[43]=",ExpressionUUID->"800475ad-6491-42bc-aaf8-c279f3946d61"]
}, Open  ]],

Cell["\<\
Only the plain integer matched. A real number and a string both fail, even \
though one of them looks numeric, because the type check is on the head, not \
on the appearance of the value.\
\>", "Text",ExpressionUUID->"7686e7e0-03ca-41e4-a14b-b3dc9513ca76"],

Cell[CellGroupData[{

Cell["\<\
describe[x_String] := \"text\";
describe[x_Integer] := \"number\";
{describe[\"hi\"], describe[7]}\
\>", "Input",
 CellLabel->"In[44]:=",ExpressionUUID->"28f1f007-af01-486a-9e57-14cfd28ac7d3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"text\"\>", ",", "\<\"number\"\>"}], "}"}]], "Output",
 CellChangeTimes->{3.9965559306369658`*^9},
 CellLabel->"Out[46]=",ExpressionUUID->"19e1e3b3-1fcd-4bfb-bfd4-93926ef97f97"]
}, Open  ]],

Cell["\<\
Typed patterns are what let a single function name carry several definitions \
side by side, each responsible for one kind of argument, with the language \
choosing between them automatically.\
\>", "Text",ExpressionUUID->"e872a37f-e84c-4ec8-aa50-25555ac73c03"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Conditions", "Subsubsection",ExpressionUUID->"72e29340-671a-430f-aa85-d6eae1c6b5a8"],

Cell["\<\
A condition, written with /; after the pattern, adds a test that must also \
succeed. It can refer to any name the pattern has already bound.\
\>", "Text",ExpressionUUID->"9501e20f-d04d-47f3-be97-7ed0e40878af"],

Cell[CellGroupData[{

Cell["Cases[{1, 2, 3, 4, 5}, x_ /; x > 3]", "Input",
 CellLabel->"In[47]:=",ExpressionUUID->"b2a947c5-ae91-496b-868b-8cc5d28c3d10"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"4", ",", "5"}], "}"}]], "Output",
 CellChangeTimes->{3.996555934266453*^9},
 CellLabel->"Out[47]=",ExpressionUUID->"98ff20eb-a1eb-4db6-99fb-29057503f055"]
}, Open  ]],

Cell["\<\
A shorter form places a ? directly after the blank, followed by a single test \
function. It reads naturally when the test does not need a name to refer to:\
\>", "Text",ExpressionUUID->"6a324d1f-4623-4557-9d65-d43d0c73be74"],

Cell[CellGroupData[{

Cell["Cases[{1, 2, 3, 4, 5}, _?EvenQ]", "Input",
 CellLabel->"In[48]:=",ExpressionUUID->"dd179123-82ec-49c2-a2dc-22d5215dd3b6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "4"}], "}"}]], "Output",
 CellChangeTimes->{3.99655593853687*^9},
 CellLabel->"Out[48]=",ExpressionUUID->"4ffa24e6-3e55-43e6-837f-aa4df75cd4b9"]
}, Open  ]],

Cell["\<\
The two forms overlap but are not identical. /; can test a relationship \
between several bound names at once, while ? applies exactly one function to \
exactly one matched value:\
\>", "Text",ExpressionUUID->"53f7dab9-803d-4000-bab0-a9ddec8e3bbc"],

Cell[CellGroupData[{

Cell["Cases[{{1, 5}, {3, 2}, {4, 4}}, {a_, b_} /; a < b]", "Input",
 CellLabel->"In[49]:=",ExpressionUUID->"d09235f0-2260-4013-a49d-8dc6e225aa1b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"1", ",", "5"}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.9965559407354593`*^9},
 CellLabel->"Out[49]=",ExpressionUUID->"b21ffdff-074e-4a68-8fc8-770a342b2b4c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Example : Choosing Between Several Shapes", "Subsubsection",
 CellChangeTimes->{
  3.996555981149716*^9},ExpressionUUID->"71126a86-40ad-45d5-9deb-\
78bb4c57f927"],

Cell["\<\
Typed and structural patterns together let one function definition describe \
several genuinely different cases, with the language selecting the right one \
automatically.\
\>", "Text",ExpressionUUID->"c448e81b-e2ee-4819-8367-b6d12de71097"],

Cell["Three shapes, described by different patterns:", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"38b42c45-dd56-4b0c-961f-222c33973fe9"],

Cell["\<\
describeShape[{r_}] := \"circle, radius \" <> ToString[r];
describeShape[{w_, h_}] := \"rectangle \" <> ToString[w] <> \"x\" <> \
ToString[h];
describeShape[x_ /; NumberQ[x]] := \"just a number\";\
\>", "Input",
 CellLabel->"In[50]:=",ExpressionUUID->"744c4c78-08d0-4949-9d1b-0a9ffdbee3e4"],

Cell["\<\
Each call is matched against the patterns in turn, and the first one whose \
shape fits is used:\
\>", "Text",ExpressionUUID->"5802023d-7415-4007-b7fe-6d8d76bc61c3"],

Cell[CellGroupData[{

Cell["\<\
{describeShape[{5}], describeShape[{3, 4}], describeShape[7]}\
\>", "Input",
 CellLabel->"In[53]:=",ExpressionUUID->"a18d2304-684e-4123-98c4-cc5926e3dffa"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"circle, radius 5\"\>", ",", "\<\"rectangle 3x4\"\>", 
   ",", "\<\"just a number\"\>"}], "}"}]], "Output",
 CellChangeTimes->{3.9965560037171183`*^9},
 CellLabel->"Out[53]=",ExpressionUUID->"2d705689-0afc-4c6e-86e7-0f8ae68ab609"]
}, Open  ]],

Cell["\<\
None of this required checking Length or Head by hand inside the function \
body. The patterns did that checking as part of deciding which definition \
applies.\
\>", "Text",ExpressionUUID->"12cba27a-0462-4249-a49c-22a4b02b562f"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Rules", "Section",ExpressionUUID->"873345a7-1cf3-4074-b914-01585f662486"],

Cell["\<\
A rule describes a transformation: it says that whatever matches the \
left-hand side should be rewritten as the right-hand side. Rules are written \
lhs -> rhs and are applied to an expression with the replacement operator /..
Rules are central to the Wolfram Language because evaluation itself is \
rewriting. Built-in functions such as Solve and Reduce return their answers \
as rules, and function definitions are stored internally as rules. \
Understanding them means understanding how the language actually works, not \
just how to use one more operator.\
\>", "Text",
 CellChangeTimes->{{3.996559787251148*^9, 
  3.996559798268505*^9}},ExpressionUUID->"874cd9dd-0267-449d-a812-\
0219e0941a74"],

Cell[CellGroupData[{

Cell["Applying a Rule", "Subsubsection",ExpressionUUID->"cfe97210-2279-4d80-98f8-4a01b643cc05"],

Cell["\<\
The replacement operator /. takes an expression on the left and one or more \
rules on the right, and returns a new expression with the replacements made.\
\>", "Text",ExpressionUUID->"ea4d0a94-7b62-47c0-afed-72a827d9c175"],

Cell[CellGroupData[{

Cell["x + y /. x -> 2", "Input",
 CellLabel->"In[54]:=",ExpressionUUID->"e172ae6c-be98-4de5-8dc3-f3efb1cf0e24"],

Cell[BoxData[
 RowBox[{"2", "+", "y"}]], "Output",
 CellChangeTimes->{3.996560403894162*^9},
 CellLabel->"Out[54]=",ExpressionUUID->"8de30c85-8ec0-45ba-a2eb-1f1da205fd22"]
}, Open  ]],

Cell["\<\
Replacement is not assignment. Nothing about x has changed, a new expression \
was produced and the original was left alone. Evaluating x on its own \
confirms it is still an ordinary undefined symbol.\
\>", "Text",
 CellChangeTimes->{{3.996560391470025*^9, 
  3.996560392756666*^9}},ExpressionUUID->"6b136df9-4568-4011-b00c-\
f51351111611"],

Cell[CellGroupData[{

Cell["x", "Input",
 CellLabel->"In[55]:=",ExpressionUUID->"441434d5-4c15-486f-95a8-87ba2c3f4ff1"],

Cell[BoxData["x"], "Output",
 CellChangeTimes->{3.996560406944062*^9},
 CellLabel->"Out[55]=",ExpressionUUID->"3e372c5d-009a-44bd-8cf2-371a042fa906"]
}, Open  ]],

Cell["\<\
This is what makes rules safe to use. You can rewrite an expression for one \
purpose without permanently affecting anything.
A rule can match any part of an expression, not only a whole symbol:\
\>", "Text",
 CellChangeTimes->{
  3.996560397160757*^9},ExpressionUUID->"23576b62-c7e7-411f-8b5e-\
48f9ceff9d74"],

Cell[CellGroupData[{

Cell["{1, 2, 3} /. 2 -> \"two\"", "Input",
 CellLabel->"In[56]:=",ExpressionUUID->"b853b80c-a370-4818-a2a0-4b8aaca93d1e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "\<\"two\"\>", ",", "3"}], "}"}]], "Output",
 CellChangeTimes->{3.99656041137687*^9},
 CellLabel->"Out[56]=",ExpressionUUID->"9639b3de-1ff7-4a0e-9a7a-9c0477211514"]
}, Open  ]],

Cell["\<\
Several rules can be supplied as a list. They are tried in order, and the \
first one that matches a given part is the one used:\
\>", "Text",ExpressionUUID->"54133f83-839a-42df-8e33-523fd0c4ec41"],

Cell[CellGroupData[{

Cell["{1, 2, 3} /. {1 -> \"one\", n_Integer -> \"number\"}", "Input",
 CellLabel->"In[57]:=",ExpressionUUID->"219ec225-784a-4372-87db-2b1002a6a422"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"one\"\>", ",", "\<\"number\"\>", ",", "\<\"number\"\>"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.996560415875904*^9},
 CellLabel->"Out[57]=",ExpressionUUID->"9fbdb9a7-efc0-4c36-ac7a-2d46e9c1ba5c"]
}, Open  ]],

Cell["\<\
Here 1 matched the first rule, while 2 and 3 fell through to the second. If \
the rules were listed the other way round, the general rule would catch \
everything and the specific one would never be reached.\
\>", "Text",ExpressionUUID->"f3db21fa-b316-44a9-bbae-1ad0708f035a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Rules with Patterns", "Subsubsection",ExpressionUUID->"6fc9ab46-dc04-4946-b001-955c71833ea2"],

Cell["\<\
A rule becomes far more useful when the left-hand side is a pattern rather \
than a literal value. A named blank captures whatever it matched, and that \
name can then be used on the right-hand side.\
\>", "Text",ExpressionUUID->"650c4d00-4dc8-467e-bbdf-3d987f4bbcc1"],

Cell[CellGroupData[{

Cell["f[a] + f[b] /. f[t_] -> t^2", "Input",
 CellLabel->"In[58]:=",ExpressionUUID->"5096f1f3-98e4-4d2e-9213-0e006a40d98a"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["a", "2"], "+", 
  SuperscriptBox["b", "2"]}]], "Output",
 CellChangeTimes->{3.996560421026668*^9},
 CellLabel->"Out[58]=",ExpressionUUID->"5d7b9e4e-e2fa-44cf-ae0b-0fc1c0397c05"]
}, Open  ]],

Cell["\<\
The pattern f[t_] matched both f[a] and f[b], binding t to a and then to b, \
and each was rewritten using the captured value.
Typed patterns restrict what is allowed to match, so a rule can be aimed at \
one kind of object only:\
\>", "Text",
 CellChangeTimes->{
  3.996560424212845*^9},ExpressionUUID->"8860e4f4-dc14-4a4d-8b66-\
c12bb24ea88c"],

Cell[CellGroupData[{

Cell["{1, \"a\", 2.5, 3} /. n_Integer -> 0", "Input",
 CellLabel->"In[59]:=",ExpressionUUID->"735b3b9e-bc5b-40a4-b3bb-3d0c66620926"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "\<\"a\"\>", ",", "2.5`", ",", "0"}], "}"}]], "Output",
 CellChangeTimes->{3.996560427142041*^9},
 CellLabel->"Out[59]=",ExpressionUUID->"260ae69d-0823-4e5d-8a24-a4b60e91c652"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Conditions", "Subsubsection",ExpressionUUID->"3cac2f71-68e1-43fd-9ee2-a403bba7d08a"],

Cell["\<\
A condition narrows a pattern further by attaching a test that must also be \
satisfied. It is written with /; after the pattern, and the test can use the \
names bound by the pattern.\
\>", "Text",ExpressionUUID->"4c2d4fe4-702a-4e04-8885-99390085c3eb"],

Cell[CellGroupData[{

Cell["{1, 2, 3, 4, 5} /. n_ /; n > 3 -> big", "Input",
 CellLabel->"In[60]:=",ExpressionUUID->"51dec6c1-1766-4dde-bcd4-1ca200e0e76c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3", ",", "big", ",", "big"}], "}"}]], "Output",\

 CellChangeTimes->{3.9965604369739237`*^9},
 CellLabel->"Out[60]=",ExpressionUUID->"28556e2e-c6ec-40c0-a2d7-3cdf0e5b94d2"]
}, Open  ]],

Cell["\<\
Only 4 and 5 satisfied the condition, so only those two were rewritten. The \
condition binds more tightly than the rule arrow, so the expression is read \
as (n_ /; n > 3) -> big, which is the intended meaning.
A short test can also be written with ? directly after the blank, which is \
more compact when the test is a single function:\
\>", "Text",
 CellChangeTimes->{
  3.996560440291552*^9},ExpressionUUID->"2ab86f5b-4c5c-4937-b32b-\
54dab3bc3c5f"],

Cell[CellGroupData[{

Cell["{1, 2, 3, 4} /. n_?EvenQ -> 0", "Input",
 CellLabel->"In[61]:=",ExpressionUUID->"06ac2b7e-95f8-4095-a0ca-69381cb4bce0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "0", ",", "3", ",", "0"}], "}"}]], "Output",
 CellChangeTimes->{3.9965604426586237`*^9},
 CellLabel->"Out[61]=",ExpressionUUID->"dda57198-07f5-45d7-b7f8-448be5f8d7ea"]
}, Open  ]],

Cell["\<\
The two forms overlap, but /; is more general because it can test a \
combination of several bound names, while ? applies one function to one \
matched value.\
\>", "Text",ExpressionUUID->"effd6386-abbe-4694-a522-604e431f5f89"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Immediate and Delayed Rules", "Subsubsection",ExpressionUUID->"e7ce7215-85a7-469a-921d-52b76417f382"],

Cell["\<\
There are two rule arrows. With ->, the right-hand side is evaluated once, at \
the moment the rule itself is built. With :>, the right-hand side is held and \
evaluated separately for every match.
When the right-hand side is an ordinary algebraic expression the two behave \
the same, so the distinction is easiest to see with something that produces a \
different answer each time it runs.\
\>", "Text",
 CellChangeTimes->{
  3.996560449209711*^9},ExpressionUUID->"4a1a873e-957d-473e-8c1b-\
9466a8f70a69"],

Cell["An immediate rule evaluates its right-hand side once:", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"db22a116-4728-459c-bcf5-51982a4a70be"],

Cell[CellGroupData[{

Cell["{1, 2, 3} /. n_ -> RandomInteger[100]", "Input",
 CellLabel->"In[62]:=",ExpressionUUID->"b0582b30-f953-4b43-84cc-9f11424d67f6"],

Cell[BoxData["73"], "Output",
 CellChangeTimes->{3.996560451492391*^9},
 CellLabel->"Out[62]=",ExpressionUUID->"e04979b4-4d86-47d7-a5e5-cc2713e7e0f4"]
}, Open  ]],

Cell["\<\
All three positions receive the same number, because the random integer was \
generated once, before the replacement began.\
\>", "Text",ExpressionUUID->"c59872b4-4734-4453-8889-52a96dac433f"],

Cell["A delayed rule evaluates its right-hand side per match:", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"c778321b-0aa6-4810-8943-a63bdae5671a"],

Cell[CellGroupData[{

Cell["{1, 2, 3} /. n_ :> RandomInteger[100]", "Input",
 CellLabel->"In[63]:=",ExpressionUUID->"667450eb-ff43-4f48-8574-bcf9b65d9942"],

Cell[BoxData["30"], "Output",
 CellChangeTimes->{3.996560454928279*^9},
 CellLabel->"Out[63]=",ExpressionUUID->"e481b70c-10bc-4eb7-8f85-c989562fb618"]
}, Open  ]],

Cell["\<\
Now each position gets its own number. The rule is the same in structure; \
only the timing of the evaluation differs.\
\>", "Text",
 CellChangeTimes->{{3.99656045678323*^9, 
  3.99656045989634*^9}},ExpressionUUID->"38385740-a0fe-4dd9-b6f7-\
43f6b4381bd7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Repeated Replacement", "Subsubsection",ExpressionUUID->"6ac7f05a-7983-42bc-af1f-b29e5e48980d"],

Cell["\<\
The operator /. makes one pass over the expression. If a replacement creates \
something that could itself be replaced, that new match is not revisited.\
\>", "Text",ExpressionUUID->"77200786-9110-4fe3-a1fc-3616132bf05f"],

Cell[CellGroupData[{

Cell["f[f[f[x]]] /. f[t_] :> t", "Input",
 CellLabel->"In[64]:=",ExpressionUUID->"3d4ed2a4-584b-4e18-ad9a-7776cc9fcc7e"],

Cell[BoxData[
 SuperscriptBox["x", "8"]], "Output",
 CellChangeTimes->{3.996560466361402*^9},
 CellLabel->"Out[64]=",ExpressionUUID->"4a4e7de9-da15-423d-938d-e96cec0479ac"]
}, Open  ]],

Cell["\<\
One layer of f was stripped from each match found in that single pass, but \
the result was not re-examined. The operator //. keeps applying the rules \
until the expression stops changing.\
\>", "Text",ExpressionUUID->"23fbf13c-e111-45ba-85a0-1da4067cab17"],

Cell[CellGroupData[{

Cell["f[f[f[x]]] //. f[t_] :> t", "Input",
 CellLabel->"In[65]:=",ExpressionUUID->"b5f2df85-627f-4f21-b3a8-a01beb945268"],

Cell[BoxData[
 SuperscriptBox["x", "8"]], "Output",
 CellChangeTimes->{3.99656046910956*^9},
 CellLabel->"Out[65]=",ExpressionUUID->"60c47bcd-c9b6-4fd8-859f-519d830f8c7d"]
}, Open  ]],

Cell["\<\
This is called reaching a fixed point. It is exactly the right tool for \
simplification rules that need to be applied over and over, but it carries an \
obvious risk: a rule that always produces a new match will never settle. The \
language stops after a large number of iterations rather than running \
forever, but the result will not be what was intended.\
\>", "Text",ExpressionUUID->"b615e20d-c7ae-4b64-9585-378661f89c8b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Rules Returned by Solve", "Subsubsection",
 CellChangeTimes->{
  3.9965604989859333`*^9},ExpressionUUID->"d8e4a18e-cdeb-4c83-8569-\
5af141a2fb9c"],

Cell["\<\
Rules are not only something you write yourself. Several built-in functions \
return their answers as rules, and knowing how to apply them is what makes \
those answers usable.\
\>", "Text",ExpressionUUID->"2ee84436-faed-4ab3-998b-805423de8b0d"],

Cell["Solve returns a list of solutions, each a list of rules:", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"4f64b770-24d9-4925-9b24-7dd2206b5f39"],

Cell[CellGroupData[{

Cell["sols = Solve[x^2 == 4, x]", "Input",
 CellLabel->"In[66]:=",ExpressionUUID->"c715b125-180e-4464-a8ec-3a0497ef2d2a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", "\[Rule]", 
     RowBox[{"-", "2"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", "\[Rule]", "2"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.996560507104642*^9},
 CellLabel->"Out[66]=",ExpressionUUID->"2d786393-3c8c-4590-a119-9beb777aeaee"]
}, Open  ]],

Cell["\<\
The answer is not a number but a description of how to rewrite x. Applying it \
with /. turns it into values:\
\>", "Text",ExpressionUUID->"cf9bddf1-0846-4280-9bf9-4272ae00ece0"],

Cell[CellGroupData[{

Cell["x /. sols", "Input",
 CellLabel->"In[67]:=",ExpressionUUID->"4b97040a-b63c-4420-9a6d-b840868e4afc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "2"}], ",", "2"}], "}"}]], "Output",
 CellChangeTimes->{3.996560509210786*^9},
 CellLabel->"Out[67]=",ExpressionUUID->"a4019206-c4e1-4f41-8839-a7c20dd747eb"]
}, Open  ]],

Cell["\<\
The same idea works on any expression, which is how a solution gets \
substituted back in to be checked or used further:\
\>", "Text",ExpressionUUID->"c3d2a218-bb03-4d19-b626-8bac1af7dff6"],

Cell[CellGroupData[{

Cell["x^2 + 1 /. sols", "Input",
 CellLabel->"In[68]:=",ExpressionUUID->"7d640472-1c93-43ce-8d2a-7a455ce76f3c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"5", ",", "5"}], "}"}]], "Output",
 CellChangeTimes->{3.9965605140427027`*^9},
 CellLabel->"Out[68]=",ExpressionUUID->"34b971a9-0613-4bfd-920f-ff281a3fba9c"]
}, Open  ]]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Functions", "Section",ExpressionUUID->"58b96616-fc77-4876-896a-3450071f5b85"],

Cell["\<\
A function definition in the Wolfram Language is a rule that the language \
remembers. Writing f[x_] := x^2 does not create a function object in the way \
other languages do; it records a rewriting rule saying that anything of the \
form f[something] should become that something squared.
This explains behaviour that is otherwise surprising. A single name can carry \
many definitions at once, the language chooses between them by pattern \
matching, and definitions can be inspected and removed like any other data.\
\>", "Text",
 CellChangeTimes->{{3.996560532659379*^9, 
  3.996560535836452*^9}},ExpressionUUID->"ddfab5c1-92e1-440b-9f8e-\
9aec3ddf913a"],

Cell[CellGroupData[{

Cell["Defining a Function", "Subsubsection",ExpressionUUID->"23cd3068-2afb-4f97-9e85-4e5d5a565645"],

Cell["\<\
A definition has a pattern on the left and a body on the right. The blank in \
x_ is what makes the definition apply to any argument rather than to one \
particular value.\
\>", "Text",ExpressionUUID->"beb1b958-3b58-48f5-91ba-c869ce6d4278"],

Cell[CellGroupData[{

Cell["\<\
square[x_] := x^2;
square[5]\
\>", "Input",
 CellLabel->"In[69]:=",ExpressionUUID->"bb9e0fcf-3481-483f-bef0-7dac12efb307"],

Cell[BoxData["25"], "Output",
 CellChangeTimes->{3.996560538689907*^9},
 CellLabel->"Out[70]=",ExpressionUUID->"4d5c3fa9-cb15-4723-a76c-32c074a1d6fa"]
}, Open  ]],

Cell["\<\
The name x on the right refers to whatever the pattern captured. Because the \
left-hand side is a pattern, the definition works for arguments of any kind, \
including symbolic ones:\
\>", "Text",ExpressionUUID->"10357bc4-7dfd-4ed6-9596-1b06bac636ce"],

Cell[CellGroupData[{

Cell["square[a + b]", "Input",
 CellLabel->"In[71]:=",ExpressionUUID->"682697f6-2646-44ce-b367-0843ad09eea7"],

Cell[BoxData[
 SuperscriptBox[
  RowBox[{"(", 
   RowBox[{"a", "+", "b"}], ")"}], "2"]], "Output",
 CellChangeTimes->{3.996560541171198*^9},
 CellLabel->"Out[71]=",ExpressionUUID->"17f9cdc0-4fa2-4f67-93ea-d63fcbbcb7b1"]
}, Open  ]],

Cell["\<\
A definition without the blank applies to one value only. This is not a \
mistake; it is how special cases are written, and it is the basis of every \
recursive base case.\
\>", "Text",ExpressionUUID->"f0c8ca2e-aa89-466d-bdaf-cbb40e0c00ea"],

Cell[CellGroupData[{

Cell["\<\
greet[\"ann\"] := \"hello ann\";
greet[\"ann\"]\
\>", "Input",
 CellLabel->"In[72]:=",ExpressionUUID->"0b130e01-c396-4538-b206-76c900e1263d"],

Cell[BoxData["\<\"hello ann\"\>"], "Output",
 CellChangeTimes->{3.996560545237577*^9},
 CellLabel->"Out[73]=",ExpressionUUID->"79edfcff-c5eb-4c98-8416-3335eb670702"]
}, Open  ]],

Cell["\<\
Asking for an argument that has no matching definition returns the expression \
unevaluated rather than raising an error. This is normal, and it is often the \
first clue that a definition did not apply as expected.\
\>", "Text",ExpressionUUID->"b8f8f635-d22e-443d-a8e2-c4476d7d4101"],

Cell[CellGroupData[{

Cell["greet[\"raj\"]", "Input",
 CellLabel->"In[74]:=",ExpressionUUID->"8529ec58-f24d-4305-b030-0927429c4365"],

Cell[BoxData[
 RowBox[{"greet", "[", "\<\"raj\"\>", "]"}]], "Output",
 CellChangeTimes->{3.996560547153243*^9},
 CellLabel->"Out[74]=",ExpressionUUID->"74716b1d-e452-4ffd-bb63-5554e85d7e10"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Set and SetDelayed", "Subsubsection",ExpressionUUID->"82a85839-1d01-448f-a4ec-0b6d5ef77e42"],

Cell["\<\
There are two assignment operators. With =, the right-hand side is evaluated \
once, at the moment the definition is made, and the result is stored. With \
:=, the right-hand side is stored unevaluated and is worked out afresh on \
every call.\
\>", "Text",ExpressionUUID->"936ab9d6-63cd-499e-ac52-d86d4a3028ed"],

Cell["\<\
Evaluated once at definition time, so the stored body is already expanded:\
\>", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"f6060e72-ed41-4e80-8d48-eb7d36fbef88"],

Cell[CellGroupData[{

Cell["\<\
immediate[x_] = Expand[(x + 1)^2];
immediate[y]\
\>", "Input",
 CellLabel->"In[75]:=",ExpressionUUID->"31834b14-09f5-4a28-9451-6530fb96aba2"],

Cell[BoxData[
 RowBox[{"1", "+", 
  RowBox[{"2", " ", "y"}], "+", 
  SuperscriptBox["y", "2"]}]], "Output",
 CellChangeTimes->{3.996560550274871*^9},
 CellLabel->"Out[76]=",ExpressionUUID->"1711a175-85ca-4fa2-8808-3a80f12e80ad"]
}, Open  ]],

Cell["\<\
Evaluated on every call, so the expansion happens each time it is used:\
\>", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"0c32c785-0b2e-4c41-b00f-e63556fc14a7"],

Cell[CellGroupData[{

Cell["\<\
delayed[x_] := Expand[(x + 1)^2];
delayed[y]\
\>", "Input",
 CellLabel->"In[77]:=",ExpressionUUID->"1c251438-f667-42bc-923c-ec16ae681836"],

Cell[BoxData[
 RowBox[{"1", "+", 
  RowBox[{"2", " ", "y"}], "+", 
  SuperscriptBox["y", "2"]}]], "Output",
 CellChangeTimes->{3.9965605526238117`*^9},
 CellLabel->"Out[78]=",ExpressionUUID->"52c1d370-87d6-4865-ac5f-881e4791eb58"]
}, Open  ]],

Cell["\<\
Both give the same answer here, so the difference is invisible in the result. \
It becomes visible when the body depends on something that can change, or \
when it should not be evaluated in advance at all. Comparing the stored \
definitions shows what actually happened:\
\>", "Text",ExpressionUUID->"2ad7b37e-2f6f-4f0b-aa93-3d0fd69f3487"],

Cell[CellGroupData[{

Cell["DownValues[immediate]", "Input",
 CellLabel->"In[79]:=",ExpressionUUID->"5e098635-0faf-4892-ab02-b21b3ec9bce7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"HoldPattern", "[", 
    RowBox[{"immediate", "[", "x_", "]"}], "]"}], "\[RuleDelayed]", 
   RowBox[{"1", "+", 
    RowBox[{"2", " ", "x"}], "+", 
    SuperscriptBox["x", "2"]}]}], "}"}]], "Output",
 CellChangeTimes->{3.9965605713032703`*^9},
 CellLabel->"Out[79]=",ExpressionUUID->"c7094b89-1d84-4590-a0d4-a4b2a0bc5bac"]
}, Open  ]],

Cell[CellGroupData[{

Cell["DownValues[delayed]", "Input",
 CellChangeTimes->{{3.996560557271317*^9, 3.996560557626918*^9}},
 CellLabel->"In[80]:=",ExpressionUUID->"11db16eb-fe9d-466b-8e80-dc899b31727e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"HoldPattern", "[", 
    RowBox[{"delayed", "[", "x_", "]"}], "]"}], "\[RuleDelayed]", 
   RowBox[{"Expand", "[", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"x", "+", "1"}], ")"}], "2"], "]"}]}], "}"}]], "Output",
 CellChangeTimes->{3.996560573770288*^9},
 CellLabel->"Out[80]=",ExpressionUUID->"9fcf0533-dd2f-4eeb-b082-54efe1f4dfc8"]
}, Open  ]],

Cell["\<\
The immediate definition stored the expanded polynomial; the delayed one \
stored the call to Expand. As a working habit, use := for function \
definitions unless there is a specific reason to want the body computed once \
in advance.\
\>", "Text",ExpressionUUID->"320f3d1d-5b08-4014-aadb-9d1bbc07129c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Argument Patterns", "Subsubsection",ExpressionUUID->"074ba9a5-b0d1-4111-a4dc-01dc0a2608c7"],

Cell["\<\
Because the left-hand side is a pattern, it can restrict which arguments a \
definition accepts. A typed blank such as x_Integer only matches expressions \
with that head.\
\>", "Text",ExpressionUUID->"c46de0a3-df78-4c7d-bf23-eacb784bcbf1"],

Cell["\<\
describe[x_Integer] := \"an integer\";
describe[x_String] := \"a string\";
{describe[7], describe[\"seven\"]}\
\>", "Input",ExpressionUUID->"3ba1dda7-f4cb-47bc-9bc2-94c9b670d53c"],

Cell["\<\
Both definitions belong to the same symbol. The language selects between them \
by matching, not by any ordering you control directly. An argument matching \
neither leaves the expression unevaluated:\
\>", "Text",ExpressionUUID->"b6b632e2-21b9-4532-abb1-da70227f7588"],

Cell["describe[3.5]", "Input",ExpressionUUID->"fe93040e-dd88-45a9-8cea-62123ca4a930"],

Cell["\<\
Functions of several arguments follow the same principle, with one pattern \
per argument:\
\>", "Text",ExpressionUUID->"9f0cbec0-4f5f-4727-bf9b-5424c4736752"],

Cell["\<\
combine[a_, b_] := a*10 + b;
combine[3, 4]\
\>", "Input",ExpressionUUID->"cb7c07f0-4229-42b8-80a3-d6f5f100b2ed"],

Cell["\<\
When a specific definition and a general one could both apply, the more \
specific is used. This is what allows a base case and a recursive case to \
coexist under one name:\
\>", "Text",ExpressionUUID->"1cc7ef21-f786-4c9d-869d-01c9d8d5e467"],

Cell["\<\
factorial[1] := 1;
factorial[n_Integer] := n*factorial[n - 1];
factorial[5]\
\>", "Input",ExpressionUUID->"eebc7b7e-ec7b-4bd6-913f-d4106b083050"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Conditions and Defaults", "Subsubsection",ExpressionUUID->"a8727a82-2f78-4573-b18d-3a3246c19fc4"],

Cell["\<\
A condition attached with /; restricts a definition beyond what the pattern \
alone can express. It is checked at the time of the call, and if it fails the \
definition simply does not apply.\
\>", "Text",ExpressionUUID->"6a9adc2e-0d37-468b-9d48-78d68373178c"],

Cell["\<\
safeSqrt[n_ /; n >= 0] := Sqrt[n];
safeSqrt[9]\
\>", "Input",ExpressionUUID->"858f23c2-4081-4379-ba48-39f009999594"],

Cell["\<\
A negative argument matches the pattern n_ but fails the condition, so no \
definition applies and the call is returned unevaluated. That is often better \
than returning a wrong answer silently.\
\>", "Text",ExpressionUUID->"ea84bf38-26ce-4ad7-88d5-0f66d4fa6ff0"],

Cell["safeSqrt[-9]", "Input",ExpressionUUID->"3477bcd2-88dc-4443-a33b-c842fae3f8ac"],

Cell["\<\
An optional argument is written with a colon and a default value. If the \
argument is omitted, the default is used in its place:\
\>", "Text",ExpressionUUID->"e4e2ebad-c1cb-4d6d-852f-329c4d062b12"],

Cell["\<\
power[base_, exp_: 2] := base^exp;
{power[3], power[3, 3]}\
\>", "Input",ExpressionUUID->"bebf161d-11fa-4230-a426-4763b0f6a219"],

Cell["\<\
This avoids having to write two nearly identical definitions when one \
argument usually takes the same value.\
\>", "Text",ExpressionUUID->"5a0e43f4-08de-4344-968f-cccdd07cbb2e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Inspecting and Clearing Definitions", "Subsubsection",ExpressionUUID->"bc4aa01f-7b56-4ab3-b217-41c55435986e"],

Cell["\<\
Because definitions are stored as rules, they can be examined. DownValues \
returns everything currently defined for a symbol, as a list of rules.\
\>", "Text",ExpressionUUID->"baa20237-a575-42bd-b19a-65444ff43ae4"],

Cell["DownValues[describe]", "Input",ExpressionUUID->"65631094-0505-4189-8eb5-1e0c7ecccccd"],

Cell["\<\
Clear removes the definitions but leaves the symbol itself in place, so the \
name can be redefined cleanly:\
\>", "Text",ExpressionUUID->"461ad032-780f-4040-8104-491af3dcde49"],

Cell["\<\
Clear[describe];
DownValues[describe]\
\>", "Input",ExpressionUUID->"46a7fdf4-d2c7-4a02-b226-276010c6c393"],

Cell["\<\
Forgetting to clear is a common source of confusion. An old definition that \
is more specific than a new one will keep being selected, and the new \
definition appears to have no effect. When a function behaves as though an \
edit did not take, checking DownValues is usually the fastest way to see why.\
\
\>", "Text",ExpressionUUID->"09818c52-b379-47b4-becb-da1142424f19"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Example: Several Definitions for One Name", "Subsubsection",
 CellChangeTimes->{{3.996560601315947*^9, 
  3.996560607588312*^9}},ExpressionUUID->"647867ea-b3e6-4855-b6cf-\
4ccdbd567204"],

Cell["\<\
This example shows a single function whose behaviour is spread across several \
definitions, each responsible for one case. The pattern matcher does the work \
that a chain of conditional statements would do in another language.\
\>", "Text",ExpressionUUID->"fe36fd20-7d23-4a5b-aa3f-c8e9b656fa73"],

Cell["Three definitions, from most specific to most general:", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"8e755e6f-a567-445a-a6bb-32757b78aaf8"],

Cell["\<\
area[\"circle\", r_] := Pi*r^2;
area[\"square\", s_] := s^2;
area[\"rectangle\", w_, h_] := w*h;\
\>", "Input",ExpressionUUID->"5e3782f0-2ddd-4148-8fff-d02b8aa7ef46"],

Cell["\<\
Each call selects its definition by matching both the label and the number of \
arguments:\
\>", "Text",ExpressionUUID->"69c774f1-004d-4a2e-abb2-258b19134689"],

Cell["\<\
{area[\"circle\", 2], area[\"square\", 3], area[\"rectangle\", 2, 5]}\
\>", "Input",ExpressionUUID->"3b1e6046-c81d-4ad4-998f-430667e48ffe"],

Cell["\<\
Nothing about the number of arguments had to be checked by hand. A shape that \
was never defined simply does not match, and says so by staying unevaluated:\
\>", "Text",ExpressionUUID->"ac296ffd-a752-478a-afcb-416cfad62874"],

Cell["area[\"triangle\", 3, 4]", "Input",ExpressionUUID->"145fe4cd-f783-417a-9f8e-01f1b6813055"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Pure Functions", "Section",ExpressionUUID->"b0df4224-d033-487b-8968-cfb65436557b"],

Cell["\<\
A pure function is a function with no name. It is written where it is needed \
and used immediately, instead of being defined in advance with a name of its \
own.
This matters because so much of the Wolfram Language takes a function as an \
argument. Map, Select, Sort and many others all expect to be handed a \
function, and most of the time that function is used once and never again. \
Giving it a name would add clutter without adding meaning.\
\>", "Text",
 CellChangeTimes->{{3.996560647492916*^9, 
  3.9965606501698723`*^9}},ExpressionUUID->"2bfcce96-4215-45b7-81f0-\
5f8b9b7facf7"],

Cell[CellGroupData[{

Cell["The Function Form", "Subsubsection",ExpressionUUID->"22933c83-740a-4a1b-bbd8-8f988e84fd2b"],

Cell["\<\
The explicit form names its arguments. Function[x, body] builds a function of \
one argument called x, which can then be applied like any other function.\
\>", "Text",ExpressionUUID->"e09a33bd-9e4d-4ae8-ab13-a82e920e8ffb"],

Cell[CellGroupData[{

Cell["Function[x, x^2][4]", "Input",
 CellLabel->"In[81]:=",ExpressionUUID->"7505c740-88ff-463f-bbff-c598f78f023c"],

Cell[BoxData["16"], "Output",
 CellChangeTimes->{3.99656065336764*^9},
 CellLabel->"Out[81]=",ExpressionUUID->"7f99da1f-c915-4b3b-a602-e38cb8a471dd"]
}, Open  ]],

Cell["\<\
The name x here is local to the function. It does not interfere with any \
other x in the session, and it disappears once the function has been applied.
Several arguments are given as a list of names:\
\>", "Text",
 CellChangeTimes->{
  3.996560663720375*^9},ExpressionUUID->"97f8d18d-a53d-41c1-9f94-\
64e11d8aa550"],

Cell[CellGroupData[{

Cell["Function[{x, y}, x + y][2, 3]", "Input",
 CellLabel->"In[82]:=",ExpressionUUID->"e4592b50-cd98-4976-b429-a19b37dce241"],

Cell[BoxData["5"], "Output",
 CellChangeTimes->{3.996560655651268*^9},
 CellLabel->"Out[82]=",ExpressionUUID->"fd884a6d-aa55-47b4-b350-e1f834a2b215"]
}, Open  ]],

Cell["\<\
This form is worth knowing even though it is not the one most often written, \
because it is unambiguous. When pure functions are nested inside one another \
the explicit form is frequently the clearer choice.\
\>", "Text",ExpressionUUID->"5b5b451b-e945-4274-8d6f-767ff4dd0d6c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Shorthand Form", "Subsubsection",ExpressionUUID->"1109818e-9e52-4dd5-ae32-0c4accf9744d"],

Cell["\<\
The compact form leaves the argument unnamed. A # stands for the argument, \
and a trailing & marks where the function ends.\
\>", "Text",ExpressionUUID->"30b704cc-c4fa-4779-b16a-4e89f6a37408"],

Cell[CellGroupData[{

Cell["(# + 1 &)[5]", "Input",
 CellLabel->"In[83]:=",ExpressionUUID->"748b1827-5f4d-49aa-98bd-ad8f6e21c0b2"],

Cell[BoxData["6"], "Output",
 CellChangeTimes->{3.996560672852849*^9},
 CellLabel->"Out[83]=",ExpressionUUID->"1df7b7aa-8465-471b-903d-522d1a2a8382"]
}, Open  ]],

Cell["\<\
The two forms describe the same function, so # + 1 & and Function[x, x + 1] \
can be used interchangeably. The shorthand is shorter to write and is what \
almost all Wolfram Language code uses in practice.
Its natural home is as an argument to another function:\
\>", "Text",
 CellChangeTimes->{
  3.996560668944004*^9},ExpressionUUID->"195f286e-fc7c-4b3c-8fd3-\
73adfec1da02"],

Cell[CellGroupData[{

Cell["Map[#^2 &, {1, 2, 3, 4}]", "Input",
 CellLabel->"In[84]:=",ExpressionUUID->"51151d22-6daf-420f-8d13-9572da7271e5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "4", ",", "9", ",", "16"}], "}"}]], "Output",
 CellChangeTimes->{3.99656067538538*^9},
 CellLabel->"Out[84]=",ExpressionUUID->"40af8177-d6c1-4008-a89a-147bfa96a710"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Select[{1, 2, 3, 4, 5}, # > 2 &]", "Input",
 CellLabel->"In[85]:=",ExpressionUUID->"37d4ee03-5d3e-4619-921d-0e3771719e2d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "4", ",", "5"}], "}"}]], "Output",
 CellChangeTimes->{3.996560677820496*^9},
 CellLabel->"Out[85]=",ExpressionUUID->"ababbad9-f080-4635-af9c-0dd2f5221ddd"]
}, Open  ]],

Cell["\<\
In both cases the function exists only for the duration of the call. There is \
nothing left behind afterwards, which is exactly what is wanted for a one-off \
operation.\
\>", "Text",ExpressionUUID->"3a03397b-1486-42b3-9620-cd668a4feba2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Several Arguments", "Subsubsection",ExpressionUUID->"5ff047c9-9679-46a7-9421-d94e245c8495"],

Cell["\<\
When a pure function takes more than one argument, they are written #1, #2 \
and so on. A plain # is the same as #1.\
\>", "Text",ExpressionUUID->"194d6b43-3baf-4896-95d2-0a25c076696c"],

Cell[CellGroupData[{

Cell["(#1 - #2 &)[10, 3]", "Input",
 CellLabel->"In[86]:=",ExpressionUUID->"a709753d-326e-4a62-8ada-f852e8fa256b"],

Cell[BoxData["7"], "Output",
 CellChangeTimes->{3.996560685539281*^9},
 CellLabel->"Out[86]=",ExpressionUUID->"15c98ddd-b40d-4afe-99c6-e12b6548b889"]
}, Open  ]],

Cell["\<\
This is what makes the shorthand usable with functions that hand over two \
arguments at a time, such as a sorting comparison:\
\>", "Text",ExpressionUUID->"b38c330b-4374-4267-baeb-470e8bf3fa73"],

Cell[CellGroupData[{

Cell["Sort[{3, 1, 2}, #1 > #2 &]", "Input",
 CellLabel->"In[87]:=",ExpressionUUID->"84a9ca13-bd5c-4e77-9ffb-b8392ec4acfb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "2", ",", "1"}], "}"}]], "Output",
 CellChangeTimes->{3.9965606872548037`*^9},
 CellLabel->"Out[87]=",ExpressionUUID->"b7ea7a3d-4770-49b2-ae61-18416b20da1e"]
}, Open  ]],

Cell["\<\
The comparison says the first argument should come before the second when it \
is larger, which produces a descending sort.
A double hash, ##, stands for all the arguments at once as a sequence rather \
than as a list:\
\>", "Text",
 CellChangeTimes->{
  3.996560693531259*^9},ExpressionUUID->"ab852156-f21a-43ba-9d57-\
b77430594940"],

Cell[CellGroupData[{

Cell["({##} &)[1, 2, 3]", "Input",
 CellLabel->"In[88]:=",ExpressionUUID->"8820db91-66de-4629-8145-0f4a89ff1960"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output",
 CellChangeTimes->{3.9965606897547703`*^9},
 CellLabel->"Out[88]=",ExpressionUUID->"28402286-2d51-48c5-bb23-15c30730b255"]
}, Open  ]],

Cell[CellGroupData[{

Cell["(Plus[##] &)[1, 2, 3]", "Input",
 CellLabel->"In[89]:=",ExpressionUUID->"e544904c-9922-4ebc-a39a-05c5baf87881"],

Cell[BoxData["6"], "Output",
 CellChangeTimes->{3.996560692336038*^9},
 CellLabel->"Out[89]=",ExpressionUUID->"6a1935d8-3a13-497d-9d28-30aa9edbb4bf"]
}, Open  ]],

Cell["\<\
Wrapping ## in braces collected the arguments into a list; handing it \
straight to Plus added them. A sequence is not a list, and the difference is \
exactly this: a sequence merges into whatever encloses it.\
\>", "Text",ExpressionUUID->"a2fec5d2-bc97-460f-b433-df99eaabcec1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Precedence", "Subsubsection",
 CellChangeTimes->{{3.9965607030438137`*^9, 
  3.9965607150295773`*^9}},ExpressionUUID->"8366dc07-47ac-478c-b250-\
99a2c763e63a"],

Cell["\<\
The & has very low precedence, which means it swallows as much of the \
expression to its left as it can. That is usually convenient, because it \
removes the need for brackets around the body.\
\>", "Text",ExpressionUUID->"76eb4f9a-a49e-412b-be53-bf2dc2349eda"],

Cell[CellGroupData[{

Cell["Map[#^2 + 1 &, {1, 2, 3}]", "Input",
 CellLabel->"In[90]:=",ExpressionUUID->"0d5c13ca-b44e-4c66-a0d5-677233b2c9c5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "5", ",", "10"}], "}"}]], "Output",
 CellChangeTimes->{3.996560718872139*^9},
 CellLabel->"Out[90]=",ExpressionUUID->"e2b71b66-f602-4bc7-88f0-fdf6bba1bef5"]
}, Open  ]],

Cell["\<\
The whole of #^2 + 1 became the body, with no brackets required. The problem \
appears when a pure function is applied directly to an argument, because the \
square brackets bind more tightly than the &.\
\>", "Text",ExpressionUUID->"cd524814-4b40-44d9-b542-1cd5d1ac10b4"],

Cell["\<\
Always bracket the function itself when applying it directly:\
\>", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"ef442e03-f373-4da4-9bd0-c3193295b8ce"],

Cell[CellGroupData[{

Cell["(#^2 &)[5]", "Input",
 CellLabel->"In[91]:=",ExpressionUUID->"b23b760c-d57a-41f5-aa1f-0ca76344aef0"],

Cell[BoxData["25"], "Output",
 CellChangeTimes->{3.996560721105769*^9},
 CellLabel->"Out[91]=",ExpressionUUID->"86e03aa9-6dac-47d8-9cf1-e6528c84f137"]
}, Open  ]],

Cell["\<\
Written without those brackets, the argument attaches to the wrong part of \
the expression and the result is not a function application at all. Inside \
Map, Select and similar functions the question does not arise, because the \
comma already marks where the function ends.\
\>", "Text",ExpressionUUID->"0a2c775a-378b-4090-9bdc-8177c9f6beb5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Nesting", "Subsubsection",ExpressionUUID->"e1229b86-2a6d-4f16-8a18-38440e78f26b"],

Cell["\<\
A # always belongs to the innermost & that encloses it. When one pure \
function sits inside another, the outer argument becomes unreachable from the \
inner body.\
\>", "Text",ExpressionUUID->"ab807af6-3b58-44ea-bec1-cfe5dfb5ab07"],

Cell["\<\
Here the inner # refers to the inner function, so each row is doubled \
correctly:\
\>", "Text",ExpressionUUID->"bd3315f9-98da-4c64-b1d5-2f2546b9afb1"],

Cell[CellGroupData[{

Cell["Map[Map[#*2 &, #] &, {{1, 2}, {3, 4}}]", "Input",
 CellLabel->"In[92]:=",ExpressionUUID->"fa50cbdc-1568-4934-8e07-b417d6337ed3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"6", ",", "8"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.996560723636899*^9},
 CellLabel->"Out[92]=",ExpressionUUID->"83b9e297-551e-48c1-9bad-49b552fa04d2"]
}, Open  ]],

Cell["\<\
That worked, but only because the outer # was needed in a position outside \
the inner &. As soon as both arguments are needed in the same place, the \
shorthand cannot express it, and the explicit form is required:\
\>", "Text",ExpressionUUID->"0962e9d7-7065-4b44-8820-21fabdef644e"],

Cell[CellGroupData[{

Cell["\<\
Map[Function[row, Map[row[[1]] + # &, row]], {{10, 1}, {20, 2}}]\
\>", "Input",
 CellLabel->"In[93]:=",ExpressionUUID->"e894b936-b70c-4d8f-9f1e-592df75c9b3d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"20", ",", "11"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"40", ",", "22"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.996560725439097*^9},
 CellLabel->"Out[93]=",ExpressionUUID->"03cebcb8-c0fc-4284-a465-bf24f60297ad"]
}, Open  ]],

Cell["\<\
Naming the outer argument row makes it available inside the inner function, \
which no arrangement of # could have achieved. This is the main practical \
reason to keep the explicit Function form in mind.\
\>", "Text",ExpressionUUID->"8c35ba36-b1d2-40c5-b30a-5d714cdeab2f"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Scoping", "Section",ExpressionUUID->"986d35ee-9653-4fa6-8d7d-f90aa0e88e1c"],

Cell["\<\
Scoping is about controlling where a name is visible. Without it, every \
variable in a session shares one namespace, and a function that uses a \
variable called i can be broken by unrelated code somewhere else that also \
uses i. The Wolfram Language provides three scoping constructs, and they do \
genuinely different things rather than being three styles of the same idea. \
Module creates new private symbols, Block temporarily changes the value of an \
existing symbol, and With substitutes a value in before evaluation begins.\
\>", "Text",
 CellChangeTimes->{{3.99656081331669*^9, 3.996560815108033*^9}, {
  3.996560848033925*^9, 
  3.996560848932579*^9}},ExpressionUUID->"92fbe3fe-7bad-4163-bf4a-\
9e06a09a5f5a"],

Cell[CellGroupData[{

Cell["Module", "Subsubsection",ExpressionUUID->"bf3d7018-1368-4a60-a181-547ffaab8e0d"],

Cell["\<\
Module takes a list of local variables and a body. The variables exist only \
while the body is running, and they may be given initial values.\
\>", "Text",ExpressionUUID->"468d6dc5-a004-495d-9ffe-86a3ec5e507d"],

Cell[CellGroupData[{

Cell["Module[{x = 5}, x^2]", "Input",
 CellLabel->"In[94]:=",ExpressionUUID->"f0af30b2-f3c4-4f5f-bf8b-fb64022696cc"],

Cell[BoxData["25"], "Output",
 CellChangeTimes->{3.996560855868683*^9},
 CellLabel->"Out[94]=",ExpressionUUID->"2e969907-333d-4940-b272-74e8b0ef22be"]
}, Open  ]],

Cell["\<\
The value of a Module is the value of the last expression in its body, so \
several statements can be separated by semicolons and only the final one is \
returned:\
\>", "Text",ExpressionUUID->"9072cf6f-0f1c-444b-b897-c79d5db1bc42"],

Cell[CellGroupData[{

Cell["Module[{a = 2, b = 3}, a = a + b; a*10]", "Input",
 CellLabel->"In[95]:=",ExpressionUUID->"131c4eb9-907c-4841-a7e4-8340f3a4761f"],

Cell[BoxData["50"], "Output",
 CellChangeTimes->{3.996560857768417*^9},
 CellLabel->"Out[95]=",ExpressionUUID->"c4fc75af-86e6-4b5f-afb9-cbd24fd048b4"]
}, Open  ]],

Cell["\<\
A local variable does not disturb a global one of the same name. Setting a \
global x, then using x inside a Module, leaves the global untouched:\
\>", "Text",ExpressionUUID->"b23cec4a-a191-4b9a-99a2-77f5b042e14a"],

Cell[CellGroupData[{

Cell["\<\
x = 100;
Module[{x = 5}, x]\
\>", "Input",
 CellLabel->"In[96]:=",ExpressionUUID->"d047ec04-e910-4afa-b78d-3b90737af3fa"],

Cell[BoxData["5"], "Output",
 CellChangeTimes->{3.996560859619445*^9},
 CellLabel->"Out[97]=",ExpressionUUID->"aef27720-0e60-4245-ac04-5a9ba3c8edc1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["x", "Input",
 CellLabel->"In[98]:=",ExpressionUUID->"0ffd6556-a70c-4262-ab9b-1d636a3064c5"],

Cell[BoxData["100"], "Output",
 CellChangeTimes->{3.996560862337895*^9},
 CellLabel->"Out[98]=",ExpressionUUID->"7b4222f3-e963-4c0f-94fd-4456dfe33464"]
}, Open  ]],

Cell["\<\
The mechanism behind this is worth seeing, because it explains behaviour that \
would otherwise look strange. Module does not hide the name; it creates a new \
symbol with a different name.\
\>", "Text",ExpressionUUID->"145111d5-19d2-4c40-a006-329369451b59"],

Cell[CellGroupData[{

Cell["Module[{y}, Hold[y]]", "Input",
 CellLabel->"In[99]:=",ExpressionUUID->"1e4dac57-f1b5-47ee-98df-09ced0a70edb"],

Cell[BoxData[
 RowBox[{"Hold", "[", "y$36921", "]"}]], "Output",
 CellChangeTimes->{3.996560864420126*^9},
 CellLabel->"Out[99]=",ExpressionUUID->"637e530c-05bb-477d-9e92-5077dbd0f2da"]
}, Open  ]],

Cell["\<\
The result contains something like y$1234 rather than y. Each evaluation of \
the Module produces a fresh symbol, which is exactly why two calls cannot \
interfere with one another.\
\>", "Text",ExpressionUUID->"8a269a8e-2367-4e85-a3aa-14365da4c4bd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["With", "Subsubsection",ExpressionUUID->"9c60a66d-98f1-46cb-9eb5-0cf842d204bd"],

Cell["\<\
With also introduces local names, but it does not create variables at all. It \
substitutes the values into the body first, and only then evaluates.\
\>", "Text",ExpressionUUID->"eecbf747-00d0-40b5-8155-bd925e800909"],

Cell[CellGroupData[{

Cell["With[{a = 3}, a + 1]", "Input",
 CellLabel->
  "In[100]:=",ExpressionUUID->"5dac4d52-5d44-4043-820c-d3e8d4460c40"],

Cell[BoxData["4"], "Output",
 CellChangeTimes->{3.996560867602289*^9},
 CellLabel->
  "Out[100]=",ExpressionUUID->"36bee410-e370-4792-abee-3e8c2b5c7081"]
}, Open  ]],

Cell["\<\
The difference from Module shows when the body is held rather than evaluated. \
Module leaves a symbol behind; With has already replaced it with the value.\
\>", "Text",ExpressionUUID->"5b56ccf1-4d54-4aaa-9b85-64c3d9374062"],

Cell[CellGroupData[{

Cell["With[{a = 3}, Hold[a]]", "Input",
 CellLabel->
  "In[101]:=",ExpressionUUID->"aa53b2b7-77bc-40a1-8ce3-9184308029d5"],

Cell[BoxData[
 RowBox[{"Hold", "[", "3", "]"}]], "Output",
 CellChangeTimes->{3.9965608692171097`*^9},
 CellLabel->
  "Out[101]=",ExpressionUUID->"a7d12173-e7d3-4600-98fb-9a5359934d3a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Module[{a = 3}, Hold[a]]", "Input",
 CellLabel->
  "In[102]:=",ExpressionUUID->"cfaff974-9b96-4edf-b4ec-520e1c13f38b"],

Cell[BoxData[
 RowBox[{"Hold", "[", "a$36931", "]"}]], "Output",
 CellChangeTimes->{3.996560871418005*^9},
 CellLabel->
  "Out[102]=",ExpressionUUID->"8c7c93fd-3d73-460c-a8cb-587f3b687e61"]
}, Open  ]],

Cell["\<\
Because With performs a substitution, its names are constants. They cannot be \
reassigned inside the body, and that restriction is a feature: it makes the \
value obvious at a glance.

One consequence catches people out. The assignments in a single With are \
carried out together, not one after another, so a later one cannot refer to \
an earlier one:\
\>", "Text",ExpressionUUID->"73950058-9a38-4c8a-af35-6f2a5a1482b1"],

Cell[CellGroupData[{

Cell["\<\
Clear[a];
With[{a = 1, b = a + 1}, b]\
\>", "Input",
 CellLabel->
  "In[103]:=",ExpressionUUID->"10187b91-af6d-4009-a77b-f68eac07734d"],

Cell[BoxData[
 RowBox[{"1", "+", "a"}]], "Output",
 CellChangeTimes->{3.996560873768188*^9},
 CellLabel->
  "Out[104]=",ExpressionUUID->"8ccab858-1b07-4099-8627-9e08e511267e"]
}, Open  ]],

Cell["\<\
The result is 1 + a rather than 2, because a had not been substituted at the \
point where b was defined. Nesting the constructs fixes it, since the inner \
With sees the substitution the outer one has already made:\
\>", "Text",ExpressionUUID->"f54191dc-a98d-4607-9e49-c16d75ecb56c"],

Cell[CellGroupData[{

Cell["With[{a = 1}, With[{b = a + 1}, b]]", "Input",
 CellLabel->
  "In[105]:=",ExpressionUUID->"dc02b525-4052-4345-b0c9-7b7590b8ba28"],

Cell[BoxData["2"], "Output",
 CellChangeTimes->{3.9965608763026943`*^9},
 CellLabel->
  "Out[105]=",ExpressionUUID->"b9e9739e-8ed4-4856-b424-cd3bec581cca"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Block", "Subsubsection",ExpressionUUID->"45c4c46a-427b-4d59-b348-e4e87643f185"],

Cell["\<\
Block looks similar but works on a different principle. It does not create a \
new symbol. It takes the existing symbol, sets its value aside, gives it a \
temporary value for the duration of the body, and restores the old value \
afterwards.\
\>", "Text",ExpressionUUID->"42371a45-db31-4182-82c3-8e7d11bb6081"],

Cell[CellGroupData[{

Cell["\<\
x = 100;
Block[{x = 5}, x]\
\>", "Input",
 CellLabel->
  "In[106]:=",ExpressionUUID->"61d3c7c3-703d-4ef7-83e7-0764de96f9e0"],

Cell[BoxData["5"], "Output",
 CellChangeTimes->{3.996560879002038*^9},
 CellLabel->
  "Out[107]=",ExpressionUUID->"2d8f0afa-9d2f-45ac-8516-2eafda685f70"]
}, Open  ]],

Cell[CellGroupData[{

Cell["x", "Input",
 CellLabel->
  "In[108]:=",ExpressionUUID->"835877ca-db01-4efd-b649-0369bbc8edc2"],

Cell[BoxData["100"], "Output",
 CellChangeTimes->{3.996560921936882*^9},
 CellLabel->
  "Out[108]=",ExpressionUUID->"5737e30f-0aea-4e98-8f02-4c5c9377a391"]
}, Open  ]],

Cell["\<\
From the outside this is indistinguishable from Module. The difference \
appears as soon as the body calls a function that refers to the same symbol \
by name.\
\>", "Text",ExpressionUUID->"b59a2a99-b36e-4468-a65e-d082b3fa0f57"],

Cell["\<\
A function that reads a global symbol, and a global value for it:\
\>", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"8aa73ea2-f266-4b8a-9127-d541923fd213"],

Cell["\<\
Clear[g, v];
g[] := v;
v = 1;\
\>", "Input",
 CellLabel->
  "In[109]:=",ExpressionUUID->"5da7c524-1633-4358-93e2-1a263e91f9d3"],

Cell["\<\
Module renames its own variable, so the v inside g is still the global one:\
\>", "Text",ExpressionUUID->"fd6e1067-3bb6-40e2-8a51-4630b0d78d8b"],

Cell[CellGroupData[{

Cell["Module[{v = 2}, g[]]", "Input",
 CellLabel->
  "In[112]:=",ExpressionUUID->"22aa5053-b38a-4e8d-94e6-94a28fd2cbbe"],

Cell[BoxData["1"], "Output",
 CellChangeTimes->{3.9965609408545437`*^9},
 CellLabel->
  "Out[112]=",ExpressionUUID->"000c10dd-5fe2-4bb9-a573-c356c367b8c6"]
}, Open  ]],

Cell["\<\
Block changes the global symbol itself for the duration, so g sees the \
temporary value:\
\>", "Text",ExpressionUUID->"125c7489-cca1-4cd4-a65e-030f50d09fca"],

Cell[CellGroupData[{

Cell["Block[{v = 2}, g[]]", "Input",
 CellLabel->
  "In[113]:=",ExpressionUUID->"5415bad6-233b-4afa-a4ed-62de1ed033a8"],

Cell[BoxData["2"], "Output",
 CellChangeTimes->{3.996560943021768*^9},
 CellLabel->
  "Out[113]=",ExpressionUUID->"a5acf187-5ae5-4fe4-8073-0a84f9968b3b"]
}, Open  ]]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Apply and Map", "Section",ExpressionUUID->"a5e2f103-1baf-49b4-967a-e0c9d07230b7"],

Cell["\<\
Map and Apply are the two central tools of functional programming in the \
Wolfram Language, and the difference between them is easiest to state in \
terms of the head[...] form.
Map leaves the head alone and works on the elements: it replaces each element \
by the result of applying a function to it. Apply leaves the elements alone \
and replaces the head itself.
Almost every loop that would be written in another language is written in the \
Wolfram Language with one of these two, or with a function built on them.\
\>", "Text",
 CellChangeTimes->{{3.996561184046517*^9, 
  3.996561189414713*^9}},ExpressionUUID->"774273d3-36ea-432b-97c2-\
0b1509272eba"],

Cell[CellGroupData[{

Cell["Map", "Subsubsection",ExpressionUUID->"fa3b8145-c164-4064-8ce1-44821baeeece"],

Cell["\<\
Map applies a function to each element of an expression and collects the \
results. Using an undefined symbol f as the function makes the structure of \
the result visible.\
\>", "Text",ExpressionUUID->"f4eb2943-cf09-466f-97ab-5c23a8c76ad1"],

Cell[CellGroupData[{

Cell["Map[fit, {1, 2, 3}]", "Input",
 CellChangeTimes->{{3.996561212887412*^9, 3.996561214452664*^9}},
 CellLabel->
  "In[140]:=",ExpressionUUID->"202be0f1-ee24-47f4-9e7f-1dffde01de28"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"fit", "[", "1", "]"}], ",", 
   RowBox[{"fit", "[", "2", "]"}], ",", 
   RowBox[{"fit", "[", "3", "]"}]}], "}"}]], "Output",
 CellChangeTimes->{{3.996561197193551*^9, 3.996561215799161*^9}},
 CellLabel->
  "Out[140]=",ExpressionUUID->"282e0a74-f116-4560-8c62-dfde6e660bb6"]
}, Open  ]],

Cell["\<\
Each element was wrapped in f, and the List head was left in place. The \
shorthand /@ means the same thing and is what most code uses:\
\>", "Text",ExpressionUUID->"d1b5b560-9f3e-44fd-bda6-1a44742ecc5a"],

Cell[CellGroupData[{

Cell["fit /@ {1, 2, 3}", "Input",
 CellChangeTimes->{{3.9965612210305653`*^9, 3.9965612211048117`*^9}},
 CellLabel->
  "In[142]:=",ExpressionUUID->"cc37569d-9ed5-416b-b9e8-e2bb26598371"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"fit", "[", "1", "]"}], ",", 
   RowBox[{"fit", "[", "2", "]"}], ",", 
   RowBox[{"fit", "[", "3", "]"}]}], "}"}]], "Output",
 CellChangeTimes->{{3.996561218542323*^9, 3.996561222365809*^9}},
 CellLabel->
  "Out[142]=",ExpressionUUID->"107425f8-c585-4316-ac41-28610ea73cf8"]
}, Open  ]],

Cell["\<\
With a function that actually computes something, the result is the \
transformed list:\
\>", "Text",ExpressionUUID->"1d4c59a0-e22f-44a9-a6e9-3486a6e2ba2e"],

Cell[CellGroupData[{

Cell["Map[#^2 &, {1, 2, 3, 4}]", "Input",
 CellLabel->
  "In[143]:=",ExpressionUUID->"b89e1495-ab03-4793-95f2-ac89d559ab62"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "4", ",", "9", ",", "16"}], "}"}]], "Output",
 CellChangeTimes->{3.996561224899577*^9},
 CellLabel->
  "Out[143]=",ExpressionUUID->"59958bcc-de0f-4943-abaa-cfcc63005a7d"]
}, Open  ]],

Cell["\<\
Because everything is an expression, Map is not restricted to lists. It works \
on any head at all, and preserves whatever that head was:\
\>", "Text",ExpressionUUID->"96cbadf4-17ef-45e5-bce2-d6159a88b5d2"],

Cell[CellGroupData[{

Cell["Map[fit, g[1, 2, 3]]", "Input",
 CellChangeTimes->{{3.996561231228195*^9, 3.996561232486985*^9}},
 CellLabel->
  "In[145]:=",ExpressionUUID->"532d018f-13dc-481d-8808-d94210e0f651"],

Cell[BoxData[
 RowBox[{"g", "[", 
  RowBox[{
   RowBox[{"fit", "[", "1", "]"}], ",", 
   RowBox[{"fit", "[", "2", "]"}], ",", 
   RowBox[{"fit", "[", "3", "]"}]}], "]"}]], "Output",
 CellChangeTimes->{{3.99656122726061*^9, 3.9965612343681593`*^9}},
 CellLabel->
  "Out[145]=",ExpressionUUID->"9ac17fe7-ec11-4be2-a923-abef799b3c09"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Apply", "Subsubsection",ExpressionUUID->"8e996753-c30b-4f74-9ad3-93f6a640aa58"],

Cell["\<\
Apply replaces the head of an expression with a new one, leaving the elements \
untouched.\
\>", "Text",ExpressionUUID->"ce6c9d31-aa39-42f0-a451-6fe4a12f592b"],

Cell[CellGroupData[{

Cell["Apply[f, {1, 2, 3}]", "Input",
 CellLabel->
  "In[146]:=",ExpressionUUID->"87ee7161-6e73-4484-b5f9-5901da04ea92"],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"1", ",", "2", ",", "3"}], "]"}]], "Output",
 CellChangeTimes->{3.996561240451193*^9},
 CellLabel->
  "Out[146]=",ExpressionUUID->"d2f7eebf-7e41-461e-850b-22cdf5aecfb2"]
}, Open  ]],

Cell["\<\
The List head became f, so what was a list of three elements is now a call to \
f with three arguments. The shorthand is @@:\
\>", "Text",ExpressionUUID->"caacc3ec-6a33-4190-ad78-e58a99e32d1f"],

Cell[CellGroupData[{

Cell["f @@ {1, 2, 3}", "Input",
 CellLabel->
  "In[147]:=",ExpressionUUID->"d9e00d0a-9312-4b8f-a77b-0eb559c0ddfe"],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"1", ",", "2", ",", "3"}], "]"}]], "Output",
 CellChangeTimes->{3.9965612427201138`*^9},
 CellLabel->
  "Out[147]=",ExpressionUUID->"bc213bb5-fdb6-44c2-b354-f94ec105319f"]
}, Open  ]],

Cell["\<\
This is what makes Apply so useful in practice. A list of numbers becomes a \
sum simply by changing its head to Plus:\
\>", "Text",ExpressionUUID->"baa607c4-b8fe-4ba5-8bb4-33e2da6c2337"],

Cell[CellGroupData[{

Cell["Plus @@ {1, 2, 3, 4}", "Input",
 CellLabel->
  "In[148]:=",ExpressionUUID->"248dea16-18c3-4b43-9bea-98def58a3e85"],

Cell[BoxData["10"], "Output",
 CellChangeTimes->{3.996561244968567*^9},
 CellLabel->
  "Out[148]=",ExpressionUUID->"0e1ce43e-7694-487b-860e-f51d4589fe96"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Times @@ {1, 2, 3, 4}", "Input",
 CellLabel->
  "In[149]:=",ExpressionUUID->"dfbeb969-3140-497f-9cce-2a84f016bdf8"],

Cell[BoxData["24"], "Output",
 CellChangeTimes->{3.9965612469496717`*^9},
 CellLabel->
  "Out[149]=",ExpressionUUID->"e236e7a3-8c54-42c3-8558-d113b7be6a3e"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Mapping Over Several Lists", "Subsubsection",ExpressionUUID->"2b8ab6b8-7884-40b4-943a-31d128705316"],

Cell["\<\
Map handles one list at a time. When elements from two lists need to be \
combined in parallel, MapThread is the tool: it takes a function and a list \
of lists, and calls the function once with the first element of each, then \
once with the second element of each, and so on.\
\>", "Text",ExpressionUUID->"741f517f-83a9-4c96-a4f9-c28c3c550e1a"],

Cell[CellGroupData[{

Cell["MapThread[f, {{1, 2, 3}, {10, 20, 30}}]", "Input",
 CellLabel->
  "In[150]:=",ExpressionUUID->"107ff691-30a1-430e-a514-f93a68d76809"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"1", ",", "10"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"2", ",", "20"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"3", ",", "30"}], "]"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9965612806004066`*^9},
 CellLabel->
  "Out[150]=",ExpressionUUID->"3c1a7989-939e-415a-889a-f1039dd507d7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["MapThread[Plus, {{1, 2, 3}, {10, 20, 30}}]", "Input",
 CellLabel->
  "In[151]:=",ExpressionUUID->"c5668449-c9a3-4fd7-b4e1-88c74933a489"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"11", ",", "22", ",", "33"}], "}"}]], "Output",
 CellChangeTimes->{3.996561282169162*^9},
 CellLabel->
  "Out[151]=",ExpressionUUID->"c2b3685c-1f5f-455a-834d-94af5ba4c15f"]
}, Open  ]],

Cell["\<\
The lists must be the same length. MapThread reports an error rather than \
guessing if they are not, which is the desired behaviour when mismatched data \
would otherwise pass silently.
MapIndexed is the variant that also supplies the position of each element. \
The position arrives as a list, matching the convention used by Position:\
\>", "Text",
 CellChangeTimes->{
  3.996561283944031*^9},ExpressionUUID->"d67b9688-868e-4af0-96c1-\
c2e9cbe48132"],

Cell["MapIndexed[f, {a, b, c}]", "Input",
 CellLabel->
  "In[152]:=",ExpressionUUID->"04d62cd4-a2cb-4af4-89ec-c697e62079df"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"fit", "[", 
    RowBox[{"a", ",", 
     RowBox[{"{", "1", "}"}]}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"b", ",", 
     RowBox[{"{", "2", "}"}]}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"c", ",", 
     RowBox[{"{", "3", "}"}]}], "]"}]}], "}"}]], "Input",
 CellChangeTimes->{{3.996561293974387*^9, 3.996561294053864*^9}},
 CellLabel->
  "In[154]:=",ExpressionUUID->"f936e828-ee28-4b6b-a28d-61e4d62e4bed"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"fit", "[", 
    RowBox[{"a", ",", 
     RowBox[{"{", "1", "}"}]}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"b", ",", 
     RowBox[{"{", "2", "}"}]}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"c", ",", 
     RowBox[{"{", "3", "}"}]}], "]"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9965612960007477`*^9},
 CellLabel->
  "Out[154]=",ExpressionUUID->"3be446a7-2207-484e-9ffe-85ddb742b863"]
}, Open  ]],

Cell["\<\
MapAt goes the other way, applying a function at one position only and \
leaving everything else alone:\
\>", "Text",ExpressionUUID->"959f83fc-d8be-4207-aa85-fa3aec81f88c"],

Cell[CellGroupData[{

Cell["MapAt[fit, {a, b, c}, 2]", "Input",
 CellChangeTimes->{{3.996561290560128*^9, 3.996561291626441*^9}},
 CellLabel->
  "In[155]:=",ExpressionUUID->"874d6b43-1692-4def-8108-c9b3489e8739"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"a", ",", 
   RowBox[{"fit", "[", "b", "]"}], ",", "c"}], "}"}]], "Output",
 CellChangeTimes->{{3.996561287371469*^9, 3.996561298300812*^9}},
 CellLabel->
  "Out[155]=",ExpressionUUID->"5bc9b1e8-299e-42d1-8d9b-fc73494b3e3d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Example : Summing Without a Loop", "Subsubsection",
 CellChangeTimes->{
  3.996561304824211*^9},ExpressionUUID->"55e75757-02d4-4e11-b5fb-\
e89cf31a6690"],

Cell["\<\
This example builds up the standard functional replacement for a loop, one \
step at a time.\
\>", "Text",ExpressionUUID->"3a76d799-9f4e-4fa6-af60-75b10a922f2e"],

Cell["Some values:", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"9a35f2e7-a322-4fa5-b94a-14914dee91e3"],

Cell["vals = {3, 1, 4, 1, 5};", "Input",
 CellLabel->
  "In[157]:=",ExpressionUUID->"1690bb62-bafe-4712-97d8-5e4eec29171a"],

Cell["Square each one with Map:", "Text",ExpressionUUID->"94da0090-9735-48c1-8b09-f17600c32b1c"],

Cell[CellGroupData[{

Cell["Map[#^2 &, vals]", "Input",
 CellLabel->
  "In[158]:=",ExpressionUUID->"d5aa5ea2-596f-41a7-baac-2fa7a24acf15"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"9", ",", "1", ",", "16", ",", "1", ",", "25"}], "}"}]], "Output",
 CellChangeTimes->{3.996561318899788*^9},
 CellLabel->
  "Out[158]=",ExpressionUUID->"8cf58f2e-8eef-44ec-8e6e-510684bfee9a"]
}, Open  ]],

Cell["Turn the resulting list into a sum with Apply:", "Text",ExpressionUUID->"0f682280-708d-434b-8e69-6d5f4bb294a7"],

Cell[CellGroupData[{

Cell["Plus @@ Map[#^2 &, vals]", "Input",
 CellLabel->
  "In[159]:=",ExpressionUUID->"89545101-19a7-47e1-9280-cf62c1c6ba46"],

Cell[BoxData["52"], "Output",
 CellChangeTimes->{3.996561321080295*^9},
 CellLabel->
  "Out[159]=",ExpressionUUID->"a8cdc8ac-23ea-4f0d-9468-ab7c9112e2fe"]
}, Open  ]],

Cell["\<\
The whole calculation is one expression with no loop, no counter and no \
accumulator. Read from the inside out it says: square each value, then add \
the results.

The same result written with the shorthands is how this is usually seen in \
practice:\
\>", "Text",ExpressionUUID->"cabae816-5dcc-4d8a-b6d3-314d0f3ad5a7"],

Cell[CellGroupData[{

Cell["Plus @@ (#^2 & /@ vals)", "Input",
 CellLabel->
  "In[160]:=",ExpressionUUID->"ccd41708-44e6-4dc2-98be-675edf062d93"],

Cell[BoxData["52"], "Output",
 CellChangeTimes->{3.996561324086904*^9},
 CellLabel->
  "Out[160]=",ExpressionUUID->"951923d4-f9a7-411a-bdcd-4db345cc6e3b"]
}, Open  ]]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Threading", "Section",ExpressionUUID->"24032c45-9149-432f-9b31-233a2bab3832"],

Cell["\<\
Threading is the automatic application of a function across the elements of \
one or more lists, without writing an explicit loop or Map. In the Wolfram \
Language, this happens on its own for a large number of built-in functions, \
because of an attribute they carry called Listable.
This explains behavior that would otherwise look like a special case for \
lists. Plus, Times and most standard mathematical functions all thread \
automatically, which is why {1, 2, 3} + {10, 20, 30} works without Map or any \
other visible mechanism.\
\>", "Text",
 CellChangeTimes->{{3.996561344412724*^9, 3.996561347487574*^9}, {
  3.9965614044416313`*^9, 
  3.996561430855647*^9}},ExpressionUUID->"abe2a4ef-7e2f-4958-844e-\
25ca179554ee"],

Cell[CellGroupData[{

Cell["The Listable Attribute", "Subsubsection",ExpressionUUID->"4a1d0425-0e64-4ce2-a3d4-d9bd3131e751"],

Cell["\<\
A function with the Listable attribute automatically distributes itself over \
the elements of a list argument, applying itself to each element in turn.\
\>", "Text",ExpressionUUID->"6e8a9ccf-b2d5-4207-958e-087e748e7ddf"],

Cell[CellGroupData[{

Cell["{1, 2, 3} + {10, 20, 30}", "Input",
 CellLabel->
  "In[161]:=",ExpressionUUID->"6cd449d9-05c8-4062-b7e0-b469c5b6e4e8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"11", ",", "22", ",", "33"}], "}"}]], "Output",
 CellChangeTimes->{3.996561435963236*^9},
 CellLabel->
  "Out[161]=",ExpressionUUID->"2957ee7f-03b6-43b2-ad98-7dfb7a045caa"]
}, Open  ]],

Cell["\<\
No Map was written. Plus simply threaded itself across both lists, adding \
corresponding elements. Attributes can be inspected directly, which confirms \
this is a property of the function rather than special syntax:\
\>", "Text",ExpressionUUID->"ea1ee0d0-4422-4679-8308-4193958bfe12"],

Cell[CellGroupData[{

Cell["Attributes[Plus]", "Input",
 CellLabel->
  "In[162]:=",ExpressionUUID->"ce6970b6-00c4-4bee-829c-70a2a3a8d056"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "Flat", ",", "Listable", ",", "NumericFunction", ",", "OneIdentity", ",", 
   "Orderless", ",", "Protected"}], "}"}]], "Output",
 CellChangeTimes->{3.9965614391356792`*^9},
 CellLabel->
  "Out[162]=",ExpressionUUID->"586e66eb-4463-4bb2-b489-6363470213b7"]
}, Open  ]],

Cell["\<\
Sqrt is Listable too, so it threads over a list argument the same way:\
\>", "Text",ExpressionUUID->"996d52df-9f87-436e-a44a-6404b0269fa1"],

Cell[CellGroupData[{

Cell["Sqrt[{1, 4, 9, 16}]", "Input",
 CellLabel->
  "In[163]:=",ExpressionUUID->"b25a0c13-fb45-46b4-83e0-1b2077223c5d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}]], "Output",
 CellChangeTimes->{3.996561441483921*^9},
 CellLabel->
  "Out[163]=",ExpressionUUID->"f3760205-9fd6-4fe8-81c9-5f424ca80223"]
}, Open  ]],

Cell["\<\
This is worth contrasting with an ordinary, non-Listable function, where \
nothing threads and the list is simply the single argument received:\
\>", "Text",ExpressionUUID->"ac053845-fac6-4862-a427-4a7e3028bfc3"],

Cell[CellGroupData[{

Cell["Length[{1, 2, 3}]", "Input",
 CellLabel->
  "In[164]:=",ExpressionUUID->"ecccc65e-73fe-4098-85c7-b886b31736cf"],

Cell[BoxData["3"], "Output",
 CellChangeTimes->{3.996561443702406*^9},
 CellLabel->
  "Out[164]=",ExpressionUUID->"623d6d5e-4e35-402f-9740-2d0f3a9fb71d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Threading Over Several Lists", "Subsubsection",ExpressionUUID->"f6f07336-ebef-4628-899c-fca01c9369f6"],

Cell["\<\
When a Listable function receives more than one list argument, it combines \
them position by position: the first elements together, then the second \
elements, and so on.\
\>", "Text",ExpressionUUID->"6ae74926-2783-4dd6-aac1-a868ac890e8b"],

Cell[CellGroupData[{

Cell["{1, 2, 3}*{10, 20, 30}", "Input",
 CellLabel->
  "In[165]:=",ExpressionUUID->"aa0752a7-fd61-4ec6-a6be-555c4ee226c7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"10", ",", "40", ",", "90"}], "}"}]], "Output",
 CellChangeTimes->{3.9965614459855127`*^9},
 CellLabel->
  "Out[165]=",ExpressionUUID->"85714ecf-26f2-4c4f-b866-b2d8d4f8d8fb"]
}, Open  ]],

Cell["\<\
This is exactly what makes elementwise arithmetic on lists feel native, with \
no explicit pairing step required. The same threading applies to comparison \
operators such as Equal and Less, which are also Listable:\
\>", "Text",ExpressionUUID->"fad5cac9-787c-4264-aa1e-1ae04433a5a9"],

Cell[CellGroupData[{

Cell["{1, 5, 3} > {0, 6, 3}", "Input",
 CellLabel->
  "In[166]:=",ExpressionUUID->"ad3fd04e-1acf-4ad0-8f07-984330fd228b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"1", ",", "5", ",", "3"}], "}"}], ">", 
  RowBox[{"{", 
   RowBox[{"0", ",", "6", ",", "3"}], "}"}]}]], "Output",
 CellChangeTimes->{3.996561447652923*^9},
 CellLabel->
  "Out[166]=",ExpressionUUID->"4ff8fefd-b6c2-4606-a8ff-2c8b3428e664"]
}, Open  ]],

Cell["\<\
Each position was compared independently, giving one Boolean per position \
rather than a single overall answer.\
\>", "Text",ExpressionUUID->"a8942121-51cb-4b18-a9ab-67eeaa7f10d3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Scalar Broadcasting", "Subsubsection",ExpressionUUID->"ae2f8264-fdfc-4ab5-aa51-ee1f9ada08d7"],

Cell["\<\
When one argument is a list and the other is a single value, the single value \
is automatically combined with every element of the list. This is usually \
called broadcasting.\
\>", "Text",ExpressionUUID->"fd77819e-568f-45da-b36b-50180ee1b111"],

Cell[CellGroupData[{

Cell["{1, 2, 3} + 10", "Input",
 CellLabel->
  "In[167]:=",ExpressionUUID->"1e021b17-27a7-4f78-a19b-66fd1842ae60"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"11", ",", "12", ",", "13"}], "}"}]], "Output",
 CellChangeTimes->{3.9965614510339518`*^9},
 CellLabel->
  "Out[167]=",ExpressionUUID->"a5f5a88e-81aa-4ca5-af74-ec237836f534"]
}, Open  ]],

Cell["\<\
The 10 was not turned into a list by hand; Plus's Listable attribute handles \
a bare scalar as though it were repeated to match the list. The same applies \
to multiplication:\
\>", "Text",ExpressionUUID->"0b1df64d-8015-4234-bd8a-c255ce709458"],

Cell[CellGroupData[{

Cell["{1, 2, 3}*100", "Input",
 CellLabel->
  "In[168]:=",ExpressionUUID->"91be4630-cbbe-4fbe-a133-0e738276a986"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"100", ",", "200", ",", "300"}], "}"}]], "Output",
 CellChangeTimes->{3.996561453002171*^9},
 CellLabel->
  "Out[168]=",ExpressionUUID->"311c5272-cfc4-42bc-bda9-98b8343da6e5"]
}, Open  ]],

Cell["\<\
Broadcasting and multi-list threading are really the same mechanism. A scalar \
can be thought of as a list whose single value is reused at every position, \
which is why no special case is needed for it.\
\>", "Text",ExpressionUUID->"9d0337a8-5a57-475e-bad3-0bbd4de49ad9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Thread", "Subsubsection",ExpressionUUID->"0d123507-5777-403f-ae34-aefed36af4da"],

Cell["\<\
Thread is the explicit function version of this same mechanism. It is useful \
for a function that is not Listable, or when threading needs to be forced on \
demand rather than relied upon automatically.\
\>", "Text",ExpressionUUID->"cf3daca1-fd52-4434-bcda-a346cf2d9a16"],

Cell[CellGroupData[{

Cell["Thread[f[{1, 2, 3}, {10, 20, 30}]]", "Input",
 CellLabel->
  "In[169]:=",ExpressionUUID->"eaa1ef5a-7ccd-4e41-b96a-9aa59dbfb5aa"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"1", ",", "10"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"2", ",", "20"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"3", ",", "30"}], "]"}]}], "}"}]], "Output",
 CellChangeTimes->{3.996561456915371*^9},
 CellLabel->
  "Out[169]=",ExpressionUUID->"93e48732-c00d-4b40-b763-97dcbc230467"]
}, Open  ]],

Cell["\<\
Thread distributed f over the corresponding elements of both lists, producing \
the same shape of result a Listable function would have given directly. This \
is exactly how a comparison across two lists, without relying on Greater \
already being Listable, could be written explicitly:\
\>", "Text",ExpressionUUID->"be6a0646-ee58-4f4a-95c8-368168497169"],

Cell[CellGroupData[{

Cell["Thread[Greater[{1, 5, 3}, {0, 6, 3}]]", "Input",
 CellLabel->
  "In[170]:=",ExpressionUUID->"965af160-3871-4c7d-8db9-7a7ca2abe78c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "False"}], "}"}]], "Output",
 CellChangeTimes->{3.996561459067552*^9},
 CellLabel->
  "Out[170]=",ExpressionUUID->"b60676c6-3794-4f9e-bd4d-589fddd1efa2"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Example: Automatic Threading in Practice", "Subsubsection",
 CellChangeTimes->{{3.996561474471979*^9, 
  3.996561475638673*^9}},ExpressionUUID->"0a30bce2-f73e-4bac-ac69-\
c14a15324088"],

Cell["\<\
Elementwise arithmetic across parallel lists is one of the most common \
everyday uses of threading, and it needs no special syntax at all.\
\>", "Text",ExpressionUUID->"b033b853-9360-4431-8102-5eae36a80e44"],

Cell["Prices before and after a discount, held in parallel lists:", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"5bd447b7-7406-47d3-8724-3bf58db081c8"],

Cell["\<\
prices = {20, 50, 15, 80};
discounts = {2, 5, 0, 10};\
\>", "Input",
 CellLabel->
  "In[173]:=",ExpressionUUID->"09825937-4476-4a72-aa0d-99b15e39b745"],

Cell["The discounted prices, computed with no loop:", "Text",ExpressionUUID->"fc34cb00-0084-4fed-b484-392cc9d7b9da"],

Cell[CellGroupData[{

Cell["prices - discounts", "Input",
 CellLabel->
  "In[175]:=",ExpressionUUID->"833695f1-8338-46b6-82a8-3f72f02ba187"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"18", ",", "45", ",", "15", ",", "70"}], "}"}]], "Output",
 CellChangeTimes->{3.996561484466567*^9},
 CellLabel->
  "Out[175]=",ExpressionUUID->"166bf8f2-6096-464c-afb9-b1f138abb61b"]
}, Open  ]],

Cell["\<\
Because Plus and its relatives are Listable, this expression already means \
\"subtract corresponding elements\", exactly as it reads.\
\>", "Text",ExpressionUUID->"b221ea9a-cea0-4001-8f56-cecebe7c16cb"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["List Manipulation", "Section",ExpressionUUID->"2ddd920e-23f9-414f-a878-fb11dab3b637"],

Cell["\<\
Lists are the workhorse data structure of the Wolfram Language, and the \
library of functions for working with them is large enough that the real \
skill is choosing the right one rather than writing anything by hand.
Almost every operation described here could be written as a loop. The reason \
not to is not only brevity: the built-in functions say what is being done \
rather than how, which makes the intent of the code obvious and removes an \
entire category of off-by-one errors.\
\>", "Text",
 CellChangeTimes->{{3.996561497548292*^9, 
  3.996561501868353*^9}},ExpressionUUID->"fc330757-a8fa-4499-a40c-\
40f2a784a23c"],

Cell[CellGroupData[{

Cell["Selecting Elements", "Subsubsection",ExpressionUUID->"d6d7440f-d861-42b3-8df3-75745078b720"],

Cell["\<\
Select keeps the elements for which a test returns True. The test is an \
ordinary function, usually written as a pure function.\
\>", "Text",ExpressionUUID->"9c7079dd-7089-49b0-a0ea-bc0457926416"],

Cell[CellGroupData[{

Cell["Select[{1, 2, 3, 4, 5, 6}, EvenQ]", "Input",
 CellLabel->
  "In[176]:=",ExpressionUUID->"18467755-1a0f-4e96-ace5-f2cf3e14bae0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "4", ",", "6"}], "}"}]], "Output",
 CellChangeTimes->{3.996561508051841*^9},
 CellLabel->
  "Out[176]=",ExpressionUUID->"936abd48-a526-4e08-80d2-870e299c3e27"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Select[{1, 2, 3, 4, 5, 6}, # > 3 &]", "Input",
 CellLabel->
  "In[177]:=",ExpressionUUID->"1a0b9b47-aa4b-4988-b5f9-85ac858fb07f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"4", ",", "5", ",", "6"}], "}"}]], "Output",
 CellChangeTimes->{3.996561510181964*^9},
 CellLabel->
  "Out[177]=",ExpressionUUID->"a8fa4118-00e3-4086-9b6e-c4e665c82ca1"]
}, Open  ]],

Cell["\<\
Cases does something similar but selects by pattern rather than by test, \
which lets it filter on structure and type rather than on value.\
\>", "Text",ExpressionUUID->"7807bffa-4085-4e94-9816-c62ad6251b5f"],

Cell[CellGroupData[{

Cell["Cases[{1, \"a\", 2.5, 3, \"b\"}, _Integer]", "Input",
 CellLabel->
  "In[178]:=",ExpressionUUID->"9ca1dcd0-03e0-49b6-b491-8a229bcfca27"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "3"}], "}"}]], "Output",
 CellChangeTimes->{3.9965615120855103`*^9},
 CellLabel->
  "Out[178]=",ExpressionUUID->"86a5d941-09cb-43b0-bf77-9d70c379a13d"]
}, Open  ]],

Cell["\<\
Cases can also transform what it finds, by taking a rule instead of a bare \
pattern. This picks out the matching elements and rewrites them in one step:\
\>", "Text",ExpressionUUID->"607f1341-2c55-439e-a0ee-fa8be607d3b4"],

Cell[CellGroupData[{

Cell["Cases[{fit[1], git[2], fit[3]}, fit[x_] :> x]", "Input",
 CellChangeTimes->{{3.996561517796865*^9, 3.9965615231875057`*^9}},
 CellLabel->
  "In[180]:=",ExpressionUUID->"e0d8371f-0418-485a-91eb-49366e9f906c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "3"}], "}"}]], "Output",
 CellChangeTimes->{{3.996561514790143*^9, 3.996561525185458*^9}},
 CellLabel->
  "Out[180]=",ExpressionUUID->"bcb498ec-b72e-4e8c-b9ed-331bb1c9f892"]
}, Open  ]],

Cell["\<\
Count works the same way but returns how many matched rather than what \
matched:\
\>", "Text",ExpressionUUID->"4fdc23a7-9199-42cb-b91c-76b3ee2acbfd"],

Cell[CellGroupData[{

Cell["Count[{1, 2, 2, 3, 2}, 2]", "Input",
 CellLabel->
  "In[181]:=",ExpressionUUID->"eab994fc-b675-4b92-9df5-e83ee044362d"],

Cell[BoxData["3"], "Output",
 CellChangeTimes->{3.996561537348763*^9},
 CellLabel->
  "Out[181]=",ExpressionUUID->"f7a376ce-ed45-475d-aceb-0f6d2c91861b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Count[{1, \"a\", 2.5, 3}, _Integer]", "Input",
 CellLabel->
  "In[182]:=",ExpressionUUID->"c71cfd05-9d4b-4826-9413-05afcda04d91"],

Cell[BoxData["2"], "Output",
 CellChangeTimes->{3.996561539248767*^9},
 CellLabel->
  "Out[182]=",ExpressionUUID->"58cb9968-67b4-4766-b452-f96c4e549c4d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Ordering", "Subsubsection",ExpressionUUID->"b9ac452c-658a-4777-abe4-b72207a85ecb"],

Cell["\<\
Sort with one argument puts a list into the language's canonical order, which \
for numbers is ascending and for strings is alphabetical.\
\>", "Text",ExpressionUUID->"6e304567-dfd6-446e-b5ec-7adcbebd22df"],

Cell[CellGroupData[{

Cell["Sort[{3, 1, 4, 1, 5}]", "Input",
 CellLabel->
  "In[183]:=",ExpressionUUID->"115a7956-bf7c-4096-bc4b-0bc780556649"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "1", ",", "3", ",", "4", ",", "5"}], "}"}]], "Output",
 CellChangeTimes->{3.996561548548411*^9},
 CellLabel->
  "Out[183]=",ExpressionUUID->"ef9286b8-7876-423d-9a28-2857e8fb77c7"]
}, Open  ]],

Cell["\<\
A second argument supplies a comparison function of two arguments, which is \
how any other ordering is expressed:\
\>", "Text",ExpressionUUID->"e36ce961-d2d3-4c06-9d90-9a0291d4a6f1"],

Cell[CellGroupData[{

Cell["Sort[{3, 1, 4, 1, 5}, #1 > #2 &]", "Input",
 CellLabel->
  "In[184]:=",ExpressionUUID->"bfbaee8b-54f6-43b3-9fee-555bb199df42"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"5", ",", "4", ",", "3", ",", "1", ",", "1"}], "}"}]], "Output",
 CellChangeTimes->{3.996561550975849*^9},
 CellLabel->
  "Out[184]=",ExpressionUUID->"599e189b-9059-47d1-8b81-9703f8fd2768"]
}, Open  ]],

Cell["\<\
SortBy is usually the better choice when the ordering depends on something \
computed from each element. It takes a one-argument function giving the key \
to sort on, which is easier to get right than a two-argument comparison.\
\>", "Text",ExpressionUUID->"ebe358ed-85f1-4d0b-8c53-e1d913035019"],

Cell[CellGroupData[{

Cell["SortBy[{{\"ann\", 72}, {\"raj\", 91}, {\"mo\", 65}}, Last]", "Input",
 CellLabel->
  "In[185]:=",ExpressionUUID->"c4441cac-181d-4e50-8134-7d00b79cadd5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\<\"mo\"\>", ",", "65"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"ann\"\>", ",", "72"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"raj\"\>", ",", "91"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9965615534170113`*^9},
 CellLabel->
  "Out[185]=",ExpressionUUID->"b772010e-82d4-4eed-87ff-03f14756226d"]
}, Open  ]],

Cell["\<\
Reverse turns any ordering into its opposite, which is often clearer than \
inverting the comparison:\
\>", "Text",ExpressionUUID->"e3e232f7-19c6-4976-8c5e-c6391d751607"],

Cell[CellGroupData[{

Cell["Reverse[Sort[{3, 1, 4, 1, 5}]]", "Input",
 CellLabel->
  "In[186]:=",ExpressionUUID->"1339f161-997e-438c-a56a-72d48243d140"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"5", ",", "4", ",", "3", ",", "1", ",", "1"}], "}"}]], "Output",
 CellChangeTimes->{3.996561555365532*^9},
 CellLabel->
  "Out[186]=",ExpressionUUID->"b912fe14-47a3-40f9-ae92-3918e3e40c29"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Grouping and Counting", "Subsubsection",ExpressionUUID->"ef80d078-8f15-4ec1-a608-11c693388a34"],

Cell["\<\
GatherBy splits a list into sublists whose elements all give the same result \
under a function. It does not sort; the groups appear in the order their \
first members were encountered.\
\>", "Text",ExpressionUUID->"2d7d68c6-2944-47d6-b048-4ec1b28d937a"],

Cell[CellGroupData[{

Cell["GatherBy[{1, 2, 3, 4, 5, 6}, EvenQ]", "Input",
 CellLabel->
  "In[187]:=",ExpressionUUID->"ff3fa463-9853-471a-bc50-3f464c9671ae"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "3", ",", "5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "4", ",", "6"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.996561564016552*^9},
 CellLabel->
  "Out[187]=",ExpressionUUID->"c37f9a23-2950-4067-a0b7-4c36f8d34a9a"]
}, Open  ]],

Cell["\<\
The odd numbers came first because 1, an odd number, was the first element \
seen. Grouping by a computed key works the same way:\
\>", "Text",ExpressionUUID->"f1768b52-d1ea-4266-bc8c-b962d98daf0d"],

Cell[CellGroupData[{

Cell["GatherBy[{\"ann\", \"al\", \"raj\", \"rex\"}, StringTake[#, 1] &]", \
"Input",
 CellLabel->
  "In[188]:=",ExpressionUUID->"11612c75-f6d6-4b3c-b9e1-903faeaa96e2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\<\"ann\"\>", ",", "\<\"al\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"raj\"\>", ",", "\<\"rex\"\>"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.996561566052169*^9},
 CellLabel->
  "Out[188]=",ExpressionUUID->"299335f4-ba83-4950-a833-1cf814b9ad2c"]
}, Open  ]],

Cell["\<\
Tally counts how often each distinct element occurs, returning a list of \
value and count pairs:\
\>", "Text",ExpressionUUID->"e1c2bd13-f8c8-4c3b-9356-ef3cb0d6f7b6"],

Cell[CellGroupData[{

Cell["Tally[{a, b, a, c, a, b}]", "Input",
 CellLabel->
  "In[189]:=",ExpressionUUID->"ede3c778-c037-4ac7-80f2-eae063c5506b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"b", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"c", ",", "1"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.996561569598762*^9},
 CellLabel->
  "Out[189]=",ExpressionUUID->"fab3aef4-2a83-4022-be1e-2c70989dbbf4"]
}, Open  ]],

Cell["\<\
Counts answers the same question but returns an Association, which is easier \
to look values up in afterwards:\
\>", "Text",ExpressionUUID->"a6224959-4bec-45e0-bbb9-effcc2d87714"],

Cell[CellGroupData[{

Cell["Counts[{a, b, a, c, a, b}]", "Input",
 CellLabel->
  "In[190]:=",ExpressionUUID->"cc265565-de95-4bde-b8ec-ff87225577d8"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"a", "\[Rule]", "3"}], ",", 
   RowBox[{"b", "\[Rule]", "2"}], ",", 
   RowBox[{"c", "\[Rule]", "1"}]}], "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.99656157203542*^9},
 CellLabel->
  "Out[190]=",ExpressionUUID->"a94a2dcb-ea65-4db4-a6ac-ada0c23a9267"]
}, Open  ]],

Cell["\<\
Union removes duplicates and sorts what is left, which makes it the quickest \
way to ask what distinct values a list contains:\
\>", "Text",ExpressionUUID->"654d7737-2ea5-4724-8c8e-200ebe4e45cb"],

Cell[CellGroupData[{

Cell["Union[{3, 1, 2, 1, 3}]", "Input",
 CellLabel->
  "In[191]:=",ExpressionUUID->"6fc8e015-db57-44b6-9779-91a9f4f7a5c5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output",
 CellChangeTimes->{3.99656157391623*^9},
 CellLabel->
  "Out[191]=",ExpressionUUID->"87f15dcf-4c15-44bf-8562-fca15e12e1f7"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Reshaping", "Subsubsection",ExpressionUUID->"2a33c09f-ba09-4908-86ab-06e4ab6e7e40"],

Cell["\<\
Flatten removes nesting. With no second argument it removes all of it, \
however deep.\
\>", "Text",ExpressionUUID->"557c0f0b-8ee3-4dfc-a2be-b9bd812e3341"],

Cell[CellGroupData[{

Cell["Flatten[{{1, 2}, {3, {4, 5}}}]", "Input",
 CellLabel->
  "In[192]:=",ExpressionUUID->"4b155b9b-2dc9-4664-8f9b-9e15802bbc0a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5"}], "}"}]], "Output",
 CellChangeTimes->{3.996561585314097*^9},
 CellLabel->
  "Out[192]=",ExpressionUUID->"00c2c5c6-3032-4f51-a6af-be8e39138802"]
}, Open  ]],

Cell["\<\
A second argument limits how many levels are removed, which is usually what \
is actually wanted when working with a table of rows:\
\>", "Text",ExpressionUUID->"69fec8a3-8af4-4edf-bed0-307dabf70ada"],

Cell[CellGroupData[{

Cell["Flatten[{{1, 2}, {3, {4, 5}}}, 1]", "Input",
 CellLabel->
  "In[193]:=",ExpressionUUID->"5d9d6900-7dd9-4a44-ab95-4279875782e5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3", ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "5"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.996561587251528*^9},
 CellLabel->
  "Out[193]=",ExpressionUUID->"6b359f6c-27d3-466c-8d8e-f9a8d13cbdd2"]
}, Open  ]],

Cell["\<\
Partition is the opposite operation, cutting a flat list into blocks of a \
given size:\
\>", "Text",ExpressionUUID->"311c2f83-a091-4ee0-a727-0231b8ab6097"],

Cell[CellGroupData[{

Cell["Partition[{1, 2, 3, 4, 5, 6}, 2]", "Input",
 CellLabel->
  "In[194]:=",ExpressionUUID->"30ea477b-c5ba-4040-adb9-0fb2656d2ce6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"5", ",", "6"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.996561589314546*^9},
 CellLabel->
  "Out[194]=",ExpressionUUID->"ab7f8ef4-d55c-4038-9229-d66b87daeb79"]
}, Open  ]],

Cell["\<\
When the list does not divide evenly the leftover elements are dropped rather \
than returned as a short final block. This is a common source of quietly lost \
data:\
\>", "Text",ExpressionUUID->"1619d54a-e3ba-49a3-ba90-bc26405f5ead"],

Cell[CellGroupData[{

Cell["Partition[{1, 2, 3, 4, 5}, 2]", "Input",
 CellLabel->
  "In[195]:=",ExpressionUUID->"d97f6445-ede5-4b3b-9712-a071ff040e08"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9965615918514357`*^9},
 CellLabel->
  "Out[195]=",ExpressionUUID->"8410d34c-de4b-4372-a360-bf8849bdbc6e"]
}, Open  ]],

Cell["\<\
Transpose exchanges rows and columns, which is how two parallel lists become \
a list of pairs:\
\>", "Text",ExpressionUUID->"63974764-8124-49a5-a729-0ad14ad9a927"],

Cell[CellGroupData[{

Cell["Transpose[{{1, 2, 3}, {10, 20, 30}}]", "Input",
 CellLabel->
  "In[196]:=",ExpressionUUID->"612fffdd-dc51-41c9-a2df-113076567899"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "10"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "20"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "30"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9965615936827517`*^9},
 CellLabel->
  "Out[196]=",ExpressionUUID->"848e59a7-e2c9-4d7c-89ac-cf49d9084229"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Example: A Small Data Pipeline", "Subsubsection",
 CellChangeTimes->{{3.996561603471129*^9, 
  3.9965616037016582`*^9}},ExpressionUUID->"175f513a-bdaa-49eb-9221-\
9cd7fc2b6463"],

Cell["\<\
Most real work with lists is a chain of small steps rather than one clever \
function. This example filters, transforms and summarises a set of records.\
\>", "Text",ExpressionUUID->"95c81fae-554d-46cb-b8d0-a5e414677e1c"],

Cell["Records of name and score:", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"aae30df9-f605-498e-bcdb-89e60133a712"],

Cell["\<\
marks = {{\"ann\", 72}, {\"raj\", 91}, {\"mo\", 65}, {\"sue\", 88}, {\"eli\", \
54}};\
\>", "Input",
 CellLabel->
  "In[199]:=",ExpressionUUID->"552fa7fb-3839-4930-9076-ddd3eb567ff6"],

Cell["Keep the records that passed:", "Text",ExpressionUUID->"8ae638e3-57a7-4602-817b-0c1fb7fbe6bb"],

Cell[CellGroupData[{

Cell["passed = Select[marks, #[[2]] >= 65 &]", "Input",
 CellLabel->
  "In[198]:=",ExpressionUUID->"074207fb-3627-4b36-bf32-57b721714b8a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\<\"ann\"\>", ",", "72"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"raj\"\>", ",", "91"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"mo\"\>", ",", "65"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"sue\"\>", ",", "88"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.996561608681368*^9},
 CellLabel->
  "Out[198]=",ExpressionUUID->"df704a14-a4e2-455c-97cb-74f3e54a3767"]
}, Open  ]],

Cell["Order them by score, highest first:", "Text",ExpressionUUID->"8c096cf2-83bd-4430-99aa-c3e58ba1a019"],

Cell[CellGroupData[{

Cell["ranked = Reverse[SortBy[passed, Last]]", "Input",
 CellLabel->
  "In[200]:=",ExpressionUUID->"a076431d-f532-441b-80ad-5ba8a966081b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\<\"raj\"\>", ",", "91"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"sue\"\>", ",", "88"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"ann\"\>", ",", "72"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"mo\"\>", ",", "65"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.996561613534672*^9},
 CellLabel->
  "Out[200]=",ExpressionUUID->"24f1764a-d5d9-4f9f-a6bb-09ea7dd9ba8b"]
}, Open  ]],

Cell["Take just the names:", "Text",ExpressionUUID->"f4855d03-e499-496e-82ef-61532b931ab7"],

Cell[CellGroupData[{

Cell["Map[First, ranked]", "Input",
 CellLabel->
  "In[201]:=",ExpressionUUID->"1a69db3f-943b-4d08-8953-4070d6363dd6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"raj\"\>", ",", "\<\"sue\"\>", ",", "\<\"ann\"\>", 
   ",", "\<\"mo\"\>"}], "}"}]], "Output",
 CellChangeTimes->{3.996561615850988*^9},
 CellLabel->
  "Out[201]=",ExpressionUUID->"f6075234-c3d2-437b-8db4-e164ffd01579"]
}, Open  ]],

Cell["\<\
Each step is a single function whose name says what it does. Written as one \
loop with an accumulator and a comparison the same calculation would be \
longer and considerably easier to get wrong.\
\>", "Text",ExpressionUUID->"b11cc283-8a2b-4610-816b-5026306d66d1"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Associations", "Section",ExpressionUUID->"a042a797-5cf9-484d-bed3-11beedcd05d8"],

Cell["\<\
An Association maps keys to values. Where a list is indexed by position, an \
Association is indexed by whatever key you choose, so data can be reached by \
name rather than by remembering which column it lived in.
Written out, an Association looks like a list of rules enclosed in <| and |>. \
It behaves like a data structure rather than like an expression to be \
rewritten: lookup is fast, keys are unique, and the order in which keys were \
added is preserved.\
\>", "Text",
 CellChangeTimes->{{3.9965616418818893`*^9, 
  3.9965616445420237`*^9}},ExpressionUUID->"943c7d88-17c0-42bf-af05-\
be3fdd8a20c4"],

Cell[CellGroupData[{

Cell["Building and Looking Up", "Subsubsection",ExpressionUUID->"f5be4049-11e3-42bf-a80f-db982662f32a"],

Cell["\<\
An Association is written with keys on the left of each arrow and values on \
the right. Keys are usually strings or symbols, but any expression can serve \
as one.\
\>", "Text",ExpressionUUID->"e1a9bb1c-8dd9-4baf-93ea-4b51c25314b2"],

Cell[CellGroupData[{

Cell["person = <|\"name\" -> \"ann\", \"age\" -> 31|>", "Input",
 CellLabel->
  "In[202]:=",ExpressionUUID->"3fdcef79-19b1-41e5-b518-63987e5155fa"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"name\"\>", "\[Rule]", "\<\"ann\"\>"}], ",", 
   RowBox[{"\<\"age\"\>", "\[Rule]", "31"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.996561648234125*^9},
 CellLabel->
  "Out[202]=",ExpressionUUID->"d9c036aa-0199-4a03-8688-7fd23a177158"]
}, Open  ]],

Cell["\<\
A value is retrieved by giving the key in square brackets, in the same way a \
function is called:\
\>", "Text",ExpressionUUID->"7232bab3-8490-4739-8f0a-3973d4241392"],

Cell[CellGroupData[{

Cell["person[\"name\"]", "Input",
 CellLabel->
  "In[203]:=",ExpressionUUID->"ea97c1f4-93ee-4329-b34e-a40335da0a66"],

Cell[BoxData["\<\"ann\"\>"], "Output",
 CellChangeTimes->{3.996561650108577*^9},
 CellLabel->
  "Out[203]=",ExpressionUUID->"9878495c-e7fd-4256-85a2-25ec58346882"]
}, Open  ]],

Cell["\<\
Asking for a key that is not there does not raise an error. It returns a \
Missing object, which records what was asked for:\
\>", "Text",ExpressionUUID->"ac707250-8d0a-4905-b6d6-85148ce22c8d"],

Cell[CellGroupData[{

Cell["person[\"email\"]", "Input",
 CellLabel->
  "In[204]:=",ExpressionUUID->"507ad88d-8642-40c5-bfa0-63faa74dabdc"],

Cell[BoxData[
 RowBox[{"Missing", "[", 
  RowBox[{"\<\"KeyAbsent\"\>", ",", "\<\"email\"\>"}], "]"}]], "Output",
 CellChangeTimes->{3.99656165202229*^9},
 CellLabel->
  "Out[204]=",ExpressionUUID->"a9d55fc8-06ba-44fa-b0b6-228dd77a64b4"]
}, Open  ]],

Cell["\<\
This is deliberate. A Missing value can be passed around and tested for, \
whereas an error would stop the calculation. When a sensible default is \
better than a Missing, Lookup supplies one:\
\>", "Text",ExpressionUUID->"4f977150-028d-4245-bc92-b6dcac2753d9"],

Cell[CellGroupData[{

Cell["Lookup[person, \"email\", \"none given\"]", "Input",
 CellLabel->
  "In[205]:=",ExpressionUUID->"42424398-9466-4950-a40d-e0a6b2d174a4"],

Cell[BoxData["\<\"none given\"\>"], "Output",
 CellChangeTimes->{3.996561654066753*^9},
 CellLabel->
  "Out[205]=",ExpressionUUID->"fd7fd93d-fa4a-43a0-a4a4-018b28caa80d"]
}, Open  ]],

Cell["\<\
KeyExistsQ answers the question directly when only the presence of a key \
matters:\
\>", "Text",ExpressionUUID->"b2f7e01f-bddf-4b0e-91eb-afee89e0b0d7"],

Cell[CellGroupData[{

Cell["{KeyExistsQ[person, \"age\"], KeyExistsQ[person, \"email\"]}", "Input",
 CellLabel->
  "In[206]:=",ExpressionUUID->"490fe9ef-28a4-4548-8f04-8c44b01c651c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",
 CellChangeTimes->{3.996561655728663*^9},
 CellLabel->
  "Out[206]=",ExpressionUUID->"15dbd2f3-e2f0-4646-b593-fb5d7c9308fa"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Keys and Values", "Subsubsection",ExpressionUUID->"e14daa4b-19e0-4e1d-ace0-3dabdf34ddbb"],

Cell["\<\
Keys and Values return the two halves of an Association as lists, in the \
order the keys were added.\
\>", "Text",ExpressionUUID->"1b05a13c-88e2-4d22-b3d0-f8cfbe6a1969"],

Cell[CellGroupData[{

Cell["\<\
scores = <|\"ann\" -> 72, \"raj\" -> 91, \"mo\" -> 65|>;
Keys[scores]\
\>", "Input",
 CellLabel->
  "In[207]:=",ExpressionUUID->"20af9f52-c457-422c-9ec2-f0e3ac9ffc3c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"ann\"\>", ",", "\<\"raj\"\>", ",", "\<\"mo\"\>"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.996561659662745*^9},
 CellLabel->
  "Out[208]=",ExpressionUUID->"06a3de63-c842-4af7-adb5-dc378530c33e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Values[scores]", "Input",
 CellLabel->
  "In[209]:=",ExpressionUUID->"0cef7c2d-b966-4617-b904-dfefa6a20b0b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"72", ",", "91", ",", "65"}], "}"}]], "Output",
 CellChangeTimes->{3.9965616705017157`*^9},
 CellLabel->
  "Out[209]=",ExpressionUUID->"e19ea7ea-7dc7-4416-8c64-24f44f7e9ac8"]
}, Open  ]],

Cell["\<\
Because these are ordinary lists, everything from the previous section \
applies to them directly:\
\>", "Text",ExpressionUUID->"4ce8b3df-9fc7-449c-bf56-abd68a3d762c"],

Cell[CellGroupData[{

Cell["{Length[scores], Total[Values[scores]], Max[Values[scores]]}", "Input",
 CellLabel->
  "In[210]:=",ExpressionUUID->"e9f3dace-f00f-47e2-ab48-71348af0bf79"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "228", ",", "91"}], "}"}]], "Output",
 CellChangeTimes->{3.99656167251134*^9},
 CellLabel->
  "Out[210]=",ExpressionUUID->"4fd09214-85cc-4762-b44b-3e19f49d190a"]
}, Open  ]],

Cell["\<\
Normal converts an Association back into a plain list of rules, which is \
occasionally needed when passing data to a function that expects rules:\
\>", "Text",ExpressionUUID->"d0447532-84a7-4d99-88d1-0f347b97a350"],

Cell[CellGroupData[{

Cell["Normal[scores]", "Input",
 CellLabel->
  "In[211]:=",ExpressionUUID->"3dc208e6-a66a-4aba-8426-ac9af31cc62b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"ann\"\>", "\[Rule]", "72"}], ",", 
   RowBox[{"\<\"raj\"\>", "\[Rule]", "91"}], ",", 
   RowBox[{"\<\"mo\"\>", "\[Rule]", "65"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9965616748994427`*^9},
 CellLabel->
  "Out[211]=",ExpressionUUID->"576e83c3-d4cf-4a58-a854-b13ce4c4e122"]
}, Open  ]],

Cell["\<\
The conversion works in the other direction too, so a list of rules can be \
turned into an Association whenever fast lookup becomes useful:\
\>", "Text",ExpressionUUID->"72cbb217-9946-49d1-bdc0-038a9aaf7498"],

Cell[CellGroupData[{

Cell["Association[{\"x\" -> 1, \"y\" -> 2}]", "Input",
 CellLabel->
  "In[212]:=",ExpressionUUID->"c94bddc6-0ef7-47d3-bb22-0d3f6ceefff4"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"x\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"y\"\>", "\[Rule]", "2"}]}], "\[RightAssociation]"}]], "Output",\

 CellChangeTimes->{3.99656167721769*^9},
 CellLabel->
  "Out[212]=",ExpressionUUID->"420ee785-9624-4b09-a278-f5f3b83387e9"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Adding and Removing", "Subsubsection",ExpressionUUID->"423d6975-e7bd-4ef4-b7ec-484d3b300486"],

Cell["\<\
Append adds an entry and returns a new Association. The original is not \
modified, which is consistent with how the rest of the language behaves.\
\>", "Text",ExpressionUUID->"640e1dd1-11f2-47c6-9da8-aa2540810026"],

Cell[CellGroupData[{

Cell["Append[scores, \"sue\" -> 88]", "Input",
 CellLabel->
  "In[213]:=",ExpressionUUID->"685fb7b1-8380-4449-8181-1466c5f60639"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"ann\"\>", "\[Rule]", "72"}], ",", 
   RowBox[{"\<\"raj\"\>", "\[Rule]", "91"}], ",", 
   RowBox[{"\<\"mo\"\>", "\[Rule]", "65"}], ",", 
   RowBox[{"\<\"sue\"\>", "\[Rule]", "88"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.9965616811462183`*^9},
 CellLabel->
  "Out[213]=",ExpressionUUID->"4eb63dac-20a7-46fb-883c-244be58d1fa6"]
}, Open  ]],

Cell["\<\
If the key already exists, the new value replaces the old one rather than \
creating a duplicate. Keys in an Association are unique:\
\>", "Text",ExpressionUUID->"79efb891-af75-4d45-84e8-d28da5bd2cb5"],

Cell[CellGroupData[{

Cell["Append[scores, \"ann\" -> 100]", "Input",
 CellLabel->
  "In[214]:=",ExpressionUUID->"8f205812-0d33-44dd-9441-4ac60e62f25f"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"raj\"\>", "\[Rule]", "91"}], ",", 
   RowBox[{"\<\"mo\"\>", "\[Rule]", "65"}], ",", 
   RowBox[{"\<\"ann\"\>", "\[Rule]", "100"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.9965616827626343`*^9},
 CellLabel->
  "Out[214]=",ExpressionUUID->"c4c2cdb1-e6b5-4cb1-ab15-0fcd7c2ca95d"]
}, Open  ]],

Cell["\<\
KeyDrop removes entries by key, and accepts either one key or a list of them:\
\
\>", "Text",ExpressionUUID->"74040c30-74dd-4e53-8a24-1d3469b80bed"],

Cell[CellGroupData[{

Cell["KeyDrop[scores, \"mo\"]", "Input",
 CellLabel->
  "In[215]:=",ExpressionUUID->"52f0db74-44d0-40f4-a88a-ffefcfd2200c"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"ann\"\>", "\[Rule]", "72"}], ",", 
   RowBox[{"\<\"raj\"\>", "\[Rule]", "91"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.9965616846021547`*^9},
 CellLabel->
  "Out[215]=",ExpressionUUID->"f65f9375-7ffc-4b17-a7b6-f5755aceb538"]
}, Open  ]],

Cell["\<\
Assigning to a key with a part assignment does modify the variable in place, \
which is the exception to the general rule and is convenient when building an \
Association up step by step:\
\>", "Text",ExpressionUUID->"84bf5f7d-0da1-473c-b9f9-201f507737bf"],

Cell[CellGroupData[{

Cell["\<\
tally = <||>;
tally[\"a\"] = 1;
tally[\"b\"] = 2;
tally\
\>", "Input",
 CellLabel->
  "In[216]:=",ExpressionUUID->"86000cd0-92cb-4d7f-b5f0-2273c9050385"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"a\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"b\"\>", "\[Rule]", "2"}]}], "\[RightAssociation]"}]], "Output",\

 CellChangeTimes->{3.996561686163876*^9},
 CellLabel->
  "Out[219]=",ExpressionUUID->"4256c896-72ce-40e5-9e87-015546a479cc"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Mapping and Selecting", "Subsubsection",ExpressionUUID->"6748686c-d44c-4ce7-8d36-39c2f1d1d91a"],

Cell["\<\
Map applied to an Association works on the values and leaves the keys in \
place, which is almost always what is wanted.\
\>", "Text",ExpressionUUID->"871a63b1-75f5-4910-8126-4e33a54d1ca7"],

Cell[CellGroupData[{

Cell["Map[# + 5 &, scores]", "Input",
 CellLabel->
  "In[220]:=",ExpressionUUID->"81a982d2-fba6-4ed9-a9fe-03d629e0f721"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"ann\"\>", "\[Rule]", "77"}], ",", 
   RowBox[{"\<\"raj\"\>", "\[Rule]", "96"}], ",", 
   RowBox[{"\<\"mo\"\>", "\[Rule]", "70"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.996561690082295*^9},
 CellLabel->
  "Out[220]=",ExpressionUUID->"5e071a56-b7cb-4de5-8a7b-2ac3de4caf35"]
}, Open  ]],

Cell["\<\
Select also works on values, keeping the entries whose value passes the test, \
complete with their keys:\
\>", "Text",ExpressionUUID->"08e31645-0867-4d45-83cb-183136c740af"],

Cell[CellGroupData[{

Cell["Select[scores, # > 70 &]", "Input",
 CellLabel->
  "In[221]:=",ExpressionUUID->"b247f29c-7bf9-411b-ad5a-9bbed4b61f82"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"ann\"\>", "\[Rule]", "72"}], ",", 
   RowBox[{"\<\"raj\"\>", "\[Rule]", "91"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.996561692534356*^9},
 CellLabel->
  "Out[221]=",ExpressionUUID->"9879d3d9-7744-4aad-95e6-bb3191797447"]
}, Open  ]],

Cell["\<\
When the keys are the interesting part, KeySelect and KeyMap are the \
corresponding functions:\
\>", "Text",ExpressionUUID->"eadc8fca-e71a-409a-96cc-91d21a9eacce"],

Cell[CellGroupData[{

Cell["KeySelect[scores, StringLength[#] == 3 &]", "Input",
 CellLabel->
  "In[222]:=",ExpressionUUID->"1def11f5-2dc9-4ff4-8b82-611c4cb46f8c"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"ann\"\>", "\[Rule]", "72"}], ",", 
   RowBox[{"\<\"raj\"\>", "\[Rule]", "91"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.996561694917676*^9},
 CellLabel->
  "Out[222]=",ExpressionUUID->"5735f4c2-bd07-41e0-9f42-c6b54643cea9"]
}, Open  ]],

Cell["\<\
KeyValueMap hands both halves to a function of two arguments, and returns a \
plain list rather than an Association, since the result need no longer be \
keyed:\
\>", "Text",ExpressionUUID->"1f7eba69-212c-42fe-86db-c3029a7b2562"],

Cell[CellGroupData[{

Cell["KeyValueMap[f, scores]", "Input",
 CellLabel->
  "In[223]:=",ExpressionUUID->"e7725e67-26f1-46f5-8b18-b99781c4f27c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"\<\"ann\"\>", ",", "72"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"\<\"raj\"\>", ",", "91"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"\<\"mo\"\>", ",", "65"}], "]"}]}], "}"}]], "Output",
 CellChangeTimes->{3.996561697133675*^9},
 CellLabel->
  "Out[223]=",ExpressionUUID->"aea26329-3974-43ae-915f-a931d29cc2c4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["KeyValueMap[StringJoin[#1, \": \", ToString[#2]] &, scores]", "Input",
 CellLabel->
  "In[224]:=",ExpressionUUID->"a6cd1196-c975-47d6-8272-13dbf4b33a76"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"ann: 72\"\>", ",", "\<\"raj: 91\"\>", ",", "\<\"mo: 65\"\>"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.996561699750577*^9},
 CellLabel->
  "Out[224]=",ExpressionUUID->"7cdabfc0-f239-4de2-9bee-afaef2b62b66"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Combining Associations", "Subsubsection",ExpressionUUID->"84f92761-b215-46dc-af00-901ff806faaf"],

Cell["\<\
Merge combines several Associations. Because two of them may hold the same \
key, it takes a function saying what to do when that happens.\
\>", "Text",ExpressionUUID->"5e1f204b-5e99-44fb-a658-d6a8137a1dd9"],

Cell[CellGroupData[{

Cell["Merge[{<|\"a\" -> 1, \"b\" -> 2|>, <|\"a\" -> 10|>}, Total]", "Input",
 CellLabel->
  "In[225]:=",ExpressionUUID->"5a3543dc-ba21-4610-819a-48cf4d643829"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"a\"\>", "\[Rule]", "11"}], ",", 
   RowBox[{"\<\"b\"\>", "\[Rule]", "2"}]}], "\[RightAssociation]"}]], "Output",\

 CellChangeTimes->{3.99656170266772*^9},
 CellLabel->
  "Out[225]=",ExpressionUUID->"f4514f0c-978b-43f6-a34b-ae252509e0ec"]
}, Open  ]],

Cell["\<\
The key a appeared twice, so its two values were collected into a list and \
handed to Total. The key b appeared once, and was handed a one-element list, \
which is why the combining function must cope with a single value as well as \
several.

Choosing a different combining function changes the policy on collisions. \
Taking the first value keeps the earlier Association's version:\
\>", "Text",ExpressionUUID->"77ccd4b1-8afd-418c-b3f5-907c0ffe78a4"],

Cell[CellGroupData[{

Cell["Merge[{<|\"a\" -> 1, \"b\" -> 2|>, <|\"a\" -> 10|>}, First]", "Input",
 CellLabel->
  "In[226]:=",ExpressionUUID->"b0835087-6674-4bbf-aefb-d4863e5eafe5"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"a\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"b\"\>", "\[Rule]", "2"}]}], "\[RightAssociation]"}]], "Output",\

 CellChangeTimes->{3.996561705800799*^9},
 CellLabel->
  "Out[226]=",ExpressionUUID->"04b7d50c-dde6-47f3-a1be-3facf1cee6c1"]
}, Open  ]],

Cell["\<\
Counts, met in the previous section, returns an Association, which makes it a \
natural source of data to merge or map over:\
\>", "Text",ExpressionUUID->"66e921c9-8fed-4116-8019-ca5a93bc98e7"],

Cell[CellGroupData[{

Cell["Counts[{\"red\", \"blue\", \"red\"}]", "Input",
 CellLabel->
  "In[227]:=",ExpressionUUID->"74bd6543-8fb1-448e-903d-0237e99da092"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"red\"\>", "\[Rule]", "2"}], ",", 
   RowBox[{"\<\"blue\"\>", "\[Rule]", "1"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.996561707628398*^9},
 CellLabel->
  "Out[227]=",ExpressionUUID->"2478b035-b096-43d8-8c00-64b0d89e0cb0"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Example : Grouping and Summarizing", "Subsubsection",
 CellChangeTimes->{{3.996561723151486*^9, 
  3.996561724832198*^9}},ExpressionUUID->"7a7cf732-041c-41c0-bb18-\
4805738a73ad"],

Cell["\<\
Associations and the list functions from the previous section combine well. \
This example turns a flat list of records into a keyed summary.\
\>", "Text",ExpressionUUID->"de8dd072-5a5d-4ce1-af64-7e419af58d37"],

Cell["Marks by subject:", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"d1f7a3aa-ed79-4a55-883d-3dc108df9829"],

Cell["\<\
entries = {{\"maths\", 70}, {\"physics\", 65}, {\"maths\", 80}, {\"physics\", \
90}};\
\>", "Input",
 CellLabel->
  "In[229]:=",ExpressionUUID->"6b9389b1-3c8e-405b-bc0a-7586bb07c210"],

Cell["\<\
GroupBy is the Association-producing counterpart of GatherBy: it uses the \
computed key as the actual key of the result.\
\>", "Text",ExpressionUUID->"ac15f11c-371a-42a6-a6fb-8b70a3cf01aa"],

Cell[CellGroupData[{

Cell["GroupBy[entries, First]", "Input",
 CellLabel->
  "In[230]:=",ExpressionUUID->"b364f434-566d-433b-841a-874af83c4593"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"maths\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\<\"maths\"\>", ",", "70"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\<\"maths\"\>", ",", "80"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"physics\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\<\"physics\"\>", ",", "65"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\<\"physics\"\>", ",", "90"}], "}"}]}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.9965617349514303`*^9},
 CellLabel->
  "Out[230]=",ExpressionUUID->"83d40d3f-5a56-4d69-b228-da38820cfd62"]
}, Open  ]],

Cell["\<\
A second function argument says how to reduce each group, which collapses the \
grouping and the summarising into one step:\
\>", "Text",ExpressionUUID->"324efe60-d3d1-4139-bfbc-08eda8ab43e2"],

Cell[CellGroupData[{

Cell["GroupBy[entries, First -> Last, Mean]", "Input",
 CellLabel->
  "In[231]:=",ExpressionUUID->"4fe727ae-dde1-46a8-a406-a1c9a7c203e1"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"maths\"\>", "\[Rule]", "75"}], ",", 
   RowBox[{"\<\"physics\"\>", "\[Rule]", 
    FractionBox["155", "2"]}]}], "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.99656173695094*^9},
 CellLabel->
  "Out[231]=",ExpressionUUID->"e76073a2-ee82-474a-af85-08d18f3480fc"]
}, Open  ]],

Cell["\<\
The result is keyed by subject, so an individual average can now be read out \
by name rather than searched for:\
\>", "Text",ExpressionUUID->"5d2f4d04-fa4d-44fd-bf5d-e17f36c95822"],

Cell[CellGroupData[{

Cell["GroupBy[entries, First -> Last, Mean][\"maths\"]", "Input",
 CellLabel->
  "In[232]:=",ExpressionUUID->"906580c7-a512-4083-8884-9faf43b64acf"],

Cell[BoxData["75"], "Output",
 CellChangeTimes->{3.9965617398973227`*^9},
 CellLabel->
  "Out[232]=",ExpressionUUID->"cddd2cb4-c2a7-4670-be50-3fbeddf27698"]
}, Open  ]],

Cell["\<\
Compared with the GatherBy version of this calculation, the work is the same \
but the result is directly usable, which is the general argument for reaching \
for an Association once data has a natural key.\
\>", "Text",ExpressionUUID->"6a12217d-90e4-4697-a499-311a076fecb4"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Recursion", "Section",
 CellChangeTimes->{{3.86862968049234*^9, 3.8686296917627287`*^9}, {
  3.8686297426814013`*^9, 
  3.868629743229714*^9}},ExpressionUUID->"d040a038-2160-4bb7-862b-\
3b6a37cfeecd"],

Cell["\<\
Recursion is a programming technique where a function is defined in terms of \
itself In recursion, a problem is solved by reducing it into smaller versions \
of the same problem.
A recursive function usually contains two important parts:
\t- Base case
\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\t\
- Recursive case\
\>", "Text",
 CellChangeTimes->{{3.996560971466103*^9, 
  3.996560973639823*^9}},ExpressionUUID->"6a4b6360-e5ef-4dce-9cd1-\
b7770b4fee3f"],

Cell[CellGroupData[{

Cell["Base Case", "Subsubsection",ExpressionUUID->"01d58853-8da0-46aa-a174-4116d98ddd0d"],

Cell["\<\
The base case defines when recursion should stop.
Without base case, recursion continues forever.\
\>", "Text",ExpressionUUID->"05ab3116-d510-49f8-b1c2-6a37243c0c8b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Recursive Case ", "Subsubsection",ExpressionUUID->"a0d4dc69-8783-4124-82f8-24a146b4b3fd"],

Cell["\<\
The recursive case defines how the function calls itself on a smaller \
problem.
Each recursive call should move closer to the base case.\
\>", "Text",ExpressionUUID->"5220be56-ff0a-4a70-9c6f-47cc44f73dd6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Important Note  ", "Subsubsection",ExpressionUUID->"8aeb1a5b-d17a-43a5-9cb5-3d4f0cf5a7d7"],

Cell["\<\
 A recursive function should always satisfy both conditions:
\[NonBreakingSpace] \t- a valid base case exists
\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\t\
- each recursive call moves closer to the base case
\[NonBreakingSpace]\[NonBreakingSpace]If either condition fails, the \
recursion may never stop.\
\>", "Text",ExpressionUUID->"d19a0f3d-7120-4434-8dcf-f4ac5cf7dfce"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Example", " ", "of", " ", "Incorrect", " ", "Recursion"}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "n_", "]"}], " ", ":=", " ", 
    RowBox[{"f", "[", 
     RowBox[{"n", " ", "+", " ", "1"}], "]"}]}], "\n", 
   RowBox[{
    RowBox[{"f", "[", "1", "]"}], " ", "=", " ", "1"}], "\n", 
   RowBox[{"f", "[", "5", "]"}]}]}]], "Input",
 CellLabel->
  "In[114]:=",ExpressionUUID->"a64a00aa-0e95-438e-abaa-ac1f277147f9"],

Cell[BoxData["1"], "Output",
 CellChangeTimes->{3.99656098150508*^9},
 CellLabel->
  "Out[115]=",ExpressionUUID->"b4c4c3ab-cd03-4376-b7a3-4ea9534e46c4"],

