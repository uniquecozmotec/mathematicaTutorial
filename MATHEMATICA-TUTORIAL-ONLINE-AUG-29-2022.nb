Cell[BoxData[
 DynamicModuleBox[{topics$$ = {"Recursion"}, difficulties$$ = {"Beginner"}, 
  questionTypes$$ = {"MCQ-Single", "MCQ-Multiple", "Blanks", "Code Writing"}, 
  typeCounts$$ = <|
  "MCQ-Single" -> 0, "MCQ-Multiple" -> 0, "Blanks" -> 0, "Code Writing" -> 
