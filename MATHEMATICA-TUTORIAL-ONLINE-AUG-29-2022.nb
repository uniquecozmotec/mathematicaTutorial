Cell["\<\
\t    fib(4)
              /        \\
         fib(3)        fib(2)
        /      \\       /     \\
    fib(2)   fib(1) fib(1) fib(0)
    /    \\
fib(1) fib(0)\
\>", "Text",
 FontColor->RGBColor[
  0, 0, 0, 1],ExpressionUUID->"95452e7d-1e72-4431-b670-b6c028cc9110"],

Cell["Observation:", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"dc7aef86-1224-47e3-86b3-29c89d621d83"],

Cell["\<\
1) Unlike factorial, Fibonacci creates multiple recursive calls.
     This creates a recursion tree and this type of recursion is called \
branching recursion.
2) Fibonacci has repeated computations. 
     For e.g. fib[2] is computed multiple times.
\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]This makes naive recursive Fibonacci inefficient.
\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]This means as n grows larger: recursive calls increase \
rapidly and repeated work becomes huge.
\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]Try evaluating : fib[10], fib[20] ... and try to observe \
how it performs.
\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]This problem can be optimized using techniques such as \
Memoization and Dynamic Programming.\
\>", "Text",
 CellChangeTimes->{{3.996561010310875*^9, 
  3.996561013778689*^9}},ExpressionUUID->"ac3a8eab-79b5-4f0e-a168-\
269f78678e37"]
}, Closed]],

Cell[CellGroupData[{

Cell["Example 3: Sum of a List", "Subsubsection",ExpressionUUID->"64d653ac-2e58-42d3-a652-85e2947834a6"],

Cell["\<\
Recursion is often used with data structures.
Consider: {1,2,3,4} and we want to compute its sum.

Idea: sum(list) = first element + sum( )
Base Case: sum[{}] = 0. ( Sum of empty list is 0 )\
\>", "Text",ExpressionUUID->"840b69ee-799b-4ed4-a354-84dfec0209e2"],

Cell["Function definition:", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"ac6c6c51-5b88-4dda-9534-de3f95d94624"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", "sum", "]"}], "\n", 
 RowBox[{
  RowBox[{"sum", "[", 
   RowBox[{"{", "}"}], "]"}], " ", "=", " ", "0"}], "\n", 
 RowBox[{
  RowBox[{"sum", "[", "list_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"First", "[", "list", "]"}], " ", "+", " ", 
   RowBox[{"sum", "[", 
    RowBox[{"Rest", "[", "list", "]"}], "]"}]}]}]}], "Input",ExpressionUUID->\
"59b60306-fad8-4375-90d8-3f508e56c4ec"],

Cell[BoxData["0"], "Output",
 CellLabel->
  "Out[53]= ",ExpressionUUID->"d2b7db7b-b52e-4b0a-a491-75a4c22f3238"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sum", "[", 
  RowBox[{"{", 
   RowBox[{"1", ",", "2", ",", "4", ",", "5", ",", "6"}], "}"}], 
  "]"}]], "Input",ExpressionUUID->"b1306fb9-387a-4e64-a709-f5fca736650b"],

Cell[BoxData["18"], "Output",
 CellLabel->
  "Out[49]= ",ExpressionUUID->"27ec2528-a8e4-4d89-951a-08ac6607ec00"]
}, Open  ]],

Cell["Explanation:", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"02ebf76c-b232-4eb9-8a8c-8343482e61a6"],

Cell[BoxData[{
 RowBox[{"sum", "[", 
  RowBox[{"{", 
   RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}], "\n", 
 RowBox[{"1", " ", "+", " ", 
  RowBox[{"sum", "[", 
   RowBox[{"{", 
    RowBox[{"2", ",", " ", "3"}], "}"}], "]"}]}], "\n", 
 RowBox[{"1", " ", "+", " ", "2", " ", "+", " ", 
  RowBox[{"sum", "[", 
   RowBox[{"{", "3", "}"}], "]"}]}], "\n", 
 RowBox[{"1", " ", "+", " ", "2", " ", "+", " ", "3", " ", "+", " ", 
  RowBox[{"sum", "[", 
   RowBox[{"{", "}"}], "]"}]}], "\n", 
 RowBox[{"1", " ", "+", " ", "2", " ", "+", " ", "3", " ", "+", " ", 
  "0"}], "\n", "6"}], "Input",ExpressionUUID->"af2ce0d4-abc5-4f80-8e00-\
75754a9f97e9"],

Cell["Observation:", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"3b4901fb-0a78-4584-b904-ca8bf446380e"],

Cell["\<\
Here recursion is not reducing an integer.
Instead, recursion reduces the size of a data structure, this is called \
structural recursion.\
\>", "Text",ExpressionUUID->"5e363b67-7b01-4f25-8986-f32060b4f783"],

