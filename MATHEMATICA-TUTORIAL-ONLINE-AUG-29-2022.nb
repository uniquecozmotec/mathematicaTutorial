Cell["\<\
This shows evaluation proceeded as 

4 * factorial[3]
4 * 3 * factorial[2]
4 * 3 * 2 * factorial[1]
4 * 3 * 2 * 1
24\
\>", "Text",
 InitializationCell->
  False,ExpressionUUID->"d6bb896b-39cc-48d7-977c-2d2ce907b01d"],

