                   Button[
                   "-", typeCounts$$[tt$] = Max[typeCounts$$[tt$] - 1, 0], 
                    Enabled -> Dynamic[typeCounts$$[tt$] > 0], 
                    ImageSize -> {28, 24}], 
                   Item[
                    Dynamic[
                    typeCounts$$[tt$]], ItemSize -> 3, Alignment -> Center], 
                   Button[
                   "+", typeCounts$$[tt$] = Min[typeCounts$$[tt$] + 1, 
                    countAvailable[topics$$, difficulties$$, tt$]], Enabled -> 
                    Dynamic[
                    typeCounts$$[tt$] < 
                    countAvailable[topics$$, difficulties$$, tt$]], 
                    ImageSize -> {28, 24}]}]]], {t, questionTypes$$}]], 
             StandardForm],
            
            ImageSizeCache->{
             272.05224609375, {51.172119140625, 56.827880859375}}]},
          {
           TemplateBox[{
             StyleBox["\"Total selected: \"", Bold, StripOnInput -> False], 
             DynamicBox[
              ToBoxes[
               Total[
                Values[typeCounts$$]], StandardForm]]},
            "RowDefault"]},
          {
           ButtonBox["\<\"Generate\"\>",
            Appearance->Automatic,
            ButtonFunction:>(questions$$ = Flatten[
                KeyValueMap[
                generateExerciseSet[topics$$, difficulties$$, {#}, #2]& , 
                 typeCounts$$]]; questions$$ = RandomSample[questions$$, 
                Length[questions$$]]; current$$ = 1; answers$$ = {}; 
             finished$$ = False; userAnswer$$ = ""; selectedOptions$$ = {}; 
             Null),
            Evaluator->Automatic,
            Method->"Preemptive"]}
         },
         DefaultBaseStyle->"Column",
         GridBoxAlignment->{"Columns" -> {{Left}}},
         GridBoxItemSize->{
          "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
        "Column"]]},
     {
      DynamicBox[ToBoxes[
        If[questions$$ === {}, 
         Style["Select question types and generate to start.", Italic], 
         If[finished$$, 
          Panel[
           Column[{
             Style["Completed", 18, Bold], "Score: " <> ToString[
               Count[answers$$, 
                Condition[
                 Pattern[a, 
                  Blank[]], 
                 a["Correct"]]]] <> " / " <> ToString[
               Length[answers$$]], 
             Column[
              Table[
               Panel[
                Column[{
                  Style["Q" <> ToString[i], Bold], 
                  Part[answers$$, i]["Question"], "Your Answer: " <> 
                  ToString[
                    Part[answers$$, i]["UserAnswer"]], "Correct: " <> ToString[
                    Part[answers$$, i]["CorrectAnswer"]], 
                  If[
                   Part[answers$$, i]["Correct"], 
                   Style["Correct", Green], 
                   Style["Wrong", Red]]}]], {i, 
                Length[answers$$]}]]}]], 
          Module[{q$ = Part[questions$$, current$$]}, 
           Panel[
            Column[{
              Style["Question " <> ToString[current$$] <> " / " <> ToString[
                 Length[questions$$]], Bold], 
              Style[q$["Difficulty"] <> " - " <> q$["Type"], Gray], 
              q$["Question"], 
              Which[q$["Type"] === "MCQ-Single", 
               RadioButtonBar[
                Dynamic[userAnswer$$], 
                q$["Options"]], q$["Type"] === "MCQ-Multiple", 
               CheckboxBar[
                Dynamic[selectedOptions$$], 
                q$["Options"]], q$["Type"] === "Blanks", 
               InputField[
                Dynamic[userAnswer$$], String], q$["Type"] === "Code Writing", 
               InputField[
                Dynamic[userAnswer$$], String, FieldSize -> {60, 5}]], 
              Button["Submit", 
               
               Module[{ans$, correct$}, 
                ans$ = Which[
                  q$["Type"] === "MCQ-Multiple", selectedOptions$$, True, 
                   userAnswer$$]; correct$ = checkAnswer[q$, ans$]; 
                AppendTo[
                 answers$$, <|
                  "Question" -> q$["Question"], "UserAnswer" -> ans$, 
                   "CorrectAnswer" -> q$["Answer"], "Correct" -> correct$|>]; 
                If[current$$ == Length[questions$$], finished$$ = True, 
                  Increment[current$$]; userAnswer$$ = ""; 
                  selectedOptions$$ = {}; Null]; Null]]}]]]]], StandardForm],
       ImageSizeCache->{350.13737163600007`, {2.912, 9.308}}]}
    },
    DefaultBaseStyle->"Column",
    GridBoxAlignment->{"Columns" -> {{Left}}},
    GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
   "Column"],
  ExpressionUUID -> "ce1a799d-415f-42ce-b607-176e99c86f5b",
  DynamicModuleValues:>{}]], "Output",
 CellLabel->
  "Out[36]= ",ExpressionUUID->"d8771fc1-dfef-47b8-8140-142cd25b57d9"]
}, Open  ]]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Nest, NestList and FixedPoint", "Section",ExpressionUUID->"e1c7384a-19da-4ad0-95fd-0d2a120388c6"],

Cell["\<\
Applying a function to a value, then to the result, then to that result \
again, is one of the most common shapes a computation takes. Recursion can \
express it, and so can a loop, but the Wolfram Language provides a family of \
functions that say it directly.
The family divides along two questions. Do you want only the final answer, or \
every step along the way? And do you know in advance how many steps to take, \
or should the iteration stop when some condition is met?\
\>", "Text",
 CellChangeTimes->{{3.996561750918318*^9, 
  3.9965617529888573`*^9}},ExpressionUUID->"9f9ee844-1f4f-436b-81f2-\
8e948697a159"],

Cell[CellGroupData[{

Cell["Nest", "Subsubsection",ExpressionUUID->"79d4da1a-c30c-4563-94ae-7dc5fb637a51"],

Cell["\<\
Nest applies a function a given number of times, returning only the final \
result. Using an undefined symbol f shows the structure clearly.\
\>", "Text",ExpressionUUID->"1e4f9ec2-ad37-4f65-b2c6-e69c2ac7b90b"],

Cell[CellGroupData[{

Cell["Nest[test, x, 3]", "Input",
 CellChangeTimes->{{3.996561758361417*^9, 3.99656177557579*^9}},
 CellLabel->
  "In[236]:=",ExpressionUUID->"16e92e7b-f289-498b-b846-0ae65f9944c2"],

Cell[BoxData[
 RowBox[{"test", "[", 
  RowBox[{"test", "[", 
   RowBox[{"test", "[", "100", "]"}], "]"}], "]"}]], "Output",
 CellChangeTimes->{{3.9965617553945208`*^9, 3.996561777851075*^9}},
 CellLabel->
  "Out[236]=",ExpressionUUID->"3f179ef6-fa1a-47f5-af8a-5441da1a653a"]
}, Open  ]],

Cell["\<\
With a real function it produces the value rather than the structure. Here \
each step squares the previous result, starting from 2:\
\>", "Text",ExpressionUUID->"612a64ba-82f8-4103-8ea9-d8edddfdeaf0"],

Cell[CellGroupData[{

Cell["Nest[#^2 &, 2, 3]", "Input",
 CellLabel->
  "In[237]:=",ExpressionUUID->"6cc3c5ef-4e62-46b0-b869-63f391eb9778"],

Cell[BoxData["256"], "Output",
 CellChangeTimes->{3.996561783250486*^9},
 CellLabel->
  "Out[237]=",ExpressionUUID->"7a489c57-2058-4d34-a38b-89564e7f42fc"]
}, Open  ]],

Cell["\<\
Two becomes four, then sixteen, then two hundred and fifty six. Nothing about \
the intermediate values is kept.

Nest works on any kind of value, not only numbers. Applied to a list, it can \
remove elements one at a time:\
\>", "Text",ExpressionUUID->"bfdb119e-11d7-488d-a80e-6392a8c19efe"],

Cell[CellGroupData[{

Cell["Nest[Rest, {1, 2, 3, 4, 5}, 2]", "Input",
 CellLabel->
  "In[238]:=",ExpressionUUID->"771ddb56-cd33-4135-9cb8-be5a7b1e9a82"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "4", ",", "5"}], "}"}]], "Output",
 CellChangeTimes->{3.996561785848159*^9},
 CellLabel->
  "Out[238]=",ExpressionUUID->"90130cb1-31dd-4ebd-9ee9-6a8fa2d5e89d"]
}, Open  ]],

Cell["\<\
A count of zero returns the starting value untouched, which is the natural \
base case and means the count never needs special handling:\
\>", "Text",ExpressionUUID->"4c43ab36-64ec-4dfe-a499-8ce6d47f8016"],

Cell[CellGroupData[{

Cell["Nest[f, x, 0]", "Input",
 CellLabel->
  "In[239]:=",ExpressionUUID->"6ee54c39-35d5-4cce-af30-5ad3ef823cbc"],

Cell[BoxData["100"], "Output",
 CellChangeTimes->{3.996561787995453*^9},
 CellLabel->
  "Out[239]=",ExpressionUUID->"eb06b438-0c27-4a0e-a075-0524fefeef2b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["NestList", "Subsubsection",ExpressionUUID->"ec6bc9d1-8a53-4a21-bb4f-fff00d97e7a1"],

Cell["\<\
NestList does the same work but keeps every intermediate value, including the \
starting one. The result of NestList with n steps therefore has n plus one \
elements.\
\>", "Text",ExpressionUUID->"31760c1f-3d8a-43d4-a049-e34dc3966a85"],

Cell[CellGroupData[{

Cell["NestList[test, x, 3]", "Input",
 CellChangeTimes->{{3.9965617926664352`*^9, 3.9965617932374897`*^9}},
 CellLabel->
  "In[240]:=",ExpressionUUID->"bec8254b-f9ea-4868-a42e-78e79d690894"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"100", ",", 
   RowBox[{"test", "[", "100", "]"}], ",", 
   RowBox[{"test", "[", 
    RowBox[{"test", "[", "100", "]"}], "]"}], ",", 
   RowBox[{"test", "[", 
    RowBox[{"test", "[", 
     RowBox[{"test", "[", "100", "]"}], "]"}], "]"}]}], "}"}]], "Output",
 CellChangeTimes->{3.996561794147105*^9},
 CellLabel->
  "Out[240]=",ExpressionUUID->"579e55ba-a03e-4110-89dc-2ac48945f23c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["NestList[#*2 &, 1, 5]", "Input",
 CellLabel->
  "In[241]:=",ExpressionUUID->"d31a0c98-1ca1-4f32-9d33-57dd887de306"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "4", ",", "8", ",", "16", ",", "32"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.996561796413084*^9},
 CellLabel->
  "Out[241]=",ExpressionUUID->"a5fceab9-c2e6-4f07-b95b-f72a73f64567"]
}, Open  ]],

Cell["\<\
This is often more useful than Nest itself, because the sequence of steps is \
what shows whether an iteration is behaving as expected. Comparing the two on \
the same computation makes the relationship obvious:\
\>", "Text",ExpressionUUID->"3c92ed0b-8a2a-4865-aec6-43e286893cd1"],

Cell[CellGroupData[{

Cell["{Nest[#*2 &, 1, 5], Last[NestList[#*2 &, 1, 5]]}", "Input",
 CellLabel->
  "In[242]:=",ExpressionUUID->"c6846683-db6c-44a6-8fa3-b3a9a249346c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"32", ",", "32"}], "}"}]], "Output",
 CellChangeTimes->{3.996561798880704*^9},
 CellLabel->
  "Out[242]=",ExpressionUUID->"6470f03b-304e-4d89-8772-36bf8c1b5a4f"]
}, Open  ]],

Cell["\<\
Generating a sequence is a natural use. Each term here is built from the one \
before, which is exactly the shape NestList expects:\
\>", "Text",ExpressionUUID->"3561f20d-5a53-4ade-8234-81f8d2b9b581"],

Cell[CellGroupData[{

Cell["NestList[# + 3 &, 1, 6]", "Input",
 CellLabel->
  "In[243]:=",ExpressionUUID->"7dce82ba-d498-4d9d-a045-e94589cbbf38"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1", ",", "4", ",", "7", ",", "10", ",", "13", ",", "16", ",", "19"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.996561800998659*^9},
 CellLabel->
  "Out[243]=",ExpressionUUID->"7cc517fc-2a2a-441a-be06-a3e9d644a15a"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["FixedPoint", "Subsubsection",ExpressionUUID->"09b9ec50-bd4c-4966-8a9c-593a5da65d89"],

Cell["\<\
Sometimes the number of steps is not known in advance, and what is wanted is \
to keep going until the value stops changing. That is a fixed point, and \
FixedPoint finds it.\
\>", "Text",ExpressionUUID->"e022f382-c334-4c83-879e-a42c4abf050f"],

Cell["\<\
Newton's method for a square root, which converges after a few steps:\
\>", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"4383aff0-5777-42d2-ab4a-f111acb890bd"],

Cell[CellGroupData[{

Cell["FixedPoint[(# + 2/#)/2 &, 1.0]", "Input",
 CellLabel->
  "In[244]:=",ExpressionUUID->"ae178288-97bd-4773-83b0-184cc6813c68"],

Cell[BoxData["1.414213562373095`"], "Output",
 CellChangeTimes->{3.996561803981743*^9},
 CellLabel->
  "Out[244]=",ExpressionUUID->"e274bccf-bfd3-44e6-ba0e-7040b7dd914e"]
}, Open  ]],

Cell["\<\
The result is the square root of two. No iteration count was given: the \
process stopped when applying the function again produced the same value it \
had just produced.

FixedPointList shows how the convergence happened, which is the honest way to \
check that it converged rather than merely stopped:\
\>", "Text",ExpressionUUID->"edd94ec1-c577-492b-b1bf-b519f6694b4e"],

Cell[CellGroupData[{

Cell["FixedPointList[(# + 2/#)/2 &, 1.0]", "Input",
 CellLabel->
  "In[245]:=",ExpressionUUID->"f387e229-578c-4169-a27d-aadb31ef0c00"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1.`", ",", "1.5`", ",", "1.4166666666666665`", ",", "1.4142156862745097`", 
   ",", "1.4142135623746899`", ",", "1.414213562373095`", ",", 
   "1.414213562373095`"}], "}"}]], "Output",
 CellChangeTimes->{3.996561806300763*^9},
 CellLabel->
  "Out[245]=",ExpressionUUID->"e39b7e24-b0a1-4de2-82c1-f5561b36b72b"]
}, Open  ]],

Cell["\<\
The values settle quickly, and the last two are identical, which is the \
condition that ended the iteration.
Fixed points are not only numerical. Applying rewrite rules until nothing \
changes is the same idea, and is what the //. operator from the Rules section \
does internally:\
\>", "Text",
 CellChangeTimes->{
  3.9965618081394157`*^9},ExpressionUUID->"70504591-b3e2-4886-a4cb-\
4e0dce21fb97"],

Cell[CellGroupData[{

Cell["FixedPoint[# /. test[t_] :> t &, test[test[test[x]]]]", "Input",
 CellChangeTimes->{{3.996561813290042*^9, 3.996561818773039*^9}},
 CellLabel->
  "In[247]:=",ExpressionUUID->"1bb0c523-0953-4b9b-b941-50bb4037f8ec"],

Cell[BoxData["100"], "Output",
 CellChangeTimes->{{3.996561810687325*^9, 3.996561820499263*^9}},
 CellLabel->
  "Out[247]=",ExpressionUUID->"27d0b064-e858-4fca-b8e1-b143d5ba0d63"]
}, Open  ]],

Cell["\<\
A function that never settles would iterate forever, so FixedPoint accepts an \
optional limit on the number of steps, after which it gives up and returns \
what it has:\
\>", "Text",ExpressionUUID->"9f26d1fe-bb61-409d-9d82-4550abbdd76f"],

Cell[CellGroupData[{

Cell["FixedPoint[# + 1 &, 0, 5]", "Input",
 CellLabel->
  "In[248]:=",ExpressionUUID->"3ef86560-7bea-42a4-99e0-8bdf1ab445ed"],

Cell[BoxData["5"], "Output",
 CellChangeTimes->{3.996561823645987*^9},
 CellLabel->
  "Out[248]=",ExpressionUUID->"b82b4823-3784-433c-903a-179025aa61cd"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["NestWhile", "Subsubsection",ExpressionUUID->"af1bb9ea-f5c6-49d3-8f63-d3a609bbf900"],

Cell["\<\
NestWhile keeps applying a function for as long as a test on the current \
value returns True. It is the general form: a fixed point is the special case \
where the test is whether anything changed.\
\>", "Text",ExpressionUUID->"b0fcc8b4-f3aa-4c3c-bf95-ecb130c2c168"],

Cell[CellGroupData[{

Cell["NestWhile[#/2 &, 80, EvenQ]", "Input",
 CellLabel->
  "In[249]:=",ExpressionUUID->"ef59160c-d69e-4146-9095-aae7f7eb50cf"],

Cell[BoxData["5"], "Output",
 CellChangeTimes->{3.9965618278505096`*^9},
 CellLabel->
  "Out[249]=",ExpressionUUID->"cebd4c91-edfa-49aa-830a-5235eb768cc8"]
}, Open  ]],

Cell["\<\
Halving continued while the value stayed even, and stopped at the first odd \
number. NestWhileList records the whole sequence in the same way NestList \
does:\
\>", "Text",ExpressionUUID->"c13df538-6521-4f82-88b2-f72084b0ca75"],

Cell[CellGroupData[{

Cell["NestWhileList[#/2 &, 80, EvenQ]", "Input",
 CellLabel->
  "In[250]:=",ExpressionUUID->"c504034d-2cc6-4c96-b40a-e76e4018e779"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"80", ",", "40", ",", "20", ",", "10", ",", "5"}], "}"}]], "Output",\

 CellChangeTimes->{3.996561829499867*^9},
 CellLabel->
  "Out[250]=",ExpressionUUID->"f20b9303-19d6-4e95-9afc-a4237dd74489"]
}, Open  ]],

Cell["\<\
The test is applied to the value before the function runs, so the result is \
always the first value that failed the test rather than the last one that \
passed it.
This makes NestWhile the natural way to express any iteration whose length \
depends on the data:\
\>", "Text",
 CellChangeTimes->{
  3.996561830962429*^9},ExpressionUUID->"c6cf747d-47be-4b76-bd16-\
7d04e0168575"],

Cell[CellGroupData[{

Cell["NestWhileList[If[EvenQ[#], #/2, 3*# + 1] &, 6, # != 1 &]", "Input",
 CellLabel->
  "In[251]:=",ExpressionUUID->"a72c2945-132d-4213-841b-82b366555cd8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "6", ",", "3", ",", "10", ",", "5", ",", "16", ",", "8", ",", "4", ",", "2",
    ",", "1"}], "}"}]], "Output",
 CellChangeTimes->{3.9965618326803093`*^9},
 CellLabel->
  "Out[251]=",ExpressionUUID->"72b6653b-e366-4307-9e77-abc4323a3479"]
}, Open  ]],

Cell["\<\
That is the Collatz sequence starting from six, run until it reaches one. \
Nothing in the code says how many steps it will take, because nothing can: \
that is a property of the number it started from.\
\>", "Text",ExpressionUUID->"27dd550f-c2a1-4a6b-a5fc-075cb0be5fbb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Example : The Same Iteration Three Ways", "Subsubsection",
 CellChangeTimes->{
  3.9965618396608152`*^9},ExpressionUUID->"eddce59f-289c-45e2-b27f-\
415380067c98"],

Cell["\<\
This example computes the same sequence with a loop, with recursion, and with \
NestList, to make the comparison concrete.\
\>", "Text",ExpressionUUID->"32bbeb73-f0c9-4821-9d29-b700c57efd0a"],

Cell["\<\
A loop, with a counter and an accumulator that must both be managed by hand:\
\>", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"ff8bce0b-5148-4881-b428-c83a3e542403"],

Cell[CellGroupData[{

Cell["\<\
Module[{v = 1, out = {}}, Do[out = Append[out, v]; v = v*3, {5}]; out]\
\>", "Input",
 CellLabel->
  "In[252]:=",ExpressionUUID->"e9162634-7f24-4ad1-8904-f53119ffc505"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "3", ",", "9", ",", "27", ",", "81"}], "}"}]], "Output",
 CellChangeTimes->{3.996561842461273*^9},
 CellLabel->
  "Out[252]=",ExpressionUUID->"53cb6dff-dc12-4d0d-8a52-aad6df12121f"]
}, Open  ]],

Cell["\<\
A recursive definition, which removes the counter but introduces a base case \
and a helper name:\
\>", "Text",ExpressionUUID->"ba0345fb-dc1a-4db4-b881-0a8d0ef7b3e5"],

Cell[CellGroupData[{

Cell["\<\
Clear[powers];
powers[v_, 0] := {v};
powers[v_, n_] := Prepend[powers[v*3, n - 1], v];
powers[1, 4]\
\>", "Input",
 CellLabel->
  "In[253]:=",ExpressionUUID->"aea7781e-ad66-4c1f-b2b6-f5af0e9a2fd8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "3", ",", "9", ",", "27", ",", "81"}], "}"}]], "Output",
 CellChangeTimes->{3.9965618442995853`*^9},
 CellLabel->
  "Out[256]=",ExpressionUUID->"4298ce46-1779-45ae-a358-01397af7a253"]
}, Open  ]],

Cell["NestList, which says the same thing in one line:", "Text",ExpressionUUID->"f45e6a98-b006-4bac-8846-7b6358866f39"],

Cell[CellGroupData[{

Cell["NestList[#*3 &, 1, 4]", "Input",
 CellLabel->
  "In[257]:=",ExpressionUUID->"833a7465-8203-431f-9410-ac82570076e9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "3", ",", "9", ",", "27", ",", "81"}], "}"}]], "Output",
 CellChangeTimes->{3.996561922899878*^9},
 CellLabel->
  "Out[257]=",ExpressionUUID->"038bfb42-3a3f-4e3d-bd81-122c8c3dac1a"]
}, Open  ]],

Cell["\<\
All three produce the same list. The third states the iteration itself and \
nothing else, which is why it is the version least likely to contain a \
mistake and the easiest to check by reading.\
\>", "Text",ExpressionUUID->"850248fa-0c73-4d78-9a98-709dadbf81bd"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Dynamic Programming and Memoization", "Section",ExpressionUUID->"58ca88f0-89ca-49f8-afad-16c7b901cafc"],

Cell["\<\
A recursive definition can be correct and still be unusable, because it \
recomputes the same values over and over. Memoization fixes this by \
remembering each result the first time it is worked out, so that the second \
request for it costs nothing.
The Wolfram Language makes this unusually direct. Because a function \
definition is a stored rule, a function can add new rules to itself while it \
runs, and a remembered value is simply another definition. The whole \
technique fits in one idiom.
This section covers:
\t- Why naive recursion can be exponentially slow
\t- The f[n_] := f[n] = ... idiom, and why it works
\t- Measuring the difference, and inspecting what was remembered
\t- Top-down memoization against bottom-up dynamic programming\
\>", "Text",
 CellChangeTimes->{{3.99656194088859*^9, 
  3.996561944957033*^9}},ExpressionUUID->"19e78341-cdae-4da3-925d-\
3500a5c2e2d7"],

Cell[CellGroupData[{

Cell["The Problem", "Subsubsection",ExpressionUUID->"3883a123-9e41-41c4-9a9b-9aaefd33e18d"],

Cell["\<\
The Fibonacci numbers have an obvious recursive definition, which translates \
into the Wolfram Language almost word for word.\
\>", "Text",ExpressionUUID->"86367cfb-aa88-4bae-a211-1b2b57e14d8f"],

Cell[CellGroupData[{

Cell["\<\
Clear[fibSlow];
fibSlow[0] = 0;
fibSlow[1] = 1;
fibSlow[n_Integer /; n > 1] := fibSlow[n - 1] + fibSlow[n - 2];
fibSlow[20]\
\>", "Input",
 CellLabel->
  "In[258]:=",ExpressionUUID->"43c6efa7-8164-4901-8302-b510deea724a"],

Cell[BoxData["6765"], "Output",
 CellChangeTimes->{3.996561952015462*^9},
 CellLabel->
  "Out[262]=",ExpressionUUID->"ff6ea651-dcc0-438f-841b-be9216120902"]
}, Open  ]],

Cell["\<\
The answer is right. The difficulty is what it cost. Computing fibSlow[20] \
required computing fibSlow[18] twice, fibSlow[17] three times, and so on down \
the tree, because nothing is remembered between calls.\
\>", "Text",ExpressionUUID->"d5a1fe30-2d47-4d62-b78b-09ba7e46cd7b"],

Cell[CellGroupData[{

Cell["Timing[fibSlow[25]]", "Input",
 CellLabel->
  "In[263]:=",ExpressionUUID->"625eba10-f2c5-4cb6-af23-707192fbb697"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.086151`", ",", "75025"}], "}"}]], "Output",
 CellChangeTimes->{3.996561955059683*^9},
 CellLabel->
  "Out[263]=",ExpressionUUID->"944dc01a-aef2-4bbd-a24e-3628e5f7b087"]
}, Open  ]],

Cell["\<\
Timing returns the seconds taken alongside the result. Adding five to the \
argument roughly multiplies the work by eleven, so the growth is exponential \
rather than linear.\
\>", "Text",ExpressionUUID->"a4350aea-744d-4009-ad7d-fa8416827dbd"],

Cell[CellGroupData[{

Cell["Timing[fibSlow[27]]", "Input",
 CellLabel->
  "In[264]:=",ExpressionUUID->"fa2f1bb7-2827-43f5-97d3-e916b8994e02"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.170766`", ",", "196418"}], "}"}]], "Output",
 CellChangeTimes->{3.996561957209634*^9},
 CellLabel->
  "Out[264]=",ExpressionUUID->"d653dd71-e7a0-4790-b3f6-b9f55142d673"]
}, Open  ]],

Cell["\<\
This is not a problem with recursion. It is a problem with recomputing, and \
the recursion is merely how the recomputation gets expressed.\
\>", "Text",ExpressionUUID->"f2a7161c-5fe4-44b5-a087-917154d4f33a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Memoization Idiom", "Subsubsection",ExpressionUUID->"22afc94a-19de-43e8-b583-523128ea6410"],

Cell["\<\
The fix is a single change: instead of returning the computed value, assign \
it back to the function first, and return the result of that assignment.\
\>", "Text",ExpressionUUID->"b584392b-4b87-4a71-8fb1-e25ab7bfbb9a"],

Cell[CellGroupData[{

Cell["\<\
Clear[fib];
fib[0] = 0;
fib[1] = 1;
fib[n_Integer /; n > 1] := fib[n] = fib[n - 1] + fib[n - 2];
fib[100]\
\>", "Input",
 CellLabel->
  "In[265]:=",ExpressionUUID->"e3578e11-841e-4db6-9fc0-4ae01b67ba55"],

Cell[BoxData["354224848179261915075"], "Output",
 CellChangeTimes->{3.99656195971439*^9},
 CellLabel->
  "Out[269]=",ExpressionUUID->"fab3e7df-e5d9-4147-ad21-7cbc8ca71f42"]
}, Open  ]],

Cell["\<\
The hundredth Fibonacci number returns immediately, where the naive version \
would not have finished within any usable time.
The mechanism is worth stating precisely. The body fib[n] = fib[n-1] + \
fib[n-2] is an assignment. When it runs for a particular n, it creates a new \
definition for that one value, and that definition is more specific than the \
general pattern, so every later call for the same n matches the stored value \
instead of running the body again.
The remembered values can be seen directly. They are ordinary definitions:\
\>", "Text",
 CellChangeTimes->{{3.996561963818081*^9, 
  3.996561964876245*^9}},ExpressionUUID->"69a16e2c-0d49-49a4-ad3b-\
811f00223ebf"],

Cell[CellGroupData[{

Cell["Length[DownValues[fib]]", "Input",
 CellLabel->
  "In[270]:=",ExpressionUUID->"9d2a0fb7-8e66-44ca-9ca4-020c43fd5cec"],

Cell[BoxData["102"], "Output",
 CellChangeTimes->{3.996561967831758*^9},
 CellLabel->
  "Out[270]=",ExpressionUUID->"195f1265-a241-408a-abc0-5ecb6bde67d5"]
}, Open  ]],

Cell["\<\
There is one definition for each value ever requested, plus the two base \
cases and the general rule. Computing something new adds to that store:\
\>", "Text",ExpressionUUID->"a34ff0cf-4f9a-4936-996d-480482444c5a"],

Cell[CellGroupData[{

Cell["\<\
fib[150];
Length[DownValues[fib]]\
\>", "Input",
 CellLabel->
  "In[271]:=",ExpressionUUID->"44c531a2-772e-4776-adf2-0622c3a1b1f2"],

Cell[BoxData["152"], "Output",
 CellChangeTimes->{3.9965619699126263`*^9},
 CellLabel->
  "Out[272]=",ExpressionUUID->"1fa2e39f-5527-4b53-b44e-eda7faf4eaf2"]
}, Open  ]],

Cell["\<\
This makes the trade-off explicit: the speed is bought with memory, and the \
memory is not released until the definitions are cleared.\
\>", "Text",ExpressionUUID->"9d696046-ced3-499d-86bf-c7f380d9945a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Comparing the Two", "Subsubsection",ExpressionUUID->"8f7443da-7198-44c4-bc04-27c4fc4fd4a2"],

Cell["\<\
Putting the two versions side by side on the same input shows the size of the \
difference.\
\>", "Text",ExpressionUUID->"0b0a6510-f2d1-44f7-bab7-05251a34b646"],

Cell[CellGroupData[{

Cell["Timing[fibSlow[27]]", "Input",
 CellLabel->
  "In[273]:=",ExpressionUUID->"505c6f6a-ad69-4cee-9872-0a74ca984262"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.174675`", ",", "196418"}], "}"}]], "Output",
 CellChangeTimes->{3.996561973064413*^9},
 CellLabel->
  "Out[273]=",ExpressionUUID->"6ab1f3a0-dfce-4444-ad86-62bb6415151f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Clear[fib2];
fib2[0] = 0;
fib2[1] = 1;
fib2[n_Integer /; n > 1] := fib2[n] = fib2[n - 1] + fib2[n - 2];
Timing[fib2[27]]\
\>", "Input",
 CellLabel->
  "In[274]:=",ExpressionUUID->"976aee0c-5fbf-4dce-b089-c24b8047d797"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.000167`", ",", "196418"}], "}"}]], "Output",
 CellChangeTimes->{3.996561974699061*^9},
 CellLabel->
  "Out[278]=",ExpressionUUID->"1b18b590-f1c7-463d-bc2d-01681412f883"]
}, Open  ]],

Cell["\<\
The memoized version does linear work, because each value from two upwards is \
computed exactly once. The naive version does exponential work for the same \
answer.
Note that the second timing must be taken on a freshly cleared function. \
Running a memoized function twice and timing the second run measures a lookup \
rather than a computation, which is a genuinely easy mistake to make when \
benchmarking:\
\>", "Text",
 CellChangeTimes->{
  3.996561976472418*^9},ExpressionUUID->"18b991e0-79a1-4775-941d-\
5d155a332597"],

Cell[CellGroupData[{

Cell["Timing[fib2[27]]", "Input",
 CellLabel->
  "In[279]:=",ExpressionUUID->"aec63ec1-198b-4201-9aa3-e95f2651e46e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.000015`", ",", "196418"}], "}"}]], "Output",
 CellChangeTimes->{3.996561980029263*^9},
 CellLabel->
  "Out[279]=",ExpressionUUID->"66a70806-9cac-4b8d-8077-18633ae553d0"]
}, Open  ]],

Cell["\<\
That second measurement is effectively zero, and says nothing at all about \
how long the computation takes.\
\>", "Text",ExpressionUUID->"e3875c15-52d8-4ad0-a570-2667819573a6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Clearing Remembered Values", "Subsubsection",ExpressionUUID->"46b05a3a-c51d-4c75-9872-5fda2b7ad406"],

Cell["\<\
Because remembered values are definitions, they persist for the whole \
session. That is usually what is wanted, but it causes trouble when the \
function is edited, since the old stored values do not know the rule has \
changed.\
\>", "Text",ExpressionUUID->"5a9d6040-9b46-4316-92d7-fe461a800d0e"],

Cell["\<\
A function memoized with one rule, then given a different rule without \
clearing:\
\>", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"1ad7771f-8e58-41ff-9b5e-d468234ceeb3"],

Cell[CellGroupData[{

Cell["\<\
Clear[g];
g[n_] := g[n] = 10*n;
g[3];
g[n_] := g[n] = 100*n;
g[3]\
\>", "Input",
 CellLabel->
  "In[280]:=",ExpressionUUID->"0ce49f19-3ea6-41d3-ad90-b502d655a232"],

Cell[BoxData["30"], "Output",
 CellChangeTimes->{3.996561984932397*^9},
 CellLabel->
  "Out[284]=",ExpressionUUID->"c235dd4e-3157-401a-b9fd-1f1f3302bf23"]
}, Open  ]],

Cell["\<\
The answer is thirty, from the old rule, because the stored definition for \
the argument three is more specific than the new general one and is still \
matched first. Clearing the symbol removes both the stored values and the \
definition, so the function must then be defined again:\
\>", "Text",ExpressionUUID->"acf58498-8fca-4aa7-9e45-c4ac3dea4256"],

Cell[CellGroupData[{

Cell["\<\
Clear[g];
g[n_] := g[n] = 100*n;
g[3]\
\>", "Input",
 CellLabel->
  "In[285]:=",ExpressionUUID->"99534bd8-5407-40de-9e4d-2cdff99cd236"],

Cell[BoxData["300"], "Output",
 CellChangeTimes->{3.996561987681377*^9},
 CellLabel->
  "Out[287]=",ExpressionUUID->"aac848bc-99f0-4dbb-ab7f-da0e3ea9c51d"]
}, Open  ]],

Cell["\<\
This is the same stale definition problem met in the Functions section, made \
more likely by memoization because the function is writing definitions \
itself. When a memoized function gives an answer that its source code could \
not produce, the stored values are the first place to look.\
\>", "Text",ExpressionUUID->"f14e4df4-566d-45f5-a8df-c5d993f829b3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Example 1: Counting Paths Through a Grid", "Subsubsection",ExpressionUUID->"c53151aa-fee2-4fe2-b29f-f070a95d5642"],

Cell["\<\
This is the standard dynamic programming problem: count the routes from one \
corner of a grid to the opposite corner, moving only right or down. Each cell \
is reachable from the cell above it and the cell to its left.\
\>", "Text",ExpressionUUID->"64100b3d-13dc-467a-84c0-9d04f58326c4"],

Cell["The recursion, with the edges of the grid as base cases:", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"e8cc7dcc-5fec-4ceb-bb71-9a281af0d9ee"],

Cell[CellGroupData[{

Cell["\<\
Clear[paths];
paths[1, _] := 1;
paths[_, 1] := 1;
paths[m_Integer, n_Integer] := paths[m, n] = paths[m - 1, n] + paths[m, n - 1];
paths[3, 3]\
\>", "Input",
 CellLabel->
  "In[288]:=",ExpressionUUID->"48dfd893-30ff-48b7-a073-5108800303c0"],

Cell[BoxData["6"], "Output",
 CellChangeTimes->{3.996561995262515*^9},
 CellLabel->
  "Out[292]=",ExpressionUUID->"03774d79-3b55-46ce-9903-b4d5890b6e0d"]
}, Open  ]],

Cell["\<\
Six routes cross a three by three grid. The sub problems overlap heavily, \
which is what makes this worth memoizing: the cell in the middle is reached \
from two directions, and without memoization its own count would be worked \
out twice.\
\>", "Text",
 CellChangeTimes->{
  3.996561998350122*^9},ExpressionUUID->"e1f9a758-dc0b-4e56-94e6-\
38e7a6435d62"],

Cell[CellGroupData[{

Cell["paths[15, 15]", "Input",
 CellLabel->
  "In[293]:=",ExpressionUUID->"2a5eb8ec-5f73-4345-8ca4-2acd9c828b6a"],

Cell[BoxData["40116600"], "Output",
 CellChangeTimes->{3.996562002177668*^9},
 CellLabel->
  "Out[293]=",ExpressionUUID->"f4b2ac93-2591-4741-ba1b-a23e33a4a6d5"]
}, Open  ]],

Cell["\<\
A fifteen by fifteen grid is answered immediately. Without the stored values \
the same call would branch into millions of repeated computations.

The number of stored definitions is close to the number of cells in the grid, \
which is the signature of a dynamic programming solution: the work is \
proportional to the number of distinct subproblems rather than to the number \
of paths through them.\
\>", "Text",ExpressionUUID->"e356813c-30ac-4f56-8484-99f6538f69bd"],

Cell[CellGroupData[{

Cell["Length[DownValues[paths]]", "Input",
 CellLabel->
  "In[294]:=",ExpressionUUID->"7f3d1bb6-b203-4604-bdca-e367881268d6"],

Cell[BoxData["199"], "Output",
 CellChangeTimes->{3.9965620046500998`*^9},
 CellLabel->
  "Out[294]=",ExpressionUUID->"bb3d656c-78ca-4ce3-a448-883096f0d74b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Example 2: Top-Down and Bottom-Up", "Subsubsection",ExpressionUUID->"75d7b7b9-d09b-4224-a6c2-7fe7975f727c"],

Cell["\<\
Memoized recursion is called top-down: it starts from the answer wanted and \
works downwards, computing sub problems as they turn out to be needed. \
Dynamic programming proper is usually written bottom-up, filling in every sub \
problem in order from the smallest.\
\>", "Text",
 CellChangeTimes->{{3.99656201387652*^9, 
  3.9965620161807213`*^9}},ExpressionUUID->"799d98e7-2720-4deb-8064-\
070552334ef4"],

Cell["Top-down, with memoization doing the remembering:", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"ad030b23-052f-4a6c-904f-7583d75a3fd6"],

Cell[CellGroupData[{

Cell["\<\
Clear[fibTop];
fibTop[0] = 0;
fibTop[1] = 1;
fibTop[n_Integer /; n > 1] := fibTop[n] = fibTop[n - 1] + fibTop[n - 2];
fibTop[30]\
\>", "Input",
 CellLabel->
  "In[295]:=",ExpressionUUID->"c35898f9-f8c7-4940-9f50-107282dd2062"],

Cell[BoxData["832040"], "Output",
 CellChangeTimes->{3.9965620245314903`*^9},
 CellLabel->
  "Out[299]=",ExpressionUUID->"a3a78852-c11f-41d8-a2cf-37c5fd3e31be"]
}, Open  ]],

Cell["\<\
Bottom-up, building the whole table in order and taking the last entry:\
\>", "Text",ExpressionUUID->"9f4a955f-7dcf-450d-bc08-d49a4e0329ea"],

Cell[CellGroupData[{

Cell["Last[NestList[{#[[2]], #[[1]] + #[[2]]} &, {0, 1}, 30]][[1]]", "Input",
 CellLabel->
  "In[300]:=",ExpressionUUID->"fc5b0b42-ef6a-4214-b037-40f9958e574d"],

Cell[BoxData["832040"], "Output",
 CellChangeTimes->{3.996562026630991*^9},
 CellLabel->
  "Out[300]=",ExpressionUUID->"cebce8f3-a791-48f8-a83c-7921be5e958f"]
}, Open  ]],

Cell["\<\
Both give the thirtieth Fibonacci number. The top-down version reads like the \
mathematical definition and only computes what it needs. The bottom-up \
version keeps no definitions at all, so it uses constant memory rather than \
storing every intermediate value.

Which to prefer depends on the problem. When most sub problems are needed \
anyway, bottom-up is tidier and avoids filling the session with definitions. \
When only a scattered few are needed, top-down avoids computing the rest \
entirely.\
\>", "Text",
 CellChangeTimes->{
  3.996562029357469*^9},ExpressionUUID->"9b967bbc-5426-4cf8-bf68-\
0536473f8e3b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Example 3: Binomial Coefficients from Pascal's Rule", "Subsubsection",ExpressionUUID->"6682b3ac-6b66-468a-86c0-96037b087db0"],

Cell["\<\
Pascal's rule defines each binomial coefficient in terms of two smaller ones, \
which is another recursion with heavily overlapping subproblems.\
\>", "Text",ExpressionUUID->"6a33c70a-1ef1-48f0-8806-df5c57e2a391"],

Cell["The rule, with the edges of the triangle as base cases:", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"b9c0dd59-9001-4d9e-a981-9205907ea019"],

Cell[CellGroupData[{

Cell["\<\
Clear[binom];
binom[n_, 0] := 1;
binom[n_, n_] := 1;
binom[n_Integer, k_Integer] := binom[n, k] = binom[n - 1, k - 1] + binom[n - \
1, k];
binom[5, 2]\
\>", "Input",
 CellLabel->
  "In[301]:=",ExpressionUUID->"4e6ab968-e3c3-499f-91bc-295a25a7afc0"],

Cell[BoxData["10"], "Output",
 CellChangeTimes->{3.9965620338293743`*^9},
 CellLabel->
  "Out[305]=",ExpressionUUID->"093fa4ee-1ef2-4199-8283-c3e8396c067c"]
}, Open  ]],

Cell["\<\
The second base case uses the same pattern name twice, which matches only \
when both arguments are equal. This is how the diagonal edge of the triangle \
is expressed without a condition.\
\>", "Text",ExpressionUUID->"9bd3fb4b-f9ff-4cde-b369-81d2a7a190d1"],

Cell[CellGroupData[{

Cell["binom[30, 15]", "Input",
 CellLabel->
  "In[306]:=",ExpressionUUID->"b65ff65a-420c-4a66-b64c-ff23a3b7a5ed"],

Cell[BoxData["155117520"], "Output",
 CellChangeTimes->{3.996562035929532*^9},
 CellLabel->
  "Out[306]=",ExpressionUUID->"f8d1e0d9-09e5-41cc-841f-837d09984d10"]
}, Open  ]],

Cell["\<\
The result agrees with the built-in function, which is the check worth making \
whenever a familiar quantity has been reimplemented:\
\>", "Text",ExpressionUUID->"7f081a26-ee31-4c71-86fd-5588ff9e4dc8"],

Cell[CellGroupData[{

Cell["{binom[30, 15], Binomial[30, 15]}", "Input",
 CellLabel->
  "In[307]:=",ExpressionUUID->"0bcc0805-13b8-48c6-82fa-29e31722b092"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"155117520", ",", "155117520"}], "}"}]], "Output",
 CellChangeTimes->{3.996562038048829*^9},
 CellLabel->
  "Out[307]=",ExpressionUUID->"4d92a968-514d-49d6-a781-b3b695553611"]
}, Open  ]]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Basic Sorting Algorithms", "Section",ExpressionUUID->"e2e73d3a-51fc-4418-ae95-14e95b954fd5"],

Cell["\<\
The Wolfram Language has a built-in Sort, and in real work it should always \
be used. Writing sorting algorithms out by hand is worth doing for a \
different reason: it is the clearest way to see how an algorithm's structure \
determines how long it takes, and how the same algorithm looks when written \
functionally rather than as a loop.
Insertion sort and bubble sort are the two simplest comparison sorts. Both do \
work proportional to the square of the number of elements, which makes them \
poor choices for large data and good choices for understanding what a sorting \
algorithm actually does.\
\>", "Text",
 CellChangeTimes->{{3.99656205781395*^9, 
  3.996562060650654*^9}},ExpressionUUID->"479e56b5-11ac-4477-b8f6-\
53170cbc42ac"],

Cell[CellGroupData[{

Cell["Insertion Sort", "Subsubsection",ExpressionUUID->"1e209857-d95f-4d11-ad4f-5c4f0930a4eb"],

Cell["\<\
Insertion sort keeps a sorted region and grows it one element at a time. The \
whole algorithm follows from a single operation: inserting one value into a \
list that is already sorted.\
\>", "Text",ExpressionUUID->"b996b3ba-0fb5-4f78-b956-1eb13916730f"],

Cell["\<\
The insertion step. LengthWhile counts how many leading elements are smaller \
than or equal to the new value, which is exactly the position it belongs \
after.\
\>", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"3c5a472f-7810-4e3f-845a-c384d2070223"],

Cell[CellGroupData[{

Cell["\<\
Clear[insertInto];
insertInto[sorted_List, x_] := Insert[sorted, x, LengthWhile[sorted, # <= x \
&] + 1];
insertInto[{1, 3, 5, 7}, 4]\
\>", "Input",
 CellLabel->
  "In[308]:=",ExpressionUUID->"c6f454ad-0cf9-48b3-910a-37e2ff01acef"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "3", ",", "4", ",", "5", ",", "7"}], "}"}]], "Output",
 CellChangeTimes->{3.996562063401376*^9},
 CellLabel->
  "Out[310]=",ExpressionUUID->"7cc2da80-2598-4c93-80c0-76fbd13af66a"]
}, Open  ]],

Cell["\<\
The value four went between three and five, and the list is still sorted. \
Inserting at either end works without any special case:\
\>", "Text",ExpressionUUID->"9d745ceb-eefb-4274-9819-201550bb2572"],

Cell[CellGroupData[{

Cell["{insertInto[{1, 3, 5}, 0], insertInto[{1, 3, 5}, 9]}", "Input",
 CellLabel->
  "In[311]:=",ExpressionUUID->"924ec10f-b237-4a02-b699-ebc584b3efd6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "3", ",", "5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3", ",", "5", ",", "9"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.996562065785399*^9},
 CellLabel->
  "Out[311]=",ExpressionUUID->"6936c5a9-5999-4feb-83d8-065286919fcb"]
}, Open  ]],

Cell["\<\
The sort itself is now just this step applied to every element in turn, \
starting from an empty list. Fold is the function that does exactly that: it \
carries a result along, combining it with each element of a list in order.\
\>", "Text",ExpressionUUID->"15a98846-9648-46a1-a4a7-526b6a720097"],

Cell[CellGroupData[{

Cell["\<\
Clear[insertionSort];
insertionSort[lst_List] := Fold[insertInto, {}, lst];
insertionSort[{5, 2, 8, 1, 9, 3}]\
\>", "Input",
 CellLabel->
  "In[312]:=",ExpressionUUID->"50aaaeb3-e3a2-4a2b-85e6-e9b77f087f43"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3", ",", "5", ",", "8", ",", "9"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.996562069636302*^9},
 CellLabel->
  "Out[314]=",ExpressionUUID->"d9b94e32-3cd2-4cee-be09-0a91d0af5b42"]
}, Open  ]],

Cell["\<\
The same algorithm can be written recursively, which makes the structure of \
the argument clearer: to sort a list, sort everything but the last element, \
then insert that last element into the result.\
\>", "Text",ExpressionUUID->"67565ef6-c6f6-4ff8-a640-245c44dcdd66"],

Cell[CellGroupData[{

Cell["\<\
Clear[insertionSortR];
insertionSortR[{}] := {};
insertionSortR[lst_List] := insertInto[insertionSortR[Most[lst]], Last[lst]];
insertionSortR[{5, 2, 8, 1, 9, 3}]\
\>", "Input",
 CellLabel->
  "In[315]:=",ExpressionUUID->"eafa4cb4-1330-4b3f-8d47-2c715b7232b3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3", ",", "5", ",", "8", ",", "9"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.996562071903057*^9},
 CellLabel->
  "Out[318]=",ExpressionUUID->"fafd41db-970d-4300-bd0f-bc8684948fa7"]
}, Open  ]],

Cell["\<\
Both versions do the same work in the same order. The Fold version is shorter \
and the recursive version is closer to how the algorithm is usually stated; \
neither is more correct than the other.\
\>", "Text",ExpressionUUID->"d008a4d6-3ea5-4719-b980-496e5caa624a"]
}, Closed]],

Cell[CellGroupData[{

Cell["Bubble Sort", "Subsubsection",ExpressionUUID->"acf72f4e-23c7-4ef7-9b43-12015abf315b"],

Cell["\<\
Bubble sort works differently. It repeatedly walks the list comparing \
neighboring pairs and swapping them when they are in the wrong order. Each \
full pass moves the largest remaining value to its final position, which is \
where the name comes from.\
\>", "Text",
 CellChangeTimes->{
  3.9965620938782177`*^9},ExpressionUUID->"63177f20-9cf2-4fa5-95ad-\
970c651da1e6"],

Cell["\<\
One pass. The swap uses a part assignment with two positions at once, which \
exchanges them without needing a temporary variable.\
\>", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"00149ab3-bf7b-415c-923d-5729a3c5e5d2"],

Cell[CellGroupData[{

Cell["\<\
Clear[bubblePass];
bubblePass[lst_List] := Module[{l = lst},
  Do[If[l[[i]] > l[[i + 1]], l[[{i, i + 1}]] = l[[{i + 1, i}]]], {i, \
Length[l] - 1}];
  l];
bubblePass[{5, 2, 8, 1}]\
\>", "Input",
 CellLabel->
  "In[319]:=",ExpressionUUID->"bfe6a1dc-5f6a-4a6e-8139-8cc20c625988"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "5", ",", "1", ",", "8"}], "}"}]], "Output",
 CellChangeTimes->{3.996562079187538*^9},
 CellLabel->
  "Out[321]=",ExpressionUUID->"aa4301ac-d39b-4e72-b4b9-fe9a416b9bc0"]
}, Open  ]],

Cell["\<\
One pass has not sorted the list, but the largest value has reached the end. \
Running another pass moves the next largest into place:\
\>", "Text",ExpressionUUID->"32698415-0418-4aec-b6db-62615af03b1b"],

Cell[CellGroupData[{

Cell["bubblePass[bubblePass[{5, 2, 8, 1}]]", "Input",
 CellLabel->
  "In[322]:=",ExpressionUUID->"ae5b160d-6f8f-4e2b-82f0-99035b654cdf"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "1", ",", "5", ",", "8"}], "}"}]], "Output",
 CellChangeTimes->{3.996562081708519*^9},
 CellLabel->
  "Out[322]=",ExpressionUUID->"e0659d36-07e4-49dc-91b5-c25a85a4bc75"]
}, Open  ]],

Cell["\<\
Rather than counting how many passes are needed, the sort can simply repeat \
until a pass changes nothing. That is a fixed point, so FixedPoint expresses \
the whole algorithm:\
\>", "Text",ExpressionUUID->"db9f551e-66ce-438f-971b-bbfd3f0176c4"],

Cell[CellGroupData[{

Cell["\<\
Clear[bubbleSort];
bubbleSort[lst_List] := FixedPoint[bubblePass, lst];
bubbleSort[{5, 2, 8, 1, 9, 3}]\
\>", "Input",
 CellLabel->
  "In[323]:=",ExpressionUUID->"f7bec852-c0f1-4b6c-aec4-64dcaae3657d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3", ",", "5", ",", "8", ",", "9"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.996562084375292*^9},
 CellLabel->
  "Out[325]=",ExpressionUUID->"30e4b68a-9361-4f2e-bf97-da138b8cd5d9"]
}, Open  ]],

Cell["\<\
Using a fixed point rather than a fixed number of passes also gives the \
algorithm its one redeeming property: a list that is already sorted is \
finished after a single pass, because that pass changes nothing.\
\>", "Text",ExpressionUUID->"c5fd2f41-3d71-4e7c-8aed-8aeeb149bde2"],

Cell[CellGroupData[{

Cell["Length[FixedPointList[bubblePass, {1, 2, 3, 4, 5}]]", "Input",
 CellLabel->
  "In[326]:=",ExpressionUUID->"0318bc27-044f-409b-8eae-aac75f3a477a"],

Cell[BoxData["2"], "Output",
 CellChangeTimes->{3.996562087357026*^9},
 CellLabel->
  "Out[326]=",ExpressionUUID->"6497edf6-b014-4652-aa3f-15a27f6ac210"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Example : Watching Insertion Sort Work", "Subsubsection",
 CellChangeTimes->{
  3.996562131395156*^9},ExpressionUUID->"cd5d4fee-ef53-4452-8784-\
cb765f66ee52"],

Cell["\<\
Fold produces only the final answer. FoldList keeps every intermediate \
result, which turns the sort into a visible record of its own progress.\
\>", "Text",ExpressionUUID->"abf6932c-20dc-496a-a51d-a6b075c529ff"],

Cell["The sorted region after each element is inserted:", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"376c0c21-668a-445e-8678-05baa9231d28"],

Cell[CellGroupData[{

Cell["FoldList[insertInto, {}, {5, 2, 8, 1, 9, 3}]", "Input",
 CellLabel->
  "In[327]:=",ExpressionUUID->"e48a64ad-9b54-488f-b0ef-1cbd67a583cc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "5", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "5", ",", "8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "5", ",", "8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "5", ",", "8", ",", "9"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3", ",", "5", ",", "8", ",", "9"}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.9965621257775793`*^9},
 CellLabel->
  "Out[327]=",ExpressionUUID->"061af050-f85c-4cb9-b824-ce93e91e2f09"]
}, Open  ]],

Cell["\<\
Each line is the previous line with one more value put in its correct place, \
and every line is sorted. That invariant, that the accumulated region is \
always sorted, is what makes the algorithm correct.

The same view of bubble sort shows a different picture, because its \
intermediate states are not sorted:\
\>", "Text",ExpressionUUID->"3d168d29-5e8b-45c6-bdf9-97fa4bf71ed0"],

Cell[CellGroupData[{

Cell["FixedPointList[bubblePass, {5, 2, 8, 1, 9, 3}]", "Input",
 CellLabel->
  "In[328]:=",ExpressionUUID->"3541fd4d-0621-4305-a530-c571c79b0546"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"5", ",", "2", ",", "8", ",", "1", ",", "9", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "5", ",", "1", ",", "8", ",", "3", ",", "9"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1", ",", "5", ",", "3", ",", "8", ",", "9"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3", ",", "5", ",", "8", ",", "9"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3", ",", "5", ",", "8", ",", "9"}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.9965621287254057`*^9},
 CellLabel->
  "Out[328]=",ExpressionUUID->"5c5009d9-0d8a-4b11-83c5-1a3cfba960a3"]
}, Open  ]],

Cell["\<\
Here the largest value reaches the end after the first pass, the next largest \
after the second, and so on. The sorted region grows from the right rather \
than from the left, and the final line is a repeat because it is the pass \
that changed nothing and ended the iteration.\
\>", "Text",ExpressionUUID->"41a07c03-18c0-4b69-a74b-5b538a548713"]
}, Closed]],

Cell[CellGroupData[{

Cell["Example : Sorting by a Key", "Subsubsection",
 CellChangeTimes->{
  3.996562158301448*^9},ExpressionUUID->"a967cdd2-657c-4f4d-85fc-\
325466ac5cda"],

Cell["\<\
An algorithm written for numbers can usually be generalized to arbitrary data \
by making the comparison an argument rather than fixing it in the code.\
\>", "Text",
 CellChangeTimes->{
  3.9965621399284763`*^9},ExpressionUUID->"86ab31bf-07c6-4247-878e-\
30b2464ccd0b"],

Cell["\<\
An insertion step that compares a computed key instead of the value itself:\
\>", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"aa3df060-5e78-49d1-85e5-5ab9da2191fa"],

Cell["\<\
Clear[insertBy];
insertBy[sorted_List, x_, key_] := Insert[sorted, x, LengthWhile[sorted, \
key[#] <= key[x] &] + 1];\
\>", "Input",
 CellLabel->
  "In[329]:=",ExpressionUUID->"f629ef6b-3625-4809-a040-6d2458230591"],

Cell["\<\
The sort is unchanged apart from passing the key function through:\
\>", "Text",ExpressionUUID->"a8d26132-cdb9-4d45-aa4b-c82bf7d95da8"],

Cell["\<\
Clear[insertionSortBy];
insertionSortBy[lst_List, key_] := Fold[insertBy[#1, #2, key] &, {}, lst];\
\>", "Input",
 CellLabel->
  "In[331]:=",ExpressionUUID->"b6ccca06-85f9-4aa3-a088-8113f27bb5d9"],

Cell["Sorting records by their second field:", "Text",ExpressionUUID->"8a0efd62-6eed-4cdf-aadc-0109a3ac3bbf"],

Cell[CellGroupData[{

Cell["\<\
insertionSortBy[{{\"ann\", 72}, {\"raj\", 91}, {\"mo\", 65}}, Last]\
\>", "Input",
 CellLabel->
  "In[333]:=",ExpressionUUID->"fc3a9b43-8b68-45f1-a2ae-96fe29452284"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\<\"mo\"\>", ",", "65"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"ann\"\>", ",", "72"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"raj\"\>", ",", "91"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9965621515095043`*^9},
 CellLabel->
  "Out[333]=",ExpressionUUID->"0a1c34df-0b96-4ea1-9795-8754c28fe69b"]
}, Open  ]],

Cell["\<\
The result matches what the built-in SortBy produces, which is the check \
worth making:\
\>", "Text",ExpressionUUID->"5d6cda85-6cad-496d-ad24-6bfb87f89742"],

Cell[CellGroupData[{

Cell["\<\
marks = {{\"ann\", 72}, {\"raj\", 91}, {\"mo\", 65}};
insertionSortBy[marks, Last] === SortBy[marks, Last]\
\>", "Input",
 CellLabel->
  "In[334]:=",ExpressionUUID->"eb772896-629b-4712-acbd-24466998fca4"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.9965621537080717`*^9},
 CellLabel->
  "Out[335]=",ExpressionUUID->"334ea53b-b3e4-4401-8073-b36ef7b504ba"]
}, Open  ]],

Cell["\<\
Passing the comparison in rather than hard-coding it is what separates a \
demonstration from a usable routine, and it costs almost nothing to do.\
\>", "Text",ExpressionUUID->"737ed6dc-6aaa-47af-ad0d-7a479f69252e"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Graph Algorithms", "Section",ExpressionUUID->"52f7a138-163f-4f62-b498-15144754abb3"],

Cell["\<\
A graph is a set of nodes together with connections between them. Almost any \
problem involving relationships can be expressed as one: routes between \
places, dependencies between tasks, links between pages.
Traversal is the foundation of everything else. Breadth-first search explores \
outwards in layers, visiting everything one step away before anything two \
steps away. Depth-first search follows one path as far as it goes before \
backtracking. Nearly every other graph algorithm is one of these two with \
extra bookkeeping attached.\
\>", "Text",
 CellChangeTimes->{{3.996562179743401*^9, 
  3.9965621823281193`*^9}},ExpressionUUID->"0de8fb62-8048-4ef8-94e9-\
dcb335c2b7d2"],

Cell[CellGroupData[{

Cell["Representing a Graph", "Subsubsection",ExpressionUUID->"ad475c91-ac2b-4446-a317-ef67b13e7d2f"],

Cell["\<\
The most convenient representation for these algorithms is an adjacency list: \
each node is a key, and its value is the list of nodes it connects to. An \
Association holds this directly.\
\>", "Text",ExpressionUUID->"11fdf54f-f0e7-4daf-956a-72794f0c5aa0"],

Cell["\<\
A small directed graph. Node 1 leads to 2 and 3, both of which lead to 4.\
\>", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"ec0669ea-3aeb-4e34-b05c-91f4c2f3262d"],

Cell["g = <|1 -> {2, 3}, 2 -> {4}, 3 -> {4}, 4 -> {}|>;", "Input",
 CellLabel->
  "In[336]:=",ExpressionUUID->"73f1da52-e483-4abb-aba8-e6a642fed78c"],

Cell["\<\
The neighbors of a node are then a single lookup. Using Lookup with a default \
of the empty list means a node with no outgoing edges, or one not listed at \
all, causes no trouble:\
\>", "Text",
 CellChangeTimes->{
  3.996562295544375*^9},ExpressionUUID->"5c8d3bfc-8859-4ee2-8b56-\
84f183614bf2"],

Cell[CellGroupData[{

Cell["{Lookup[g, 1, {}], Lookup[g, 4, {}], Lookup[g, 99, {}]}", "Input",
 CellLabel->
  "In[337]:=",ExpressionUUID->"b76b0dab-23e1-4c80-8c14-af464133bb33"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.996562299226593*^9},
 CellLabel->
  "Out[337]=",ExpressionUUID->"bef849df-299d-42c9-a4ce-27cc64a385ed"]
}, Open  ]],

Cell["\<\
That default matters more than it looks. Without it, reaching a node that was \
never given a key returns a Missing object, and the traversal fails partway \
through on a graph that is otherwise perfectly valid.

An undirected graph is the same structure with every edge listed in both \
directions:\
\>", "Text",ExpressionUUID->"3d984f38-a186-4795-9695-9b37184265bb"],

Cell[CellGroupData[{

Cell["\<\
u = <|\"a\" -> {\"b\", \"c\"}, \"b\" -> {\"a\", \"d\"}, \"c\" -> {\"a\"}, \"d\
\" -> {\"b\"}|>;
Keys[u]\
\>", "Input",
 CellLabel->
  "In[338]:=",ExpressionUUID->"b4da773f-0c93-4b78-93b5-1667a0060a94"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"a\"\>", ",", "\<\"b\"\>", ",", "\<\"c\"\>", ",", "\<\"d\"\>"}],
   "}"}]], "Output",
 CellChangeTimes->{3.996562301828659*^9},
 CellLabel->
  "Out[339]=",ExpressionUUID->"c7c6d4ee-cb08-4d9b-867e-6ec0360e5c23"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Breadth-First Search", "Subsubsection",ExpressionUUID->"6df1cc46-e0dc-43fa-90cf-14ee85ed2ea9"],

Cell["\<\
Breadth-first search visits every node reachable from a starting point, in \
order of distance. It keeps a queue of nodes waiting to be explored and a \
record of what has already been seen. Taking work from the front of the queue \
and adding new work to the back is what produces the layer-by-layer order.\
\>", "Text",ExpressionUUID->"6d70f6a8-4ae4-4fb2-be18-aea78792cd14"],

Cell["\<\
Clear[bfs];
bfs[graph_, start_] := Module[{visited = {start}, queue = {start}, node},
  While[queue =!= {},
   node = First[queue];
   queue = Rest[queue];
   Do[If[! MemberQ[visited, nbr],
     visited = Append[visited, nbr];
     queue = Append[queue, nbr]],
    {nbr, Lookup[graph, node, {}]}]];
  visited];\
\>", "Input",
 CellLabel->
  "In[340]:=",ExpressionUUID->"b5f6dedf-faac-40de-877e-fbae87521393"],

Cell["Running it from node 1 reaches everything:", "Text",ExpressionUUID->"eab4757d-34c3-4e86-8de0-f8cee4a06b6e"],

Cell[CellGroupData[{

Cell["bfs[g, 1]", "Input",
 CellLabel->
  "In[342]:=",ExpressionUUID->"e3802758-f6fd-43e8-8c5a-4154eeaa0866"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}]], "Output",
 CellChangeTimes->{3.996562325111424*^9},
 CellLabel->
  "Out[342]=",ExpressionUUID->"74e4d49c-ce0a-4e0a-9106-3c72e58032ca"]
}, Open  ]],

Cell["\<\
Node 1 came first, then its two immediate neighbors 2 and 3, then 4, which is \
two steps away. That is the defining property: nodes appear in order of \
distance from the start.
Starting elsewhere reaches only what is reachable from there, which in a \
directed graph is usually less than the whole graph:\
\>", "Text",
 CellChangeTimes->{{3.9965623305737267`*^9, 
  3.996562333713606*^9}},ExpressionUUID->"c07158d3-8943-43a5-b131-\
5eb2dcb99184"],

Cell[CellGroupData[{

Cell["bfs[g, 2]", "Input",
 CellLabel->
  "In[343]:=",ExpressionUUID->"49d60d32-b593-4370-9731-f480944e7233"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "4"}], "}"}]], "Output",
 CellChangeTimes->{3.996562328637204*^9},
 CellLabel->
  "Out[343]=",ExpressionUUID->"8593d7ff-f669-4319-beba-e2f9c4c573f9"]
}, Open  ]],

Cell["\<\
The visited check is what makes this terminate. Without it, a graph \
containing a cycle would send the search round the loop forever, which is \
worth confirming on a graph that has one:\
\>", "Text",ExpressionUUID->"d771bbd4-4324-4532-938c-4f5d053a0b6e"],

Cell[CellGroupData[{

Cell["\<\
cyclic = <|1 -> {2}, 2 -> {3}, 3 -> {1}|>;
bfs[cyclic, 1]\
\>", "Input",
 CellLabel->
  "In[344]:=",ExpressionUUID->"98680e96-2e88-476f-8d3a-a2f51cb01d81"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output",
 CellChangeTimes->{3.996562336328393*^9},
 CellLabel->
  "Out[345]=",ExpressionUUID->"385828f3-f0b3-4eb7-a5ed-1a2c16b877da"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Depth-First Search", "Subsubsection",ExpressionUUID->"7770227d-ce69-4d18-8624-b30ee0f758b1"],

Cell["\<\
Depth-first search follows one path as far as it can before backing up. Its \
natural expression is recursive, because the call stack already does the \
backtracking that would otherwise need an explicit stack.\
\>", "Text",ExpressionUUID->"4dd6189c-bba8-483e-b576-7a8b06537e70"],

Cell["\<\
Clear[dfs];
dfs[graph_, start_] := Module[{visited = {}, visit},
  visit[node_] := If[! MemberQ[visited, node],
    visited = Append[visited, node];
    Do[visit[nbr], {nbr, Lookup[graph, node, {}]}]];
  visit[start];
  visited];\
\>", "Input",
 CellLabel->
  "In[346]:=",ExpressionUUID->"a5696402-c63f-48ba-91cf-9824037a1349"],

Cell[CellGroupData[{

Cell["dfs[g, 1]", "Input",
 CellLabel->
  "In[348]:=",ExpressionUUID->"2fccd34d-0c00-480d-9d4f-262ea2210aa9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "4", ",", "3"}], "}"}]], "Output",
 CellChangeTimes->{3.9965623425415583`*^9},
 CellLabel->
  "Out[348]=",ExpressionUUID->"6a5e9fbc-31c3-4216-832b-82236fef0355"]
}, Open  ]],

Cell["\<\
The order differs from breadth-first search on the same graph. Here the \
search went from 1 to 2, then straight down to 4, and only came back for 3 \
once that path was exhausted.
Note that the helper function visit is declared in the Module's variable \
list, alongside visited. This is not optional. Defined outside the list it \
would be a global symbol, and two searches running on different graphs would \
overwrite one another's definition. It is the same scoping point made in the \
Scoping section, in the setting where it actually bites.
The two traversals visit the same set of nodes, and differ only in order:\
\>", "Text",
 CellChangeTimes->{{3.996562346073435*^9, 
  3.99656234727721*^9}},ExpressionUUID->"af20a260-9404-4001-9675-\
b3c27305b618"],

Cell[CellGroupData[{

Cell["{Sort[bfs[g, 1]], Sort[dfs[g, 1]]}", "Input",
 CellLabel->
  "In[349]:=",ExpressionUUID->"465a4fb6-c0f2-46a5-8a44-0833ee66a100"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.996562349641293*^9},
 CellLabel->
  "Out[349]=",ExpressionUUID->"857eecc7-ce06-41ef-9457-f2133925ca91"]
}, Open  ]],

Cell["\<\
That equality is a useful check on an implementation: any correct traversal \
must reach exactly the reachable set, whatever order it does so in.\
\>", "Text",ExpressionUUID->"17887423-097c-4203-ac93-9d98274c1ad7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Shortest Path Lengths", "Subsubsection",ExpressionUUID->"c4fc1078-df00-4796-93da-898b67e423c7"],

Cell["\<\
Because breadth-first search visits nodes in order of distance, it computes \
shortest path lengths almost for free. The only change is to record, for each \
node, one more than the distance of the node it was reached from.\
\>", "Text",ExpressionUUID->"0a9691d7-7f81-412f-8bb8-42d8ca609a76"],

Cell["\<\
Clear[distances];
distances[graph_, start_] := Module[{dist = <|start -> 0|>, queue = {start}, \
node, d},
  While[queue =!= {},
   node = First[queue];
   queue = Rest[queue];
   d = dist[node];
   Do[If[! KeyExistsQ[dist, nbr],
     dist[nbr] = d + 1;
     queue = Append[queue, nbr]],
    {nbr, Lookup[graph, node, {}]}]];
  dist];\
\>", "Input",
 CellLabel->
  "In[350]:=",ExpressionUUID->"92a9b525-d2ac-4ef9-819e-9d003df339cb"],

Cell[CellGroupData[{

Cell["distances[g, 1]", "Input",
 CellLabel->
  "In[352]:=",ExpressionUUID->"5cfcd804-9ebe-40a3-b3b1-36c1aea13d31"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"1", "\[Rule]", "0"}], ",", 
   RowBox[{"2", "\[Rule]", "1"}], ",", 
   RowBox[{"3", "\[Rule]", "1"}], ",", 
   RowBox[{"4", "\[Rule]", "2"}]}], "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.996562356761167*^9},
 CellLabel->
  "Out[352]=",ExpressionUUID->"36408c66-f430-43ee-8ea6-15d6183a42f7"]
}, Open  ]],

Cell["\<\
The start is at distance zero, its neighbors at one, and node 4 at two. The \
Association doing double duty as both the distance record and the visited set \
is what keeps this short: a node has been seen exactly when it has a \
distance.
This only gives shortest paths when every edge counts the same. On a graph \
where edges have different weights, breadth-first search finds the path with \
the fewest edges rather than the smallest total weight, and a different \
algorithm is needed.
A node that cannot be reached simply never receives a distance, which is \
easily distinguished from a distance of zero:\
\>", "Text",
 CellChangeTimes->{{3.996562359961423*^9, 
  3.996562362752947*^9}},ExpressionUUID->"58788add-596a-4be5-a901-\
e53c678f30d1"],

Cell[CellGroupData[{

Cell["\<\
disconnected = <|1 -> {2}, 2 -> {}, 3 -> {1}|>;
distances[disconnected, 1]\
\>", "Input",
 CellLabel->
  "In[353]:=",ExpressionUUID->"ae2da261-1cb4-4417-87ac-bab1ce6e64f8"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"1", "\[Rule]", "0"}], ",", 
   RowBox[{"2", "\[Rule]", "1"}]}], "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.996562364843952*^9},
 CellLabel->
  "Out[354]=",ExpressionUUID->"00fca1e9-aa99-4bbf-a69b-8a8dd21fa95f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["KeyExistsQ[distances[disconnected, 1], 3]", "Input",
 CellLabel->
  "In[355]:=",ExpressionUUID->"9fe6ed2e-24dd-4122-a41b-8e58066fcc62"],

Cell[BoxData["False"], "Output",
 CellChangeTimes->{3.996562366725965*^9},
 CellLabel->
  "Out[355]=",ExpressionUUID->"8232ae38-a74a-4ed0-8279-57a78f9697ca"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Example: Reachability", "Subsubsection",
 CellChangeTimes->{{3.996562379691512*^9, 
  3.9965623799469976`*^9}},ExpressionUUID->"86501b70-3ddd-4451-b841-\
06acef362461"],

Cell["\<\
The simplest question about a graph is whether one node can be reached from \
another, and a traversal answers it directly.\
\>", "Text",ExpressionUUID->"01a821f2-d30c-45b5-9f8c-dbab9392ea4a"],

Cell["A slightly larger directed graph:", "Text",
 FontColor->RGBColor[
  0.792156862745098, 0.2784313725490196, 0.0784313725490196, 
   1],ExpressionUUID->"3c437842-0d9e-4a2e-b463-b9db77c5279a"],

Cell["\<\
net = <|\"a\" -> {\"b\", \"c\"}, \"b\" -> {\"d\"}, \"c\" -> {\"d\"}, \"d\" -> \
{\"e\"}, \"e\" -> {}, \"f\" -> {\"a\"}|>;\
\>", "Input",
 CellLabel->
  "In[356]:=",ExpressionUUID->"d6de081a-7f2a-49b2-bc1c-663d254a2083"],

Cell["Reachability is membership in the set the traversal returns:", "Text",ExpressionUUID->"42fdde30-c4d7-41f1-9b2f-ecf1aaa88cca"],

Cell[CellGroupData[{

Cell["\<\
Clear[reachableQ];
reachableQ[graph_, from_, to_] := MemberQ[bfs[graph, from], to];
{reachableQ[net, \"a\", \"e\"], reachableQ[net, \"a\", \"f\"]}\
\>", "Input",
 CellLabel->
  "In[357]:=",ExpressionUUID->"d238b15c-fa8d-4606-aa27-c27a3b5fa1c1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",
 CellChangeTimes->{3.996562384925102*^9},
 CellLabel->
  "Out[359]=",ExpressionUUID->"7f5beabc-bfe3-4dd5-acaf-e275adbd433d"]
}, Open  ]],

Cell["\<\
Node e is reachable from a, but f is not, because the edge between them runs \
the other way. Direction matters, and reversing the question gives the \
opposite answer:\
\>", "Text",ExpressionUUID->"d0dffe65-9c45-4137-b80a-97e5bdb5a468"],

Cell[CellGroupData[{

Cell["reachableQ[net, \"f\", \"a\"]", "Input",
 CellLabel->
  "In[360]:=",ExpressionUUID->"97025ac7-9ab8-48f4-bdce-e601f7d6e2dc"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.996562386725675*^9},
 CellLabel->
  "Out[360]=",ExpressionUUID->"0e300854-4b55-4b2c-b6e9-f91f163b2186"]
}, Open  ]],

Cell["\<\
Asking which nodes cannot be reached from a given start is then a matter of \
comparing the traversal against the full set of keys:\
\>", "Text",ExpressionUUID->"945127df-8b3c-43bb-b037-1b8cbf016dbf"],

Cell[CellGroupData[{

Cell["Complement[Keys[net], bfs[net, \"a\"]]", "Input",
 CellLabel->
  "In[361]:=",ExpressionUUID->"e77ddf4b-139d-4b04-ab67-d9b489813e6d"],

Cell[BoxData[
 RowBox[{"{", "\<\"f\"\>", "}"}]], "Output",
 CellChangeTimes->{3.996562388576157*^9},
 CellLabel->
  "Out[361]=",ExpressionUUID->"74333525-a240-4b1d-88f0-63dd8275fd45"]
}, Open  ]]
}, Open  ]]
}, Closed]],

