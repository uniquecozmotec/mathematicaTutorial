                    StyleBox[
                    "\"Beginner\"", "CheckboxBarLabel", StripOnInput -> 
                    False]}}, AutoDelete -> False, 
                  GridBoxItemSize -> {
                   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}, 
                  ColumnAlignments -> Left, ColumnSpacings -> 0.3, 
                  BaselinePosition -> {1, 2}], "  ", 
                 GridBox[{{
                    CheckboxBox[
                    Dynamic[
                    MemberQ[difficulties$$, "Intermediate"], ((
                    difficulties$$ = #; clampCounts[])& )[
